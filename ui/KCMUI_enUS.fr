#ifdef __ODFRC__

// English string table is defined here

resource StringTable (kSDKDefStringsResourceID + index_enUS)
{
        k_enUS,									// Locale Id
        kEuropeanWinToMacEncodingConverter,		// Character encoding converter (irp) I made this WinToMac as we have a bias to generate on Win...
        {
        	 // ----- Menu strings
                kKCMCompanyKey,					"Kohaku Plug-Ins",	// the menu grouping name as shown; a different thing from the company value kKCMCompanyValue
                kKCMAboutMenuKey,					kKCMDisplayName "...",

                kSDKDefAboutThisPlugInMenuKey,			kSDKDefAboutThisPlugInMenuValue_enUS,
                kKCMUsageMenuKey,				"How to Use...",
                // ★Renamed from "Show Marks on Target" / "Show Marks on Source" (user's request:
                //   an English name that says "always visible" at a glance). The old names did not
                //   say what the toggle does: marks appear anyway while the tool's left button is
                //   held, so "Show Marks on ..." could not be told from that gesture.
                // ⚠**"Hold" is deliberately NOT in the name** (considered and rejected). The press
                //   gesture works **independently of this toggle and inverts whatever state it is
                //   in**, so putting "Hold" here would read as "this toggle IS the hold". On top of
                //   that, "Hold to Hide Marks" was a real toggle that has since been removed, and
                //   the name would be read as its return.
                kKCMShowTgtMarksMenuKey,			"Always Show Marks on Target",
                kKCMShowSrcMarksMenuKey,			"Always Show Marks on Source",
                kKCMPageMapToggleMenuKey,			"Register as Added/Removed Pages",
                kKCMPageCheckMenuKey,				"Check",
                kKCMPageRefreshCompareMenuKey,	"Refresh Page Comparison",
                kKCMHideUnchangedMenuKey,			"Hide Unchanged Spreads",
                kKCMShowOldNumsMenuKey,			"Show Original Page Numbers",
                kKCMSyncViewsMenuKey,				"Sync Layout Views",
                kKCMAlignViewsMenuKey,			"Align Other Views to Active",
                kKCMScrollMapMenuKey,				"Show Scrollbar Map",
                kKCMTranslucentPanelMenuKey,		"Translucent Panel",
                kKCMTranslucentPagesPanelMenuKey,	"Translucent Pages Panel",
                kKCMTranslucentBookDialogMenuKey,	"Translucent Dialog",
                kKCMSavePanelStateMenuKey,			"Save Panel Settings",
                kKCMSaveChecksMenuKey,			"Save Check && Register",
                kKCMLoadChecksMenuKey,			"Load Check && Register",
                kKCMFindOversetMenuKey,			"Find Overset",
                kKCMRefreshOversetMenuKey,		"Refresh Overset",
                kKCMExportChangedPagesMenuKey,	"Export Changed Pages...",
                kKCMCompareBooksMenuKey,			"Compare Books",
                kKCMSetTargetMenuKey,				"Set as Target",
                kKCMSetSourceMenuKey,				"Set as Source",
                kKCMBookDialogTitleKey,			"Kohaku Change Marker - Compare Books",
                kKCMBookCompareKey,				"Compare",
                kKCMBookReadyKey,					"No comparison has been run yet.",
                kKCMBookHintKey,					"Right-click a changed chapter to start Change Marker.",
                kKCMBookCompareConfirmKey,		"These two books will be compared, chapter by chapter.",
                kKCMBookNoPairKey,				"Select a book tab in the Book panel, and open a second book.",
                kKCMBookRowStartMenuKey,			"Start Change Marker",
                kKCMStoryRowRefreshMenuKey,		"Refresh Story Comparison",
                kKCMIgnorePageNumMenuKey,			"Ignore Page Number Marker",
                // ("Hold to Hide Marks" was retired on 2026-08-22 - see KCMUI.fr's MenuDef note.)

                // Keyboard Shortcuts editor area for shortcut-assignable actions: the value string that
                // "KBSCE Palette Menus: Kohaku Change Marker: " (kKCMPanelMenuActionArea) resolves to. This
                // files those actions under Product Area "Palette Menus", prefixed "Kohaku Change Marker".
                kKCMPanelMenuActionArea,			kKCMPanelMenuActionAreaValue,

                // ----- Command strings

                // ----- Window strings

                // ----- Panel/dialog strings
                kKCMPanelTitleKey,			"Kohaku Change Marker",
                kKCMToolStringKey,			"Kohaku Change Marker Tool",	// the tool name in the toolbox tooltip; English in every locale
                kKCMTargetLabelKey,			"Target:",
                kKCMSourceLabelKey,			"Source:",
                kKCMStartButtonKey,			"Start",
                kKCMPrintCheckKey,			"Print comparison marks",
                // An alert, shown every time the toggle above is switched ON (never when it is
                // switched OFF). English in every locale - see the note on the key in KCMUIID.h.
                kKCMPrintMarksOnKey,			"Comparison marks will now appear in print and in exported PDF files.",
                kKCMOpacity25Key,				"25%",
                kKCMOpacity75Key,				"75%",
                kKCMColorRedKey,				"Red",
                kKCMColorCyanKey,				"Cyan",
                kKCMModePixelKey,				"Pixel Changes",
                kKCMModeStoryKey,				"Story Changes",
                kKCMPrevChangeKey,			"< Prev",
                kKCMNextChangeKey,			"Next >",

                // Story Edits section. The kind words are what a row says on its right; "Added" means
                // the older version holds no story to compare this one against at all, and "Deleted"
                // means the NEWER one does not - that row is a story of the older document, and
                // clicking it moves the source window alone (2026-08-21).
                // ★THE WORD IS "Deleted" WHILE THE KEY AND THE ENUM SAY "Removed", and the mismatch
                // is deliberate (user's call, 2026-08-21). "Delete" on its own would be a verb in the
                // imperative - an instruction rather than a report - beside "Added", which is a past
                // participle; "Deleted" keeps the two the same part of speech. The key was not renamed
                // with it because a string key is not a display string: renaming it would touch the
                // enum, the model and the UI to change four letters that never reach the screen.
                kKCMStorySectionLabelKey,		"Story Edits",
                kKCMStoryNoEditsKey,			"No edits",
                kKCMStoryKindTextKey,			"Text",
                kKCMStoryKindAttrKey,			"Attr",
                kKCMStoryKindOtherKey,		"Other",
                kKCMStoryKindAddedKey,		"Added",
                kKCMStoryKindRemovedKey,		"Deleted",
                kKCMStoryKindNoneKey,			"None",
                kKCMStoryKindRubyKey,			"Ruby",

                // The list's column headings. ★"Story" and "Change" rather than "Text" and "Kind":
                // the words in the rows already use "Text" for one of the kinds, so heading the
                // second column "Text" would put the same word twice in one row meaning two
                // different things (user's call, 2026-08-10).
                kKCMStoryColUIDKey,			"UID",
                kKCMStoryColTextKey,			"Story",
                kKCMStoryColKindKey,			"Change",

                kKCMHintKey,					"Select the Kohaku Change Marker tool (from the toolbox, or with the tool button on the panel), then on the layout:\nHold Left button =\n  show comparison marks (while held;\n  opacity 25%/75% from panel)\nHold Left + Shift =\n  original (old version, while held)\nHold Left + Shift+" kKCMAltKeyName "=\n  original 50% (while held)\nHold Left + " kKCMAltKeyName "=\n  color info (CMYK) at the click point,\n  shown on the cursor and panel\n\nShift/" kKCMAltKeyName " can be held or released\n\n[Handling added / removed pages (Add / Remove)]\nWhen pages are added or removed, the following page numbers shift, so pages that should match are no longer compared and everything can be falsely flagged as changed even when the design is identical. To avoid this, you can register added or removed pages to exclude them from comparison.\n- How to: in the Pages panel, select pages, right-click, and choose \"Register as Added/Removed Pages\"\n- Register in Target (the newer document) = added page / register in Source (the older document) = removed page\n- Repeat the same action to unregister\n- Registered pages show a green diagonal line; pages with no counterpart due to the page-count difference show a red diagonal line\n- If you register or unregister while Start is active, the comparison is redone automatically\n\n[Checking pages (Check)]\nYou can put a check mark on pages you have finished reviewing. Available only while Start is active; cleared on Stop.\n- How to: in the Pages panel, select pages, right-click, and choose \"Check\" (repeat to clear)\n- In the pixel comparison mode a check can be placed only on pages that already carry a mark (comparison frame or diagonal line); in the story comparison mode any page can be checked\n- Checks and registrations (Add / Remove) can be saved and restored from the panel flyout menu:\n  - \"Save Check && Register\" = save the current checks and registrations to a private file (shows the saved path)\n  - \"Load Check && Register\" = load them, apply the registrations, recompare, then restore the checks (only while Start is active)\n- Saving only writes to this plug-in's own file in the preferences folder; nothing is written into InDesign's documents or workspace\n- Matching is by the document's full path, so if the file is moved or saved under a new name, saved checks can no longer be restored\n\n[Refresh page comparison (Refresh Page Comparison)]\nRecompare just the pages you edited. Available while Start is active, in the pixel comparison mode only - the story comparison mode rasterises no page, so it has its own refresh instead: right-click a row in Story Edits and choose \"Refresh Story Comparison\".\n- How to: in the Pages panel, select pages, right-click, and choose \"Refresh Page Comparison\"\n- Right-click in the Target document (the newer one); the marks and thumbnails of the selected pages and of their Source counterparts are both updated\n\n",
                kKCMHint2Key,				"[Comparing books (Compare Books)]\nCompares two books (.indb) chapter by chapter and lists which chapters changed.\n- How to: in the Book panel, bring the tab of the book you want to compare to the front, open the second book as well, then choose \"Compare Books\" from the panel's flyout menu\n- The book on the front tab is the Target (the newer one); the first other open book is the Source (the older one)\n- Each chapter gets its own result: Changed / NoChange / ChapterAdded (only in the Target) / ChapterDeleted (only in the Source) / Failed (could not be opened - the reason is shown next to it) / NotCompared (the run was cancelled before reaching it)\n- Double-click a row to open that chapter's two documents\n- Right-click a row and choose \"Start Change Marker\" to open the two documents and start comparing them (only rows where both files exist can be chosen)\n\nStory Edits (open with the triangle): the stories that differ, and what changed (Text / Attr / Other / Added). Click a row to show that story in both documents, then walk the list with the up and down arrow keys. Double-click selects the whole of that story (switches to the Type tool, and hands the keyboard back to the document).\n\nWith comparison-mark printing ON, the marks appear both when printing and in File > Export to PDF (including Acrobat 4 / PDF 1.3 submission presets such as PDF/X-1a).\n\n[Finding overset (Find Overset)]\nSeparately from the comparison, you can find pages that contain overset (overflowing) text on their own.\n- Turn \"Find Overset\" ON/OFF from the flyout menu\n- Overset pages are shown with a red frame + red \"+\" on their Pages-panel thumbnails and a red band on the scrollbar map\n- Detects overflowing text frames as well as individual overset table cells (the red dot)\n- Use Prev/Next to step through the overset locations (while comparing, each page goes changed then overset)\n- After editing, use \"Refresh Overset\" to re-scan (only while Find Overset is ON)\n\nDISCLAIMER: Provided as-is. We cannot take responsibility for any problems that may arise. Use at your own risk.",

		// ----- Misc strings
                // About is one line, name + version (user's call): no description, no credits and
                // no repository URL. That is why nothing here needs translating.
                kKCMAboutBoxStringKey,			kKCMDisplayName " version " kKCMVersion,



        }

};

#endif // __ODFRC__
