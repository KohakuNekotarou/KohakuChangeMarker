#ifdef __ODFRC__

// English string table is defined here

resource StringTable (kSDKDefStringsResourceID + index_enUS)
{
        k_enUS,									// Locale Id
        kEuropeanWinToMacEncodingConverter,		// Character encoding converter (irp) I made this WinToMac as we have a bias to generate on Win...
        {
        	 // ----- Menu strings
                kKCMCompanyKey,					"Kohaku Plug-Ins",	// the menu grouping name as shown; a different thing from the company value kKCMCompanyValue
                kKCMAboutMenuKey,					kKCMDisplayName "...",

                kSDKDefAboutThisPlugInMenuKey,			kSDKDefAboutThisPlugInMenuValue_enUS,
                kKCMUsageMenuKey,				"How to Use...",
                // ★Renamed from "Show Marks on Target" / "Show Marks on Source" (user's request:
                //   an English name that says "always visible" at a glance). The old names did not
                //   say what the toggle does: marks appear anyway while the tool's left button is
                //   held, so "Show Marks on ..." could not be told from that gesture.
                // ⚠**"Hold" is deliberately NOT in the name** (considered and rejected). The press
                //   gesture works **independently of this toggle and inverts whatever state it is
                //   in**, so putting "Hold" here would read as "this toggle IS the hold". On top of
                //   that, "Hold to Hide Marks" was a real toggle that has since been removed, and
                //   the name would be read as its return.
                kKCMShowTgtMarksMenuKey,			"Always Show Marks on Target",
                kKCMShowSrcMarksMenuKey,			"Always Show Marks on Source",
                kKCMPageMapToggleMenuKey,			"Register as Added/Removed Pages",
                kKCMPageCheckMenuKey,				"Check",
                kKCMPageRefreshCompareMenuKey,	"Refresh Page Comparison",
                kKCMHideUnchangedMenuKey,			"Hide Unchanged Spreads",
                kKCMShowOldNumsMenuKey,			"Show Original Page Numbers",
                kKCMShowStoryIdsMenuKey,		"Show Story IDs",
                kKCMSyncViewsMenuKey,				"Sync Layout Views",
                kKCMAlignViewsMenuKey,			"Align Other Views to Active",
                kKCMTranslucentPanelMenuKey,		"Translucent Kohaku Change Marker Panel",
                kKCMTranslucentPagesPanelMenuKey,	"Translucent Pages Panel",
                kKCMTranslucentBookDialogMenuKey,	"Translucent Compare Books Dialog",
                kKCMSavePanelStateMenuKey,			"Save Panel Settings",
                kKCMClearChecksMenuKey,			"Clear Checks in This Document",
                kKCMClearPawsMenuKey,			"Clear Cat Paws in This Document",
                kKCMRefreshCompareMenuKey,		"Refresh Comparison",
                kKCMExportReportMenuKey,		"Export Before/After PDF Report",
                kKCMCompareBooksMenuKey,			"Compare Books",
                kKCMSetTargetMenuKey,				"Set as Target",
                kKCMSetSourceMenuKey,				"Set as Source",
                kKCMSetPdfTargetMenuKey,			"Set PDF as Target...",
                kKCMSetPdfSourceMenuKey,			"Set PDF as Source...",
                kKCMTaskStartMenuKey,				"Task Start (Save)...",
                kKCMTaskStartCloneMenuKey,			"Task Start",
		kKCMExportStoryTextMenuKey,			"Export Story Text...",
		kKCMExportPagesMenuKey,				"Export Pages to Word...",
		kKCMImportStoryTextMenuKey,			"Import Story Text...",
		kKCMCompareTrackedMenuKey,			"Compare with Tracked Changes...",
                kKCMClearChosenMenuKey,			"Clear Target and Source",
                kKCMBookDialogTitleKey,			"Kohaku Change Marker - Compare Books",
                kKCMPawWordDialogTitleKey,		"Kohaku Change Marker - Cat Paw",
                kKCMPawWordLabelKey,			"Note:",
                kKCMBookCompareKey,				"Compare",
                kKCMBookReadyKey,					"No comparison has been run yet.",
                kKCMBookHintKey,					"Right-click a changed chapter to start Change Marker.",
                kKCMBookCompareConfirmKey,		"These two books will be compared chapter by chapter in three ways: as pictures, by their story text, and by their definitions - the comparison mode does not change this.",
                kKCMBookNoPairKey,				"Select a book tab in the Book panel, and open a second book.",
                kKCMBookRowStartMenuKey,			"Start Change Marker",
                kKCMStoryRowRefreshMenuKey,		"Refresh Story Comparison",
                kKCMChangeRowRestoreAttrMenuKey,	"Restore from Source",
                kKCMChangeRowMatchTableMenuKey,	"Match the Source",
                kKCMChangeRowApplyMenuKey,		"Apply This Change",				// (2026-10-24, the import-as-Source road)
                kKCMChangeRowRestoreFromCopyMenuKey,	"Restore from Copy",			// (2026-10-24 evening - KFC's name for the same thing)
                kKCMStoryRowApplyMenuKey,		"Apply All Changes in This Story",
                kKCMApplyAllMenuKey,	"Apply All Changes",
                kKCMStoryRowRestoreAllMenuKey,	"Restore All Changes in This Story",	// (2026-10-24 night - the Story mode's, by copy)
                // ★(2026-10-25) the Track mode's accept and reject - four scopes (InDesign's own words: Accept / Reject Change)
                kKCMTrackAcceptChangeMenuKey,	"Accept Change",
                kKCMTrackRejectChangeMenuKey,	"Reject Change",
                kKCMTrackAcceptStoryMenuKey,	"Accept This Author's Changes in Story",
                kKCMTrackRejectStoryMenuKey,	"Reject This Author's Changes in Story",
                kKCMTrackAcceptAuthorMenuKey,	"Accept All Changes by This Author",
                kKCMTrackRejectAuthorMenuKey,	"Reject All Changes by This Author",
                kKCMTrackAcceptAllMenuKey,		"Accept All Changes in Document",
                kKCMTrackRejectAllMenuKey,		"Reject All Changes in Document",
                kKCMResourceRowXmlMenuKey,		"Show as XML",
                // (⛔Two "Edit..." strings stood here from 2026-09-13 and went on 2026-09-21 with
                //  the items that carried them - one on a definition row's menu, one on an
                //  attribute row's - and with the editor they opened.)
                // (⛔Four strings went on 2026-09-21 with the restore: "Restore Source Text",
                //  "Undo the Restore", "Restore All in This Story", and the question asked before a new
                //  paragraph was taken in ahead of the one before it.)
                kKCMIgnorePageNumMenuKey,			"Ignore Page Number Marker",
                kKCMPairByUidMenuKey,				"Pair Pages by UID",
                // ("Hold to Hide Marks" was retired on 2026-08-22 - see KCMUI.fr's MenuDef note.)

                // Keyboard Shortcuts editor area for shortcut-assignable actions: the value string that
                // "KBSCE Palette Menus: Kohaku Change Marker: " (kKCMPanelMenuActionArea) resolves to. This
                // files those actions under Product Area "Palette Menus", prefixed "Kohaku Change Marker".
                kKCMPanelMenuActionArea,			kKCMPanelMenuActionAreaValue,

                // ----- Command strings

                // ----- Window strings

                // ----- Panel/dialog strings
                kKCMPanelTitleKey,			"Kohaku Change Marker",
                kKCMToolStringKey,			"Kohaku Change Marker Tool",	// the tool name in the toolbox tooltip; English in every locale
                kKCMPawToolStringKey,		"Kohaku Cat Paw Tool",		// the stamp tool's name in the KCM tool's flyout (its tooltip); English in every locale, as the line above
                kKCMTargetLabelKey,			"Target:",
                kKCMSourceLabelKey,			"Source:",
                kKCMStartButtonKey,			kKCMStartMenuText,
                kKCMPrintCheckKey,			"Print comparison marks",
                // An alert, shown every time the toggle above is switched ON (never when it is
                // switched OFF). English in every locale - see the note on the key in KCMUIID.h.
                // ★**IT NAMES THE SCREEN TOO** (2026-09-08). Turning this on also shows the marks on
                // screen, permanently, in BOTH documents - that is what makes "what you see is what
                // comes out" true. The sentence used to mention only print and PDF, so the reader
                // watched the screen change and was told nothing about why.
                kKCMPrintMarksOnKey,			"Comparison marks will now appear in print and in exported PDF files, and stay visible on screen in both documents.",
                kKCMOpacity25Key,				"25%",
                kKCMOpacity75Key,				"75%",
                kKCMColorRedKey,				"Red",
                kKCMColorCyanKey,				"Cyan",
                kKCMModePixelKey,				"Pixel Changes",
                kKCMModeStoryKey,				"Story Changes",
                kKCMModeResourcesKey,			"Resources Changes",
                kKCMModeTrackKey,				"Track Changes",
                kKCMTrackSectionLabelKey,		"Tracked Changes",
                kKCMPrevChangeKey,			"< Prev",
                kKCMNextChangeKey,			"Next >",

                // Story Edits section. The kind words are what a row says on its right; "Added" means
                // the older version holds no story to compare this one against at all, and "Deleted"
                // means the NEWER one does not - that row is a story of the older document, and
                // clicking it moves the source window alone (2026-08-21).
                // ★THE WORD IS "Deleted" WHILE THE KEY AND THE ENUM SAY "Removed", and the mismatch
                // is deliberate (user's call, 2026-08-21). "Delete" on its own would be a verb in the
                // imperative - an instruction rather than a report - beside "Added", which is a past
                // participle; "Deleted" keeps the two the same part of speech. The key was not renamed
                // with it because a string key is not a display string: renaming it would touch the
                // enum, the model and the UI to change four letters that never reach the screen.
                kKCMStorySectionLabelKey,		"Story Edits",
                kKCMProposedSectionLabelKey,	"Proposed Edits",					// (2026-10-24 evening) the heading while the Source is an import's copy - the author's words
                kKCMStoryNoEditsKey,			"No edits",
                kKCMStoryPixelNoteKey,			"Pixel mode: stories are not compared",
                kKCMResourcesSectionLabelKey,	"Resources",
                kKCMResourcesNoChangesKey,		"No differences",
                kKCMResourcesColKindKey,		"Kind",
                kKCMResourcesColKeyKey,			"Definition",
                kKCMStoryKindTextKey,			"Text",
                kKCMStoryKindAttrKey,			"Attr",
                kKCMStoryKindOtherKey,		"Other",
                kKCMStoryKindAddedKey,		"Added",
                kKCMStoryKindRemovedKey,		"Deleted",
                kKCMStoryKindNoneKey,			"None",
                kKCMStoryKindRubyKey,			"Ruby",
                kKCMStoryKindKentenKey,		"Kenten",
                kKCMStoryKindFootnoteKey,		"Footnote",
                kKCMStoryKindEndnoteKey,		"Endnote",

                // The list's column headings. ★"Story" and "Change" rather than "Text" and "Kind":
                // the words in the rows already use "Text" for one of the kinds, so heading the
                // second column "Text" would put the same word twice in one row meaning two
                // different things (user's call, 2026-08-10).
                kKCMStoryColUIDKey,			"ID",
                kKCMStoryColTextKey,			"Story",
                kKCMStoryColKindKey,			"Change",

                kKCMHintKey,					"Select the Kohaku Change Marker tool (from the toolbox, or with the tool button on the panel), then on the layout:\nHold Left button =\n  show comparison marks (while held;\n  opacity 25%/75% from panel)\nHold Left + Shift =\n  original (old version, while held)\nHold Left + Shift+" kKCMAltKeyName "=\n  original 50% (while held)\nHold Left + " kKCMAltKeyName "=\n  color info (CMYK) at the click point,\n  shown on the cursor and panel\n\nShift/" kKCMAltKeyName " can be held or released\n\n[Page pairing and added / removed pages (Pair Pages by UID / Add / Remove)]\nBy default a page is compared with the page that has the same UID (internal id) in the other document (\"Pair Pages by UID\" on the flyout, ON). When the newer version was made by saving the older one under another name, pages that were added, removed or moved still meet their right partner, and the pages found in only one document (added in the Target, removed from the Source) are marked with a red diagonal line without any registration.\n- Two documents made separately, or one that went through IDML, share no UIDs: nothing pairs and every page gets the red line. Turn \"Pair Pages by UID\" OFF to go back to the older rule, pairing by position from the first page on\n- Under the positional rule an added or removed page shifts everything after it, so you can register such pages to exclude them from the comparison\n- How to: in the Pages panel, select pages, right-click, and choose \"Register as Added/Removed Pages\"\n- Register in Target (the newer document) = added page / register in Source (the older document) = removed page\n- Repeat the same action to unregister\n- Registered pages show a green diagonal line; pages with no counterpart show a red diagonal line\n- Registering, unregistering or flipping the toggle while Start Comparison is active redoes the comparison automatically\n\n[Checking pages (Check)]\nYou can put a check mark on pages you have finished reviewing. A check stays until you clear it: it survives Stop Comparison, and closing the document forgets it.\n- How to: in the Pages panel, select pages, right-click, and choose \"Check\" (repeat to clear)\n- Any page of any open document can be checked, with or without a comparison running. While one IS running, the pixel mode still limits checks to pages that carry a mark; the story mode allows any page\n- Checks and cat paws are written INTO the document, onto the page, the moment you place one -- undoable, and kept in the file once you save it\n- Registrations (Add / Remove) tell the comparison that a page has no counterpart, so they are not written to the document, and they go at Stop Comparison\n- \"Clear Checks in This Document\" and \"Clear Cat Paws in This Document\" clear the active one\n\n[Refresh page comparison (Refresh Page Comparison)]\nRecompare just the pages you edited. Available while Start Comparison is active, in the pixel comparison mode only - the story comparison mode rasterises no page, so it has its own refresh instead: right-click a row in Story Edits and choose \"Refresh Story Comparison\".\n- How to: in the Pages panel, select pages, right-click, and choose \"Refresh Page Comparison\"\n- Right-click in the Target document (the newer one); the marks and thumbnails of the selected pages and of their Source counterparts are both updated\n\n",
                // ★A third piece (2026-09-12): kKCMHintKey and kKCMHint2Key both sit at odfrc's
                //   length limit for one string, so Task Start has a key of its own. DoUsage reads
                //   the three in the order hint / hint3 / hint2, and the Japanese side (KCMLoc.h)
                //   carries the same section at the same seam - at the head of its kHint2.
                kKCMHint3Key,				"[Comparing with a moment ago (Task Start)]\nTakes the document's state at this moment and makes it the Source. Edit, then Start Comparison to see what changed since that moment, in any of the three modes. Two items take it:\n- \"Task Start\" keeps the state in memory - no dialog and no file. The Source line reads \"Task Start (in memory) - <document> - <time>\". It is let go when the Source is set to anything else (Set as Source, Task Start (Save)..., Import Story Text..., Compare with Tracked Changes..., Clear Target and Source, or the next Task Start) and when the document closes or reverts; saving the document keeps it. The Before/After PDF report cannot print it - take a Task Start (Save)... for a report\n- \"Task Start (Save)...\" saves a copy of the document to a file you choose and sets that file as the Source. A save dialog opens on the document's own folder, with a name made from the document's name and the time; press Save. Cancel and nothing happens at all. The Source line then shows the copy's path. The copy is NOT opened: Start opens it, in a window, and leaves it open when you stop. The copy is an ordinary InDesign document: it stays where you saved it until you delete it, and you can open, print or compare it like any other\n- For both: the document taken is the Target if you have chosen one, otherwise the document in front, and that same document becomes the Target. Both can be pressed while a comparison is running - that comparison stops first\n\n[Before / After PDF report (Export Before/After PDF Report)]\nCompares the two documents for itself and writes one PDF in three parts. First page: the two documents, with Before on the left and After on the right. Then one landscape page per changed page of the pixel comparison - the older version on the left with the comparison marks printed on it, the newer version clean on the right, and no text on those pages; added pages have an empty left side, removed pages an empty right side. Then the Story table: the older wording on the left, the newer on the right, one row per edit, unchanged text pale and the changed text dark - ruby and kenten are set for real, and a footnote or endnote number stands as a superscript. Then the Resources table: one row per changed attribute of each definition, the older value on the left and the newer on the right. Both tables carry the panel's own columns (ID or Kind, then the sign) and a length shows the document's unit in brackets - 8.5 (12 Q) - in the panel as well.\n- How to: with no comparison running, choose \"Export Before/After PDF Report\" from the panel's flyout menu - it is greyed while one is (press Stop first). It compares the pair Start would (the Target and Source you set, otherwise the document in front and another open one), and nothing is left started afterwards\n- A save dialog asks where and under what name (\"<name>.compare-report.pdf\" is offered); the PDF is then opened in your PDF viewer\n- All three parts are made whichever comparison mode is chosen: the report compares the pixels, the stories and the resources itself\n- The marks on the Before side are the rings around what changed, without the frame along the page edge\n- Uses the current PDF export settings (reader spreads and security switched off). With a Task Start (Save)... as the Source, the left side is the copy you saved (with a Task Start kept in memory the report is not made)\n\n[Story IDs (Show Story IDs)]\nWrites \"StoryID:\" and the ID of its story above every frame that holds text - a text frame, a path with text on it, an anchored frame. The number is the one a script reads as story.id, and the one in the ID column of Story Edits. It sits outside the frame, on its top edge at the left, so it never lies over the text.\n- How to: switch \"Show Story IDs\" on from the panel's flyout menu (off by default; saved with the panel settings)\n- On screen always, at one size whatever the zoom; in print and PDF only with \"Print comparison marks\" on (and in the Before/After PDF report on the After side)\n- A frame whose path carries text as well shows two labels\n\n",
                // ★A fourth piece (2026-09-19): the story text round trip. Read after kKCMHint3Key
                //   (DoUsage: hint / hint3 / hint4 / hint2); the Japanese side carries the same section
                //   inside its kHint2, after Story IDs and before the books - the same seam.
                kKCMHint4Key,				"[Story text round trip (Export Story Text / Export Pages to Word / Import Story Text)]\nWrites each story out as a Word document, lets somebody edit it outside InDesign, and offers the edits back to the document change by change.\n- \"Export Story Text...\" writes one .docx per story. With a frame selected only its story is written; with nothing selected, every story\n- \"Import Story Text...\" does not change your document. It reads the chosen files into a copy of the document kept in memory (a Task Start in memory - no dialog, no file), makes each story there what Word shows - Word's revision marks accepted, or no marks at all; Word's comments are not brought in - and starts the Story comparison: the Source is the document as the files would make it, the Target is your document as it stands. The list's heading says \"Proposed Edits\": each change row is what would change in your document. A Task Start you had chosen before - of either kind - is replaced by the import's own\n- To put the edits in: right-click a change row and choose \"Apply This Change\" (or select rows and press Return; Shift+Return puts one in and goes on to the next), right-click a story row for \"Apply All Changes in This Story\", or right-click the heading for \"Apply All Changes\". Rows selected together go in as one step. Each is one Ctrl+Z, and the list follows Ctrl+Z. Nothing is tracked or signed - if you track changes in that story yourself, InDesign records the edit under your name\n- A change put in stays on the list as a \"=\" row - so does what \"Apply All Changes\" and \"Apply All Changes in This Story\" put in, and a story row whose every change is \"=\" reads \"=\" itself. Right-click it and choose \"Restore from Copy\" to put back the words that stood there before (KCM kept a copy of them). It is not offered where putting them back would make an object anew (a table, a footnote reference, an anchored object, a hyperlink's source), nor for a table's or a mark's row, a change that went in together with its paragraph, or what Apply All put in. A \"=\" moves with the words typed or deleted before it, and with their Ctrl+Z and Ctrl+Y, and stays through Refresh Story Comparison and Refresh Comparison - a story whose every change went in keeps its row\n- A table the files add or take away, and a footnote they add, go in only with their story: \"Apply All Changes in This Story\"\n- Whatever could not go into the copy - a table Word reshaped in a way that cannot be made (rows of unequal length, a nested table in the way, cells InDesign cannot merge), a change that would add or take away an anchored object, a variable or an index marker, a cell or note the file does not have, a file with no story - is listed FIRST, with a red ! in the change column and the place and the reason beside it. What was changed in InDesign after the export shows as a proposal to write it over\n- Overset shows at once: an edit put in that no longer fits its frame is marked OV in the row, as in any Story comparison\n- A table inside a paragraph: Word has no such thing, so the file shows the words before the table, the table, and the words after it as separate blocks. Where the paragraph breaks around a table is decided by your document, not by the file - a break added or removed next to a table in Word changes nothing; split or join such a paragraph in InDesign. Words moved across such a table (in Word, the words after it moved to the end of the block before it) come back as two rows: put in on one side of the table, taken out on the other\n- \"Export Pages to Word...\" (the Pages panel's page menu, or this flyout) writes each selected page as one .docx, \"p<page>.docx\" in a folder \"Pages <date and time>\": each text frame a text box where the frame stands, holding its whole story - for catalogue pages of many frames. A table goes into its box as a Word table. A footnote reference becomes a mark reading NOTE n (n the footnote's number), and the footnote's words are in a box of their own on the file's second page, under the heading \"Box b NOTE n\": edit them there. A mark cannot be edited but can be deleted - delete it to take its footnote out; Word cannot make a new footnote in a text box, so add one with \"Export Story Text...\". Not written, and named on the status line with their pages: a threaded frame (a threaded story goes out whole with \"Export Story Text...\"), an overset frame, a vertical frame holding a table (Word cannot lay it out), and a frame holding an endnote reference. Bring the edited pages back with \"Import Story Text...\", like story files: a frame changed in InDesign since the export is compared all the same, and what was changed shows as proposals back to the file's words. A file of another document (told by the document's own ID, not its name), a frame threaded since the export, a story that holds an endnote now, and a box whose marks and footnote boxes do not agree (a mark there twice, a footnote's box gone) are listed with a red ! A file exported before the document was saved under another name - or from another document saved from the same original, such as one made from the same template - goes in, and the status line says so\n\n",
                // ★A fifth piece (2026-10-05): the Track Changes mode. Read after kKCMHint4Key (DoUsage).
                kKCMHint5Key,				"[Track Changes mode (Compare with Tracked Changes...)]\nLists the changes InDesign's Track Changes recorded in the document - every author's, one row each - against the document as it was before them.\n- How to: with the document in front (or chosen with Set as Target), choose \"Compare with Tracked Changes...\" from the panel's flyout menu - nothing else has to be set first: the Target, the Source and the mode are set by it. A save dialog asks where to keep a copy of the document; every tracked change is rejected in that copy, so it is the version before the changes (one InDesign will not reject there is counted on the status line: not rejected in the copy=N). The copy opens in a window, becomes the Source (the panel's Source line ends in (Track original)), and the comparison starts in the Track Changes mode. Cancel and nothing happens at all\n- Accept or reject from the list's right-click menus: a change row - Accept Change / Reject Change (every change row selected with it too); a story row - that author's changes in that story; an author row - all of that author's changes; the Tracked Changes heading - every change listed. Each is one Ctrl+Z, and the list is read again. Nothing else writes to your document, and InDesign's Track Changes panel works as always\n- The list is author, then story, then change. Each author has the colour InDesign's Story Editor gives them, and their changes are marked in that colour (Marks opacity sets how strong; an author InDesign draws on white is marked in the Mark colour). A change row shows what was taken away struck through, then what was put in: + inserted, - deleted, a not-equals sign replaced, a double arrow moved\n- Click a change to go to it in both windows and select its words in your document, as in the Story mode (the Type tool comes on); the status line says who made it, when, and what it was. Deleted words show in the Story Editor only, so a deletion - and a change under a hidden condition - gets the caret where it stands. The list follows Undo and Redo, and an accept or a reject made in InDesign's Track Changes panel. A change that is gone all the same is said to be gone instead of jumped to - Refresh reads the list again\n- Changes in hidden conditional text are listed as Hidden. Notes are not read, and InDesign records nothing inside footnotes\n- Compare Books is not available in this mode (the Before/After PDF report is made with nothing started, as in every mode)\n\n",
                // ★A sixth piece (2026-10-14): comparing PDFs. Read after kKCMHint5Key (DoUsage).
                kKCMHint6Key,				"[Comparing PDFs (Set PDF as Target... / Set PDF as Source...)]\nCompares two exported PDFs, or a document against the PDF exported from it, with the Pixel comparison.\n- Two PDFs: choose \"Set PDF as Target...\" for the newer PDF and \"Set PDF as Source...\" for the older one from the panel's flyout menu, then Start Comparison. A document is made of each PDF - its pages laid out in the spreads of the original - named \"<file>.pdf (KCM)\" and opened in a window; the marks appear in the Target PDF's window\n- PDF export check: open the document, choose the PDF you exported from it with \"Set PDF as Source...\", then Start Comparison. The marks appear on the document where the PDF looks clearly different over an area - transparency or images lost, objects missing. Small differences of drawing (the edges of letters, rounding of colours) are not marked, so a thin line, a line of small text, a one-letter change or a slight colour shift may not show either\n- Pages are paired by the InDesign pages they came from, so pages added, removed or moved still meet their partners; a PDF of some pages checks those pages and names the rest; a PDF exported from another document is refused. PDFs without page ids are paired in order. The status line's second line says which\n- Two PDFs exported with the same settings show no mark where nothing changed\n- Pixel only for now: Start refuses in the Story, Resources and Track Changes modes, when the PDF is the Target against a document, and when a PDF is encrypted or damaged\n- The documents need not be saved: closing one asks nothing (unless you put a check or a cat paw on it, or used Hide Unchanged Spreads). The PDF stays chosen when its window is closed - the next Start makes the document again, and makes it anew when the PDF was written again\n- Ignore Page Number Marker does not reach inside a PDF\n\n",
                kKCMHint2Key,				"[Comparing books (Compare Books)]\nCompares two books (.indb) chapter by chapter and lists which chapters changed.\n- How to: in the Book panel, bring the tab of the book you want to compare to the front, open the second book as well, then choose \"Compare Books\" from the panel's flyout menu\n- The book on the front tab is the Target (the newer one); the first other open book is the Source (the older one)\n- Each chapter gets its own result: Changed / NoChange / ChapterAdded (only in the Target) / ChapterDeleted (only in the Source) / Failed (could not be opened, or opened and nothing could judge it - the reason is shown next to it) / NotCompared (the run was cancelled before reaching it)\n- The Change column names which of the three comparisons found the difference: Pixel, Story, Resources. A comparison that could not be judged carries a '?'\n- Double-click a row to open that chapter's two documents\n- Right-click a row and choose \"Start Change Marker\" to open the two documents and start comparing them (only rows where both files exist can be chosen)\n\nStory Edits (open with the triangle): the stories that differ, and what changed (Story Changes mode only - the Pixel mode compares pixels alone) - as one sign in the narrow column: + is in the newer document only, - in the older one only, = means the words were compared and agree, and a not-equals sign means they differ. Click a row to show that story in both documents, then walk the list with the up and down arrow keys. A frame copied from an earlier document and pasted at the same place is compared with the story whose frame stood there, though its story ID is new (on the corresponding page, at exactly the same position and size); clicking its row names that Source story on the status line. A change row's click selects its words in the Target (the Type tool comes on); click the document to type there.\n- What writes into your document is on the right-click of a change row or a story row, and each is one Ctrl+Z (rows selected together, one step). With the imported text as the Source: the items of the round trip above. In a comparison of two documents: \"Restore from Source\" (the Source's words - or, for a ruby, kenten, tate-chu-yoko or warichu, its mark - put back over the Target's; refused where an object would be made anew, as above), \"Restore All Changes in This Story\" on a story row (its words' changes, one by one, the same way), \"Restore from Copy\" on the \"=\" a restore leaves (the Target's words back), and \"Match the Source\" (on a Table row whose rows, columns or merged cells differ: the table is given the Source's shape - rows, columns, merges, header and footer rows - and the cells that shape brings or changes are given the Source's content and settings, row heights and column widths included; it stays the same table, and a cell that is the same cell on both sides is left alone - its words show as a Cell Text row of their own. The table is then read back - its text, its geometry, and everything else as INX writes it - and when anything is not as promised, nothing is changed and the reason is shown). Start opens the Source in a window and leaves it open, whether it is a Task Start (Save)... copy or the other document you chose (a Task Start kept in memory and the imported text have no window).\n\nWith comparison-mark printing ON, the marks appear both when printing and in File > Export to PDF (including Acrobat 4 / PDF 1.3 submission presets such as PDF/X-1a).\n\n[Finding overset]\nUse InDesign's own Preflight panel to find overset (overflowing) text.\n- \"Find Overset\" and \"Refresh Overset\" were removed from this plug-in on 2026-09-08, because they did the same work twice.\n\n[Cat paw stamps (Kohaku Cat Paw Tool)]\nPut a paw-print landmark anywhere on a page. Hold the Kohaku Change Marker tool in the toolbox (or the tool button on the panel) to open its flyout, then pick the stamp tool.\n- Click to place; Shift+click to lift\n- Alt+click asks for a note first: type one line or several, and the words are drawn beside the paw\n- Shift+Alt+click SWAPS the colour between red and blue. It places nothing - it only changes what the next click puts down\n- A paw cannot be stacked where one already is\n- Paws need no comparison and survive Stop Comparison, exactly like checks\n- On screen always; in print and PDF only with \"Print comparison marks\" on\n- PAWS AND CHECKS ARE WRITTEN INTO THE DOCUMENT, as script labels on the page that carries them. They go in the moment you make them, Ctrl+Z takes them back, and they come home when the document is opened again - so the file carries them to anyone else who has this plug-in\n- \"Clear Cat Paws in This Document\" and \"Clear Checks in This Document\" clear the active document of one kind each\n\nDISCLAIMER: Provided as-is. We cannot take responsibility for any problems that may arise. Use at your own risk.",

		// ----- Misc strings
                // About is one line, name + version (user's call): no description, no credits and
                // no repository URL. That is why nothing here needs translating.
                kKCMAboutBoxStringKey,			kKCMDisplayName " version " kKCMVersion,



        }

};

#endif // __ODFRC__
