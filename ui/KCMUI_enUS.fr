#ifdef __ODFRC__

// English string table is defined here

resource StringTable (kSDKDefStringsResourceID + index_enUS)
{
        k_enUS,									// Locale Id
        kEuropeanWinToMacEncodingConverter,		// Character encoding converter (irp) I made this WinToMac as we have a bias to generate on Win...
        {
        	 // ----- Menu strings
                kKCMCompanyKey,					"Kohaku Plug-Ins",	// the menu grouping name as shown; a different thing from the company value kKCMCompanyValue
                kKCMAboutMenuKey,					kKCMDisplayName "...",

                kSDKDefAboutThisPlugInMenuKey,			kSDKDefAboutThisPlugInMenuValue_enUS,
                kKCMUsageMenuKey,				"How to Use...",
                // ★Renamed from "Show Marks on Target" / "Show Marks on Source" (user's request:
                //   an English name that says "always visible" at a glance). The old names did not
                //   say what the toggle does: marks appear anyway while the tool's left button is
                //   held, so "Show Marks on ..." could not be told from that gesture.
                // ⚠**"Hold" is deliberately NOT in the name** (considered and rejected). The press
                //   gesture works **independently of this toggle and inverts whatever state it is
                //   in**, so putting "Hold" here would read as "this toggle IS the hold". On top of
                //   that, "Hold to Hide Marks" was a real toggle that has since been removed, and
                //   the name would be read as its return.
                kKCMShowTgtMarksMenuKey,			"Always Show Marks on Target",
                kKCMShowSrcMarksMenuKey,			"Always Show Marks on Source",
                kKCMPageMapToggleMenuKey,			"Register as Added/Removed Pages",
                kKCMPageCheckMenuKey,				"Check",
                kKCMPageRefreshCompareMenuKey,	"Refresh Page Comparison",
                kKCMHideUnchangedMenuKey,			"Hide Unchanged Spreads",
                kKCMShowOldNumsMenuKey,			"Show Original Page Numbers",
                kKCMShowStoryIdsMenuKey,		"Show Story IDs",
                kKCMSyncViewsMenuKey,				"Sync Layout Views",
                kKCMAlignViewsMenuKey,			"Align Other Views to Active",
                kKCMTranslucentPanelMenuKey,		"Translucent Kohaku Change Marker Panel",
                kKCMTranslucentPagesPanelMenuKey,	"Translucent Pages Panel",
                kKCMTranslucentBookDialogMenuKey,	"Translucent Compare Books Dialog",
                kKCMSavePanelStateMenuKey,			"Save Panel Settings",
                kKCMClearChecksMenuKey,			"Clear Checks in This Document",
                kKCMClearPawsMenuKey,			"Clear Cat Paws in This Document",
                kKCMRefreshCompareMenuKey,		"Refresh Comparison",
                kKCMExportReportMenuKey,		"Export Before/After PDF Report",
                kKCMCompareBooksMenuKey,			"Compare Books",
                kKCMSetTargetMenuKey,				"Set as Target",
                kKCMSetSourceMenuKey,				"Set as Source",
                kKCMTaskStartMenuKey,				"Task Start (Save)...",
                kKCMTaskStartCloneMenuKey,			"Task Start",
		kKCMExportStoryTextMenuKey,			"Export Story Text...",
		kKCMExportPagesMenuKey,				"Export Pages to Word...",
		kKCMImportStoryTextMenuKey,			"Import Story Text...",
		kKCMCompareTrackedMenuKey,			"Compare with Tracked Changes",
                kKCMClearChosenMenuKey,			"Clear Target and Source",
                kKCMBookDialogTitleKey,			"Kohaku Change Marker - Compare Books",
                kKCMPawWordDialogTitleKey,		"Kohaku Change Marker - Cat Paw",
                kKCMPawWordLabelKey,			"Note:",
                kKCMBookCompareKey,				"Compare",
                kKCMBookReadyKey,					"No comparison has been run yet.",
                kKCMBookHintKey,					"Right-click a changed chapter to start Change Marker.",
                kKCMBookCompareConfirmKey,		"These two books will be compared chapter by chapter in three ways: as pictures, by their story text, and by their definitions - the comparison mode does not change this.",
                kKCMBookNoPairKey,				"Select a book tab in the Book panel, and open a second book.",
                kKCMBookRowStartMenuKey,			"Start Change Marker",
                kKCMStoryRowRefreshMenuKey,		"Refresh Story Comparison",
                kKCMChangeRowRestoreAttrMenuKey,	"Restore from Source",
                kKCMChangeRowMatchTableMenuKey,	"Match the Source",
                kKCMChangeRowApplyMenuKey,		"Apply This Change",				// (2026-10-24, the import-as-Source road)
                kKCMChangeRowRestoreFromCopyMenuKey,	"Restore from Copy",			// (2026-10-24 evening - KFC's name for the same thing)
                kKCMStoryRowApplyMenuKey,		"Apply All Changes in This Story",
                kKCMApplyAllMenuKey,	"Apply All Changes",
                kKCMStoryRowRestoreAllMenuKey,	"Restore All Changes in This Story",	// (2026-10-24 night - the Story mode's, by copy)
                // ★(2026-10-25) the Track mode's accept and reject - four scopes (InDesign's own words: Accept / Reject Change)
                kKCMTrackAcceptChangeMenuKey,	"Accept Change",
                kKCMTrackRejectChangeMenuKey,	"Reject Change",
                kKCMTrackAcceptStoryMenuKey,	"Accept This Author's Changes in Story",
                kKCMTrackRejectStoryMenuKey,	"Reject This Author's Changes in Story",
                kKCMTrackAcceptAuthorMenuKey,	"Accept All Changes by This Author",
                kKCMTrackRejectAuthorMenuKey,	"Reject All Changes by This Author",
                kKCMTrackAcceptAllMenuKey,		"Accept All Changes in Document",
                kKCMTrackRejectAllMenuKey,		"Reject All Changes in Document",
                kKCMResourceRowXmlMenuKey,		"Show as XML",
                // (⛔Two "Edit..." strings stood here from 2026-09-13 and went on 2026-09-21 with
                //  the items that carried them - one on a definition row's menu, one on an
                //  attribute row's - and with the editor they opened.)
                // (⛔Four strings went on 2026-09-21 with the restore: "Restore Source Text",
                //  "Undo the Restore", "Restore All in This Story", and the question asked before a new
                //  paragraph was taken in ahead of the one before it.)
                kKCMIgnorePageNumMenuKey,			"Ignore Page Number Marker",
                kKCMPairByUidMenuKey,				"Pair Pages by UID",
                // ("Hold to Hide Marks" was retired on 2026-08-22 - see KCMUI.fr's MenuDef note.)

                // Keyboard Shortcuts editor area for shortcut-assignable actions: the value string that
                // "KBSCE Palette Menus: Kohaku Change Marker: " (kKCMPanelMenuActionArea) resolves to. This
                // files those actions under Product Area "Palette Menus", prefixed "Kohaku Change Marker".
                kKCMPanelMenuActionArea,			kKCMPanelMenuActionAreaValue,

                // ----- Command strings

                // ----- Window strings

                // ----- Panel/dialog strings
                kKCMPanelTitleKey,			"Kohaku Change Marker",
                kKCMToolStringKey,			"Kohaku Change Marker Tool",	// the tool name in the toolbox tooltip; English in every locale
                kKCMPawToolStringKey,		"Kohaku Cat Paw Tool",		// the stamp tool's name in the KCM tool's flyout (its tooltip); English in every locale, as the line above
                kKCMTargetLabelKey,			"Target:",
                kKCMSourceLabelKey,			"Source:",
                kKCMStartButtonKey,			kKCMStartMenuText,
                kKCMPrintCheckKey,			"Print comparison marks",
                // An alert, shown every time the toggle above is switched ON (never when it is
                // switched OFF). English in every locale - see the note on the key in KCMUIID.h.
                // ★**IT NAMES THE SCREEN TOO** (2026-09-08). Turning this on also shows the marks on
                // screen, permanently, in BOTH documents - that is what makes "what you see is what
                // comes out" true. The sentence used to mention only print and PDF, so the reader
                // watched the screen change and was told nothing about why.
                kKCMPrintMarksOnKey,			"Comparison marks will now appear in print and in exported PDF files, and stay visible on screen in both documents.",
                kKCMOpacitySubmenuKey,			"Marks opacity",					// (2026-10-27) the three submenus' names, by key - KCMUIID.h says why
                kKCMColorSubmenuKey,			"Mark colour",
                kKCMCompareModesSubmenuKey,		"Compare mode",
                kKCMOpacity25Key,				"25%",
                kKCMOpacity75Key,				"75%",
                kKCMColorRedKey,				"Red",
                kKCMColorCyanKey,				"Cyan",
                kKCMModePixelKey,				"Pixel Changes",
                kKCMModeStoryKey,				"Story Changes",
                kKCMModeResourcesKey,			"Resources Changes",
                kKCMTrackSectionLabelKey,		"Tracked Changes",
                kKCMPrevChangeKey,			"< Prev",
                kKCMNextChangeKey,			"Next >",

                // Story Edits section. The kind words are what a row says on its right; "Added" means
                // the older version holds no story to compare this one against at all, and "Deleted"
                // means the NEWER one does not - that row is a story of the older document, and
                // clicking it moves the source window alone (2026-08-21).
                // ★THE WORD IS "Deleted" WHILE THE KEY AND THE ENUM SAY "Removed", and the mismatch
                // is deliberate (user's call, 2026-08-21). "Delete" on its own would be a verb in the
                // imperative - an instruction rather than a report - beside "Added", which is a past
                // participle; "Deleted" keeps the two the same part of speech. The key was not renamed
                // with it because a string key is not a display string: renaming it would touch the
                // enum, the model and the UI to change four letters that never reach the screen.
                kKCMStorySectionLabelKey,		"Story Edits",
                kKCMProposedSectionLabelKey,	"Proposed Edits",					// (2026-10-24 evening) the heading while the Source is an import's copy - the author's words
                kKCMStoryNoEditsKey,			"No edits",
                kKCMStoryPixelNoteKey,			"Not compared in Pixel mode",
                kKCMResourcesSectionLabelKey,	"Resources",
                kKCMResourcesNoChangesKey,		"No differences",
                kKCMResourcesColKindKey,		"Kind",
                kKCMResourcesColKeyKey,			"Definition",
                kKCMStoryKindTextKey,			"Text",
                kKCMStoryKindAttrKey,			"Attr",
                kKCMStoryKindOtherKey,		"Other",
                kKCMStoryKindAddedKey,		"Added",
                kKCMStoryKindRemovedKey,		"Deleted",
                kKCMStoryKindNoneKey,			"None",
                kKCMStoryKindRubyKey,			"Ruby",
                kKCMStoryKindKentenKey,		"Kenten",
                kKCMStoryKindFootnoteKey,		"Footnote",
                kKCMStoryKindEndnoteKey,		"Endnote",

                // The list's column headings. ★"Story" and "Change" rather than "Text" and "Kind":
                // the words in the rows already use "Text" for one of the kinds, so heading the
                // second column "Text" would put the same word twice in one row meaning two
                // different things (user's call, 2026-08-10).
                kKCMStoryColUIDKey,			"ID",
                kKCMStoryColTextKey,			"Story",
                kKCMStoryColKindKey,			"Change",

                kKCMHintKey,					"DISCLAIMER: Provided as-is. We cannot take responsibility for any problems that may arise. Use at your own risk.\n\n[Kohaku Change Marker tool]\n- Hold Left button\n  show comparison marks (while held / opacity 25%/75% from the panel)\n- Hold Left + Shift\n  show the original (old version, while held)\n- Hold Left + Shift+" kKCMAltKeyName "\n  show the original at 50% (while held)\n- Hold Left + " kKCMAltKeyName "\n  color info (CMYK) at the click point, shown on the cursor and the panel\n- Shift/" kKCMAltKeyName " can be held or released\n\n[Page pairing and added / removed pages (Pair Pages by UID / Add / Remove)]\nBy default a page is compared with the page that has the same UID (internal id) in the other document.\n- Two documents made separately, or one that went through IDML, share no UIDs: nothing pairs, and the pages get the red diagonal line. Then turn \"Pair Pages by UID\" OFF, and pages are paired by position from the first page on.\n- Under the positional rule an added or removed page shifts everything after it and shows changes that are not there, so you can register such pages to exclude them from the comparison.\n- How to: in the Pages panel, select pages, right-click, and choose \"Register as Added/Removed Pages\".\n\n[Checking pages (Check)]\nYou can put a check mark on pages you have finished reviewing. A check stays until you clear it (it survives Stop Comparison, and closing the document forgets it).\n- How to: in the Pages panel, select pages, right-click, and choose \"Check\" (repeat to clear)\n- Checks, registrations (Add / Remove) and cat paws can be saved and loaded.\n- Checks and cat paws are written into the document's page automatically the moment you place one (Undo/Redo takes them back). Save the document and they are still there the next time you open it.\n- Registrations (Added/Removed) are settings for the comparison, so they are not written into the document, and Stop Comparison clears them.\n\n[Refresh page comparison (Refresh Page Comparison)]\nRecompare just the pages you edited. Available only while Start Comparison is active, in the Pixel comparison mode.\n- How to: in the Pages panel, select pages, right-click, and choose \"Refresh Page Comparison\".\n- Right-click in the Target (the newer one). The marks and thumbnails of the selected pages and of their Source counterparts are both brought up to date.\n\n",
                // ★(2026-10-28) THE HOW TO USE IS THE AUTHOR'S TEXT: the Japanese file the author wrote
                //   (ui/KCMLoc.h kHint / kHint2, built line for line from it), put into English section for
                //   section - the disclaimer at the head, as the author moved it. ASCII only: this table has no
                //   BOM (the Japanese marks NOTE n / a not-equals sign are named in words). Change it with the
                //   author.
                // ★A third piece (2026-09-12): kKCMHintKey and kKCMHint2Key both sat at odfrc's
                //   length limit for one string, so Task Start has a key of its own. DoUsage reads
                //   hint / hint3 / hint4 / hint5 / hint2, and the Japanese side (KCMLoc.h) carries the
                //   same sections at the same seams - Task Start at the head of its kHint2.
                kKCMHint3Key,				"[Comparing with a moment ago (Task Start)]\nTakes the document's state at this moment and makes it the Source.\n- \"Task Start\": keeps the state in memory.\n- \"Task Start (Save)...\": saves a copy of the document as a file where you choose, and makes that file the Source.\n- In the Pixel comparison a page that carries a date variable always shows as changed (the variable draws the date of its own moment).\n\n[Before / After PDF report (Export Before/After PDF Report)]\nThe report compares the two documents itself and writes them out as one PDF.\n\n[Story IDs (Show Story IDs)]\nShows the ID of the story on every frame that holds text (a text frame, text on a path, an anchored frame) above the frame, as \"StoryID:<number>\". The number is the one a script reads as story.id.\n- How to: switch \"Show Story IDs\" ON from the panel's flyout menu.\n\n",
                // ★A fourth piece (2026-09-19): the story text round trip. Read after kKCMHint3Key
                //   (DoUsage: hint / hint3 / hint4 / hint2); the Japanese side carries the same section
                //   inside its kHint2, after Story IDs and before the books - the same seam.
                kKCMHint4Key,				"[Story text round trip (Export Story Text / Export Pages to Word / Import Story Text)]\nWrites stories out as Word documents, lets somebody edit them outside InDesign, and puts the edits into the document one by one.\n- \"Export Story Text...\" writes one .docx per story. With a frame selected only its story is written; with nothing selected, every story.\n- \"Import Story Text...\" does not change your document. The list's heading says \"Proposed Edits\", and each change row is a proposal: what your document would become.\n- Whatever could not go into the copy is listed FIRST, with a red ! in the Change column and the place and the reason beside it.\n- A table inside a paragraph: Word has no such thing, so the file shows \"the words before the table\", \"the table\" and \"the words after the table\" as separate blocks. Where the paragraph breaks around a table is decided by your document as it stands, not by the file: a break added or removed next to a table in Word changes nothing. Split or join a paragraph next to a table in InDesign.\n- \"Export Pages to Word...\" (the Pages panel's page menu, or this flyout) writes each selected page as one .docx, named \"p<page>.docx\", in a folder \"Pages <date and time>\". Each text frame becomes a text box where the frame stands, holding its whole story (for catalogue pages of many frames). A table goes into its box as a Word table. A footnote reference becomes a mark reading NOTE n (n the footnote's number), and the footnotes' words are gathered on the file's second page, each in a box under the heading \"Box b NOTE n\": edit a footnote's words in its box. A mark cannot be edited but can be deleted; deleting it proposes taking that footnote out. Word cannot make a new footnote in a text box, so add footnotes with \"Export Story Text...\". Not written, and named on the status line with their pages: a threaded frame (write a threaded story out whole with \"Export Story Text...\"), an overset frame, a vertical frame holding a table (Word cannot lay it out), and a frame holding an endnote reference. Bring the edited files back with \"Import Story Text...\", like story files.\n\n",
                // ★A fifth piece (2026-10-05): the Track Changes listing (Compare with Tracked Changes alone since 2026-10-27). Read after kKCMHint4Key (DoUsage).
                kKCMHint5Key,				"[Tracked changes (Compare with Tracked Changes...)]\nLists the changes InDesign's Track Changes recorded in the document.\n\n",
                kKCMHint2Key,				"[Comparing books (Compare Books)]\nCompares two books (.indb) chapter by chapter and lists which chapters changed.\n- How to: in the Book panel, bring the tab of the book you want to compare to the front, open the second book as well, then choose \"Compare Books\" from the panel's flyout menu.\n- The book on the front tab is the Target (the newer one); the first other open book is the Source (the older one).\n- Each chapter gets its own result: Changed / NoChange / ChapterAdded (only in the Target) / ChapterDeleted (only in the Source) / Failed (could not be opened, or opened and nothing could judge it - the reason is shown next to it) / NotCompared (the run was cancelled before judging it)\n- The Change column names which of the three comparisons found a difference: Pixel / Story / Resources (a comparison that could not be judged carries a \"?\")\n- Double-click a row to open that chapter's two documents, the newer and the older.\n- Right-click a row and choose \"Start Change Marker\" to open the chapter's two documents and start comparing them (only rows where both files exist can be chosen).\n\n[Changed stories (Story Edits)]\nOpen it with the triangle button at the bottom of the panel: it lists the stories that changed between the Source version and the Target version (only while comparing in the Story comparison mode - the Pixel comparison mode compares pixels alone, not stories).\n- On the left of a row, the start of its text; in the narrow column, one sign (+ only in the Target / - only in the Source / = compared and the same / a not-equals sign: different)\n- Click a row to show that story in both the Target and the Source\n- A frame copied from an earlier document and pasted at the same place is compared with the story of the frame that stood there, though its story ID is new (on the corresponding page, at exactly the same position and size). Click its row and the status line names the Source story it was paired with\n- From then on, the up and down arrow keys move through the rows (the story moved to is shown)\n- Click a change row to select its words in the Target (the Type tool comes on). The keyboard stays with the list, so click the document to type there\n- What writes into your document is on the right-click of a change row or a story row, and each is one Ctrl+Z (rows selected together, one step). With the imported text as the Source: the items of the round trip above. In a comparison of two documents: \"Restore from Source\" (the Source's words - or, for a ruby, kenten, tate-chu-yoko or warichu, its mark - put back over the Target's; refused where an object would be made anew, as above), \"Restore All Changes in This Story\" on a story row (its words' changes, one by one, the same way), \"Restore from Copy\" on the \"=\" a restore leaves (the Target's words back), and \"Match the Source\" (on a Table row: the table is given the Source's rows, columns, merges, header and footer rows, and the cells that shape brings or changes are given the Source's content and settings, row heights and column widths included; it stays the same table, and a cell that is the same cell on both sides is left alone - its words show as a Cell Text row of their own. The table is then read back three ways - its text, its geometry as the table itself reports it, and everything else as INX writes it - and when anything is not as promised, nothing is changed and the reason is shown). Start opens the Source in a window, whether it is a Task Start (Save)... copy or the other document you compared, so it is always in front of you (a Task Start kept in memory and the imported text have no window).\n\n[Cat paw stamps (Kohaku Cat Paw Tool)]\nPut a paw-print landmark anywhere on a page. Hold the Kohaku Change Marker tool in the toolbox (or the tool button on the panel) to open its flyout, then pick the stamp tool.\n- Click to place; Shift+click to lift\n- Alt+click (or Alt+drag) asks for a note when you let go, then places the paw (one line or several; the words are drawn beside the paw)\n- Shift+Alt+click only swaps the colour between red and blue and places no paw (the next paw gets the new colour)\n- Shown in print and PDF only with \"Print comparison marks\" ON\n- Paws are written into the document's page, as its Script Label.",

		// ----- Misc strings
                // About is one line, name + version (user's call): no description, no credits and
                // no repository URL. That is why nothing here needs translating.
                kKCMAboutBoxStringKey,			kKCMDisplayName " version " kKCMVersion,



        }

};

#endif // __ODFRC__
