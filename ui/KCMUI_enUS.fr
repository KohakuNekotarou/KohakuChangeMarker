#ifdef __ODFRC__

// English string table is defined here

resource StringTable (kSDKDefStringsResourceID + index_enUS)
{
        k_enUS,									// Locale Id
        kEuropeanWinToMacEncodingConverter,		// Character encoding converter (irp) I made this WinToMac as we have a bias to generate on Win...
        {
        	 // ----- Menu strings
                kKCMCompanyKey,					"Kohaku Plug-Ins",	// the menu grouping name as shown; a different thing from the company value kKCMCompanyValue
                kKCMAboutMenuKey,					kKCMDisplayName "...",

                kSDKDefAboutThisPlugInMenuKey,			kSDKDefAboutThisPlugInMenuValue_enUS,
                kKCMUsageMenuKey,				"How to Use...",
                // ★Renamed from "Show Marks on Target" / "Show Marks on Source" (user's request:
                //   an English name that says "always visible" at a glance). The old names did not
                //   say what the toggle does: marks appear anyway while the tool's left button is
                //   held, so "Show Marks on ..." could not be told from that gesture.
                // ⚠**"Hold" is deliberately NOT in the name** (considered and rejected). The press
                //   gesture works **independently of this toggle and inverts whatever state it is
                //   in**, so putting "Hold" here would read as "this toggle IS the hold". On top of
                //   that, "Hold to Hide Marks" was a real toggle that has since been removed, and
                //   the name would be read as its return.
                kKCMShowTgtMarksMenuKey,			"Always Show Marks on Target",
                kKCMShowSrcMarksMenuKey,			"Always Show Marks on Source",
                kKCMPageMapToggleMenuKey,			"Register as Added/Removed Pages",
                kKCMPageCheckMenuKey,				"Check",
                kKCMPageRefreshCompareMenuKey,	"Refresh Page Comparison",
                kKCMHideUnchangedMenuKey,			"Hide Unchanged Spreads",
                kKCMShowOldNumsMenuKey,			"Show Original Page Numbers",
                kKCMShowStoryIdsMenuKey,		"Show Story IDs",
                kKCMSyncViewsMenuKey,				"Sync Layout Views",
                kKCMAlignViewsMenuKey,			"Align Other Views to Active",
                kKCMTranslucentPanelMenuKey,		"Translucent Kohaku Change Marker Panel",
                kKCMTranslucentPagesPanelMenuKey,	"Translucent Pages Panel",
                kKCMTranslucentBookDialogMenuKey,	"Translucent Compare Books Dialog",
                kKCMSavePanelStateMenuKey,			"Save Panel Settings",
                kKCMClearChecksMenuKey,			"Clear Checks in This Document",
                kKCMClearPawsMenuKey,			"Clear Cat Paws in This Document",
                kKCMRefreshCompareMenuKey,		"Refresh Comparison",
                kKCMExportReportMenuKey,		"Export Before/After PDF Report",
                kKCMCompareBooksMenuKey,			"Compare Books",
                kKCMSetTargetMenuKey,				"Set as Target",
                kKCMSetSourceMenuKey,				"Set as Source",
                kKCMTaskStartMenuKey,				"Task Start",
		kKCMExportStoryTextMenuKey,			"Export Story Text...",
		kKCMImportStoryTextMenuKey,			"Import Story Text...",
                kKCMClearChosenMenuKey,			"Clear Target and Source",
                kKCMBookDialogTitleKey,			"Kohaku Change Marker - Compare Books",
                kKCMPawWordDialogTitleKey,		"Kohaku Change Marker - Cat Paw",
                kKCMPawWordLabelKey,			"Note:",
                kKCMBookCompareKey,				"Compare",
                kKCMBookReadyKey,					"No comparison has been run yet.",
                kKCMBookHintKey,					"Right-click a changed chapter to start Change Marker.",
                kKCMBookCompareConfirmKey,		"These two books will be compared chapter by chapter in three ways: as pictures, by their story text, and by their definitions - the comparison mode does not change this.",
                kKCMBookNoPairKey,				"Select a book tab in the Book panel, and open a second book.",
                kKCMImportTaskStartAdviceKey,	"It is best to take a Task Start just before an import. Compared against it afterwards, the document shows exactly what the import changed - a Task Start taken earlier shows your other edits as well. OK imports now; Cancel stops here so that you can take a Task Start first.",
                kKCMImportedStatusKey,			"Imported",
                kKCMImportTrackedKey,			"Imported with change tracking: every change the import made is recorded under the name \"KohakuChangeMarker\", and each one can be rejected in the Track Changes panel. Rows, columns and merged cells changed in Word were made so as well, but the change history does not record those: a reject leaves that shape (Ctrl+Z takes the whole import back).",
                kKCMBookRowStartMenuKey,			"Start Change Marker",
                kKCMStoryRowRefreshMenuKey,		"Refresh Story Comparison",
                kKCMChangeRowRejectMenuKey,		"Reject This Import Change",
                kKCMChangeRowRestoreAttrMenuKey,	"Restore from Source",
                kKCMChangeRowRedoMenuKey,		"Redo from Word",
                kKCMResourceRowXmlMenuKey,		"Show as XML",
                // (⛔Two "Edit..." strings stood here from 2026-09-13 and went on 2026-09-21 with
                //  the items that carried them - one on a definition row's menu, one on an
                //  attribute row's - and with the editor they opened.)
                // (⛔Four strings went on 2026-09-21 with the restore: "Restore Source Text",
                //  "Undo the Restore", "Restore All in This Story", and the question asked before a new
                //  paragraph was taken in ahead of the one before it.)
                kKCMIgnorePageNumMenuKey,			"Ignore Page Number Marker",
                kKCMPairByUidMenuKey,				"Pair Pages by UID",
                // ("Hold to Hide Marks" was retired on 2026-08-22 - see KCMUI.fr's MenuDef note.)

                // Keyboard Shortcuts editor area for shortcut-assignable actions: the value string that
                // "KBSCE Palette Menus: Kohaku Change Marker: " (kKCMPanelMenuActionArea) resolves to. This
                // files those actions under Product Area "Palette Menus", prefixed "Kohaku Change Marker".
                kKCMPanelMenuActionArea,			kKCMPanelMenuActionAreaValue,

                // ----- Command strings

                // ----- Window strings

                // ----- Panel/dialog strings
                kKCMPanelTitleKey,			"Kohaku Change Marker",
                kKCMToolStringKey,			"Kohaku Change Marker Tool",	// the tool name in the toolbox tooltip; English in every locale
                kKCMPawToolStringKey,		"Kohaku Cat Paw Tool",		// the stamp tool's name in the KCM tool's flyout (its tooltip); English in every locale, as the line above
                kKCMTargetLabelKey,			"Target:",
                kKCMSourceLabelKey,			"Source:",
                kKCMStartButtonKey,			kKCMStartMenuText,
                kKCMPrintCheckKey,			"Print comparison marks",
                // An alert, shown every time the toggle above is switched ON (never when it is
                // switched OFF). English in every locale - see the note on the key in KCMUIID.h.
                // ★**IT NAMES THE SCREEN TOO** (2026-09-08). Turning this on also shows the marks on
                // screen, permanently, in BOTH documents - that is what makes "what you see is what
                // comes out" true. The sentence used to mention only print and PDF, so the reader
                // watched the screen change and was told nothing about why.
                kKCMPrintMarksOnKey,			"Comparison marks will now appear in print and in exported PDF files, and stay visible on screen in both documents.",
                kKCMOpacity25Key,				"25%",
                kKCMOpacity75Key,				"75%",
                kKCMColorRedKey,				"Red",
                kKCMColorCyanKey,				"Cyan",
                kKCMModePixelKey,				"Pixel Changes",
                kKCMModeStoryKey,				"Story Changes",
                kKCMModeResourcesKey,			"Resources Changes",
                kKCMPrevChangeKey,			"< Prev",
                kKCMNextChangeKey,			"Next >",

                // Story Edits section. The kind words are what a row says on its right; "Added" means
                // the older version holds no story to compare this one against at all, and "Deleted"
                // means the NEWER one does not - that row is a story of the older document, and
                // clicking it moves the source window alone (2026-08-21).
                // ★THE WORD IS "Deleted" WHILE THE KEY AND THE ENUM SAY "Removed", and the mismatch
                // is deliberate (user's call, 2026-08-21). "Delete" on its own would be a verb in the
                // imperative - an instruction rather than a report - beside "Added", which is a past
                // participle; "Deleted" keeps the two the same part of speech. The key was not renamed
                // with it because a string key is not a display string: renaming it would touch the
                // enum, the model and the UI to change four letters that never reach the screen.
                kKCMStorySectionLabelKey,		"Story Edits",
                kKCMStoryNoEditsKey,			"No edits",
                kKCMResourcesSectionLabelKey,	"Resources",
                kKCMResourcesNoChangesKey,		"No differences",
                kKCMResourcesColKindKey,		"Kind",
                kKCMResourcesColKeyKey,			"Definition",
                kKCMStoryKindTextKey,			"Text",
                kKCMStoryKindAttrKey,			"Attr",
                kKCMStoryKindOtherKey,		"Other",
                kKCMStoryKindAddedKey,		"Added",
                kKCMStoryKindRemovedKey,		"Deleted",
                kKCMStoryKindNoneKey,			"None",
                kKCMStoryKindRubyKey,			"Ruby",
                kKCMStoryKindKentenKey,		"Kenten",
                kKCMStoryKindFootnoteKey,		"Footnote",
                kKCMStoryKindEndnoteKey,		"Endnote",

                // The list's column headings. ★"Story" and "Change" rather than "Text" and "Kind":
                // the words in the rows already use "Text" for one of the kinds, so heading the
                // second column "Text" would put the same word twice in one row meaning two
                // different things (user's call, 2026-08-10).
                kKCMStoryColUIDKey,			"ID",
                kKCMStoryColTextKey,			"Story",
                kKCMStoryColKindKey,			"Change",

                kKCMHintKey,					"Select the Kohaku Change Marker tool (from the toolbox, or with the tool button on the panel), then on the layout:\nHold Left button =\n  show comparison marks (while held;\n  opacity 25%/75% from panel)\nHold Left + Shift =\n  original (old version, while held)\nHold Left + Shift+" kKCMAltKeyName "=\n  original 50% (while held)\nHold Left + " kKCMAltKeyName "=\n  color info (CMYK) at the click point,\n  shown on the cursor and panel\n\nShift/" kKCMAltKeyName " can be held or released\n\n[Page pairing and added / removed pages (Pair Pages by UID / Add / Remove)]\nBy default a page is compared with the page that has the same UID (internal id) in the other document (\"Pair Pages by UID\" on the flyout, ON). When the newer version was made by saving the older one under another name, pages that were added, removed or moved still meet their right partner, and the pages found in only one document (added in the Target, removed from the Source) are marked with a red diagonal line without any registration.\n- Two documents made separately, or one that went through IDML, share no UIDs: nothing pairs and every page gets the red line. Turn \"Pair Pages by UID\" OFF to go back to the older rule, pairing by position from the first page on\n- Under the positional rule an added or removed page shifts everything after it, so you can register such pages to exclude them from the comparison\n- How to: in the Pages panel, select pages, right-click, and choose \"Register as Added/Removed Pages\"\n- Register in Target (the newer document) = added page / register in Source (the older document) = removed page\n- Repeat the same action to unregister\n- Registered pages show a green diagonal line; pages with no counterpart show a red diagonal line\n- Registering, unregistering or flipping the toggle while Start Comparison is active redoes the comparison automatically\n\n[Checking pages (Check)]\nYou can put a check mark on pages you have finished reviewing. A check stays until you clear it: it survives Stop Comparison, and closing the document forgets it.\n- How to: in the Pages panel, select pages, right-click, and choose \"Check\" (repeat to clear)\n- Any page of any open document can be checked, with or without a comparison running. While one IS running, the pixel mode still limits checks to pages that carry a mark; the story mode allows any page\n- Checks and cat paws are written INTO the document, onto the page, the moment you place one -- undoable, and kept in the file once you save it\n- Registrations (Add / Remove) tell the comparison that a page has no counterpart, so they are not written to the document, and they go at Stop Comparison\n- \"Clear Checks in This Document\" and \"Clear Cat Paws in This Document\" clear the active one\n\n[Refresh page comparison (Refresh Page Comparison)]\nRecompare just the pages you edited. Available while Start Comparison is active, in the pixel comparison mode only - the story comparison mode rasterises no page, so it has its own refresh instead: right-click a row in Story Edits and choose \"Refresh Story Comparison\".\n- How to: in the Pages panel, select pages, right-click, and choose \"Refresh Page Comparison\"\n- Right-click in the Target document (the newer one); the marks and thumbnails of the selected pages and of their Source counterparts are both updated\n\n",
                // ★A third piece (2026-09-12): kKCMHintKey and kKCMHint2Key both sit at odfrc's
                //   length limit for one string, so Task Start has a key of its own. DoUsage reads
                //   the three in the order hint / hint3 / hint2, and the Japanese side (KCMLoc.h)
                //   carries the same section at the same seam - at the head of its kHint2.
                kKCMHint3Key,				"[Comparing with a moment ago (Task Start)]\nSaves a copy of the document to a file you choose, and sets that file as the Source. Edit, then Start Comparison to see what changed since that moment, in any of the three modes.\n- How to: choose \"Task Start\" from the panel's flyout menu. A save dialog opens on the document's own folder, with a name made from the document's name and the time; press Save. Cancel and nothing happens at all\n- The Source line then shows the copy's path. The copy is NOT opened: Start opens it, in a window, and leaves it open when you stop\n- Which document is copied: the Target if you have chosen one, otherwise the document in front. That same document becomes the Target\n- It can be pressed while a comparison is running - that comparison stops first\n- The copy is an ordinary InDesign document. It stays where you saved it until you delete it, and you can open, print or compare it like any other\n\n[Before / After PDF report (Export Before/After PDF Report)]\nWrites the running comparison as one PDF in three parts. First page: the two documents, with Before on the left and After on the right. Then one landscape page per changed page of the pixel comparison - the older version on the left with the comparison marks printed on it, the newer version clean on the right, and no text on those pages; added pages have an empty left side, removed pages an empty right side. Then the Story table: the older wording on the left, the newer on the right, one row per edit, unchanged text pale and the changed text dark - ruby and kenten are set for real, and a footnote or endnote number stands as a superscript. Then the Resources table: one row per changed attribute of each definition, the older value on the left and the newer on the right. Both tables carry the panel's own columns (ID or Kind, then the sign) and a length shows the document's unit in brackets - 8.5 (12 Q) - in the panel as well.\n- How to: while a comparison is running, choose \"Export Before/After PDF Report\" from the panel's flyout menu\n- A save dialog asks where and under what name (\"<name>.compare-report.pdf\" is offered); the PDF is then opened in your PDF viewer\n- The two tables are filled in every comparison mode (the report compares the stories and the resources for itself when the mode did not). The pixel pages exist only when the pixel comparison ran; in the other modes the first page says so and only added / removed pages are shown\n- The marks on the Before side are the rings around what changed, without the frame along the page edge\n- Uses the current PDF export settings (reader spreads and security switched off). With Task Start as the Source, the left side is the copy you saved\n\n[Story IDs (Show Story IDs)]\nWrites \"StoryID:\" and the ID of its story above every frame that holds text - a text frame, a path with text on it, an anchored frame. The number is the one a script reads as story.id, and the one in the ID column of Story Edits. It sits outside the frame, on its top edge at the left, so it never lies over the text.\n- How to: switch \"Show Story IDs\" on from the panel's flyout menu (off by default; saved with the panel settings)\n- On screen always, at one size whatever the zoom; in print and PDF only with \"Print comparison marks\" on (and in the Before/After PDF report on the After side)\n- A frame whose path carries text as well shows two labels\n\n",
                // ★A fourth piece (2026-09-19): the story text round trip. Read after kKCMHint3Key
                //   (DoUsage: hint / hint3 / hint4 / hint2); the Japanese side carries the same section
                //   inside its kHint2, after Story IDs and before the books - the same seam.
                kKCMHint4Key,				"[Story text round trip (Export Story Text / Import Story Text)]\nWrites each story out as a Word document, lets somebody edit it outside InDesign, and brings the edits back into the document.\n- \"Export Story Text...\" writes one .docx per story, with revision tracking switched on and locked, so that only what was changed in Word comes back - edits made in InDesign since the export are left alone. With a frame selected only its story is written; with nothing selected, every story\n- \"Import Story Text...\" takes a Task Start of the document as it stands - a save dialog asks where to put the copy, and Cancel stops the import right there with nothing imported - then puts ALL the edits into the document and starts the Story comparison against that copy: the Source is the moment before the import, the Target is your document with the edits in. A Task Start you had chosen before is replaced by the import's own\n- Whatever could not go in - a change in Word that collides with an edit made in InDesign since the export, a table Word reshaped in a way that cannot be made (rows of unequal length, a nested table in the way), a cell or note the file does not have, a file with no story - is listed FIRST, with a red ! in the change column and the place and the reason beside it\n- Ctrl+Z takes the whole import back in one step. ONE change can be taken back too: the import writes with change tracking on, under the name \"KohakuChangeMarker\", so each change it made can be rejected in the Track Changes panel - a rejected deletion brings its footnotes and tables back with it. Or right-click one change row in the Story mode and choose \"Reject This Import Change\" to reject only the import's changes on that row. A table whose rows, columns or merged cells changed in Word is made Word's shape (rows and columns added or taken away at the end, cells merged and split as Word has them). The change history cannot record that, so rejecting the import's changes leaves the new shape - a row put in stays, empty; a row taken away does not come back; Ctrl+Z takes the whole import back, shape included. The words in its cells are recorded and can be rejected. Ruby, kenten, tate-chu-yoko and warichu are not in the change history: right-click that row and choose \"Restore from Source\" - the mark is read from the Source document itself and put back over the same characters (Ctrl+Z takes it back again). It works in any Story comparison, not only after an import; when the words under the mark differ as well, fix the words first. A change you took back - with \"Reject This Import Change\" or \"Restore from Source\" - stays on the list with \"=\" in the sign column, and its right-click menu offers \"Redo from Word\": the paragraph is made what Word shows again, from the content the import read (kept until the document is closed or InDesign quits), as one Ctrl+Z\n- Overset shows at once: an edit that no longer fits its frame is marked OV in the row, as in any Story comparison\n- A table inside a paragraph: Word has no such thing, so the file shows the words before the table, the table, and the words after it as separate blocks. Where the paragraph breaks around a table is decided by your document, not by the file - a break added or removed next to a table in Word changes nothing; split or join such a paragraph in InDesign\n\n",
                kKCMHint2Key,				"[Comparing books (Compare Books)]\nCompares two books (.indb) chapter by chapter and lists which chapters changed.\n- How to: in the Book panel, bring the tab of the book you want to compare to the front, open the second book as well, then choose \"Compare Books\" from the panel's flyout menu\n- The book on the front tab is the Target (the newer one); the first other open book is the Source (the older one)\n- Each chapter gets its own result: Changed / NoChange / ChapterAdded (only in the Target) / ChapterDeleted (only in the Source) / Failed (could not be opened, or opened and nothing could judge it - the reason is shown next to it) / NotCompared (the run was cancelled before reaching it)\n- The Change column names which of the three comparisons found the difference: Pixel, Story, Resources. A comparison that could not be judged carries a '?'\n- Double-click a row to open that chapter's two documents\n- Right-click a row and choose \"Start Change Marker\" to open the two documents and start comparing them (only rows where both files exist can be chosen)\n\nStory Edits (open with the triangle): the stories that differ, and what changed - as one sign in the narrow column: + is in the newer document only, - in the older one only, = means the words were compared and agree, and a not-equals sign means they differ. Click a row to show that story in both documents, then walk the list with the up and down arrow keys. Double-click selects the whole of that story (switches to the Type tool, and hands the keyboard back to the document).\n- Only three items on these menus write into your document, all on a CHANGE row and each one Ctrl+Z: \"Reject This Import Change\" (the import's changes on that row), \"Restore from Source\" (a ruby, kenten, tate-chu-yoko or warichu made what the Source document has) and \"Redo from Word\" (Word's words back over a change you took back). When you want the older wording back, copy it from the Source document itself: Start opens the Source in a window and leaves it open, whether it is a Task Start copy or the other document you chose. (\"Restore Source Text\", \"Undo the Restore\" and \"Restore All in This Story\" were removed on 2026-09-21.)\n\nWith comparison-mark printing ON, the marks appear both when printing and in File > Export to PDF (including Acrobat 4 / PDF 1.3 submission presets such as PDF/X-1a).\n\n[Finding overset]\nUse InDesign's own Preflight panel to find overset (overflowing) text.\n- \"Find Overset\" and \"Refresh Overset\" were removed from this plug-in on 2026-09-08, because they did the same work twice.\n\n[Cat paw stamps (Kohaku Cat Paw Tool)]\nPut a paw-print landmark anywhere on a page. Hold the Kohaku Change Marker tool in the toolbox (or the tool button on the panel) to open its flyout, then pick the stamp tool.\n- Click to place; Shift+click to lift\n- Alt+click asks for a note first: type one line or several, and the words are drawn beside the paw\n- Shift+Alt+click SWAPS the colour between red and blue. It places nothing - it only changes what the next click puts down\n- A paw cannot be stacked where one already is\n- Paws need no comparison and survive Stop Comparison, exactly like checks\n- On screen always; in print and PDF only with \"Print comparison marks\" on\n- PAWS AND CHECKS ARE WRITTEN INTO THE DOCUMENT, as script labels on the page that carries them. They go in the moment you make them, Ctrl+Z takes them back, and they come home when the document is opened again - so the file carries them to anyone else who has this plug-in\n- \"Clear Cat Paws in This Document\" and \"Clear Checks in This Document\" clear the active document of one kind each\n\nDISCLAIMER: Provided as-is. We cannot take responsibility for any problems that may arise. Use at your own risk.",

		// ----- Misc strings
                // About is one line, name + version (user's call): no description, no credits and
                // no repository URL. That is why nothing here needs translating.
                kKCMAboutBoxStringKey,			kKCMDisplayName " version " kKCMVersion,



        }

};

#endif // __ODFRC__
