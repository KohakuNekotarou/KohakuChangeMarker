// ***** READ THIS FILE AS CP1252, NOT AS THE MACHINE'S ANSI CODE PAGE. ***** (2026-08-15.)
//
// Same line, same reason, as source/KCM.rc -- see there for the full account. In short:
// kShortCopyRightStr holds the sign as the raw byte 0xA9, which is the copyright sign only in
// CP1252, and rc.exe defaults to the SYSTEM's ANSI code page (CP932 here), where it decodes as
// U+FF69, a halfwidth katakana. Measured on the built .pln both ways.
//
// WARNING: this half was left out when the model half was fixed, which put the two .pln of ONE
//  product in disagreement: KohakuChangeMarker.pln said U+00A9 while KohakuChangeMarkerUI.pln
//  still said U+FF69. Fixing only the half you happen to be auditing is how that happens -- the
//  audit blocks are a reading order, not a boundary for a one-line fix.
//
// *Do not put non-ASCII characters in this file, comments included: the pragma tells rc.exe how
//  to read the WHOLE file. (This comment block held a Japanese one and two decorative signs
//  until 2026-08-25 -- the rule and the file that states it were out of step.)
// *KESCL and KT still carry the same fault -- they share this template. Measured, not assumed:
//  neither .rc has a code_page pragma, while KBS.rc does.
#pragma code_page(1252)

#include "WinRezFlags.h"
#include "BuildNumber.h"
#include "KCMUIID.h"

1 VERSIONINFO
 FILEVERSION kMajorVersionNumberForResource, kMinorVersionNumberForResource, 0, kBuildNumber
 PRODUCTVERSION kMajorVersionNumberForResource, kMinorVersionNumberForResource, 0, 0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            // These values were left at the DollyXs template's (Adobe / 1.0), so Explorer's
            // properties and Task Manager both listed this file as someone else's plug-in at
            // version 1.0. They now name what the model half (KCM.rc) names.
            // The values themselves come from KCMBoundaryID.h, copied on both sides, so the
            // version is stated in one place ([[one-question-one-place]]).
            // WARNING: a built VersionInfo is invisible to every check that only asks whether
            // the plug-in loads. (Get-Item x.pln).VersionInfo is what shows it.
            VALUE "CompanyName", "Kohaku Plug-Ins\0"
            VALUE "FileDescription", kKCMDisplayName " (UI) - Adobe InDesign SDK Plug-in\0"
            VALUE "FileVersion", kKCMVersion, "\0"
            VALUE "InternalName", kKCMUIPluginName, "\0"
            VALUE "LegalCopyright", kShortCopyRightStr, "\0"

            VALUE "OriginalFilename", kKCMUIPluginName ".pln\0"
            VALUE "ProductName", "Adobe InDesign\0"
            VALUE "ProductVersion", kVersionNumberStr, "\0"
            VALUE "Copyright", kVersionCopyRightStr, "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

