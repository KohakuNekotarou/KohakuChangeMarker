// ***** READ THIS FILE AS CP1252, NOT AS THE MACHINE'S ANSI CODE PAGE. ***** (2026-08-15.)
//
// Same line, same reason, as source/KESCM.rc -- see there for the full account. In short:
// kShortCopyRightStr holds the sign as the raw byte 0xA9, which is the copyright sign only in
// CP1252, and rc.exe defaults to the SYSTEM's ANSI code page (CP932 here), where it decodes as
// U+FF69, a halfwidth katakana. Measured on the built .pln both ways.
//
// ⚠This half was left out when the model half was fixed earlier the same day, which put the two
//  .pln of ONE product in disagreement: KohakuChangeMarker.pln said U+00A9 while
//  KohakuChangeMarkerUI.pln still said U+FF69. Fixing only the half you happen to be auditing is
//  how that happens -- the audit blocks are a reading order, not a boundary for a one-line fix.
//
// *Do not put non-ASCII characters in this file, comments included: the pragma tells rc.exe how
//  to read the WHOLE file.
// *KESCL and KT still carry the same fault -- they share this template.
#pragma code_page(1252)

#include "WinRezFlags.h"
#include "BuildNumber.h"
#include "KCMUIID.h"

1 VERSIONINFO
 FILEVERSION kMajorVersionNumberForResource, kMinorVersionNumberForResource, 0, kBuildNumber
 PRODUCTVERSION kMajorVersionNumberForResource, kMinorVersionNumberForResource, 0, 0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            // ★★2026-08-15（第2段 Task 6B-2）: ここは DollyXs 雛形のまま（Adobe / 1.0）だった。
            //   ⇒ エクスプローラーのプロパティにもタスクマネージャーにも「Adobe 製の別プラグイン、
            //     版数 1.0」として出ていた。model 側（KESCM.rc）と同じ値を名乗らせる。
            //   ★値の出どころは KESCMBoundaryID.h（両側コピー）＝版数は1か所（[[one-question-one-place]]）。
            //   ⚠**成果物の VersionInfo は「ロードされるか」を測る口では絶対に見えない。**
            //     `(Get-Item x.pln).VersionInfo` を測って初めて分かった。
            VALUE "CompanyName", "Kohaku Plug-Ins\0"
            VALUE "FileDescription", kKESCMDisplayName " (UI) - Adobe InDesign SDK Plug-in\0"
            VALUE "FileVersion", kKESCMVersion, "\0"
            VALUE "InternalName", kKCMUIPluginName, "\0"
            VALUE "LegalCopyright", kShortCopyRightStr, "\0"

            VALUE "OriginalFilename", kKCMUIPluginName ".pln\0"
            VALUE "ProductName", "Adobe InDesign\0"
            VALUE "ProductVersion", kVersionNumberStr, "\0"
            VALUE "Copyright", kVersionCopyRightStr, "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

