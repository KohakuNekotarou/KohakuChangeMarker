		kKCMPageRefreshCompareActionID,
		kKCMPageRefreshCompareMenuKey,
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,	// UpdateActionStates supplies enabling (armed + front doc is Target/Source)
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,
	}
};


/*
 * Toolbox tool definition. Places the KCM tool in the toolbox. While it is the active tool,
 * holding the left mouse button reveals the comparison marks (modifier keys switch to the
 * peek / CMYK gestures - see the tool boss above). Group kSixthAdobeToolsGroup is a good slot
 * for third-party / SDK tools. The icon uses a dedicated tool icon (kKCMToolIconResID;
 * KCM_Tool_32.png/_64.png, supplied by the user) instead of the panel PNG suite.
 * kKCMToolActionID is the tool-select shortcut action (no ActionDef needed; the
 * toolbox framework provides the selection action for a tool).
 */
resource ToolDef (kKCMToolIconResID)
{
	kKCMToolBoss,				// classID for the tool boss
	kPointerToolBoss,			// tool type (boss of the default tool for this type)
	kDoesNotApply,				// parent tool boss
	kSixthAdobeToolsGroup,		// group number (good slot for third-party / SDK tools)
	kFirstAdobeTool,			// tool number within the group
	kDoesNotApply,				// subtool number
	kKCMToolActionID,			// action ID associated with the tool-select shortcut
	kKCMToolIconResID,		// icon resource ID (dedicated tool icon)
	kKCMUIPluginID,				// plug-in ID
	kADBEIconSuiteButtonType
};


/*
 * The cat-paw stamp tool (2026-09-04).
 *
 * ★★THE THIRD VALUE IS WHAT MAKES IT A SUBTOOL. Naming kKCMToolBoss as the parent tool puts
 *   this tool inside that tool's PRESS-AND-HOLD FLYOUT and spends **no toolbox slot** -- the
 *   toolbox is a scarce, shared surface, so a second slot for a companion of an existing tool
 *   would be the wrong thing to take. With a parent named, the group and tool numbers are
 *   ignored and the SUBTOOL number becomes the order within the flyout
 *   (ToolRecord.h:49,54,59-61,65).
 * ★The SDK's only worked example is wavetool/WavTl.fr:264-276 (its sine tool sits under its saw
 *   tool); this follows it value for value.
 * kKCMPawToolActionID is the tool-select shortcut action -- as for the tool above, no ActionDef
 * is needed, because the toolbox framework supplies a tool's own selection action.
 */
resource ToolDef (kKCMPawToolIconResID)
{
	kKCMPawToolBoss,			// classID for the tool boss
	kPointerToolBoss,			// tool type = the exclusion group (the same one the KCM tool uses)
	kKCMToolBoss,				// ★parent tool boss -> this tool lives in THAT tool's flyout
	kDoesNotApply,				// group number (ignored while a parent is named)
	kDoesNotApply,				// tool number (ignored likewise)
	kFirstAdobeTool,			// subtool number = the order inside the flyout
	kKCMPawToolActionID,		// action ID associated with the tool-select shortcut
	kKCMPawToolIconResID,		// icon resource ID
	kKCMUIPluginID,				// plug-in ID
	kADBEIconSuiteButtonType
};


/*
 * Locale Indicies.
 * The LocaleIndex should have indicies that point at your
 * localizations for each language system that you are localized for.
 */

/*  
 * String LocaleIndex.
 */
// ★★**ONE ROW, AND THAT IS NOT A SHORTCUT** (2026-08-29). Fourteen rows stood here and **all
//   fourteen pointed at the same table**: there is only one, the jaJP table having been retired
//   on 2026-08-05 (Japanese is switched in at run time by KCMLoc.h). The full account is at the
//   model half's String LocaleIndex in KCM.fr, which was cut to one row on 2026-08-15 -- ★★**this
//   half was simply left behind for two weeks**, the same way KCMUI.rc was left without the code
//   page pragma.
//   ⚠**The k_Wild row is the one that must never go**: a row is a MATCH, not a default
//     (LocaleIndex.h:124-134), and a UI language that matches nothing draws every key RAW.
resource LocaleIndex ( kSDKDefStringsResourceID)
{
	kStringTableRsrcType,
	{
		kWildFS, k_Wild, kSDKDefStringsResourceID + index_enUS
	}
};

resource LocaleIndex (kSDKDefStringsNoTransResourceID)
{
	kStringTableRsrcType,
	{
		kWildFS, k_Wild, kSDKDefStringsNoTransResourceID + index_enUS
	}
};

// Strings not being localized
resource StringTable (kSDKDefStringsNoTransResourceID + index_enUS)
{
	k_enUS,									// Locale Id
	kEuropeanMacToWinEncodingConverter,		// Character encoding converter
	{
		// Internal popup (flyout) menu name - not translated.
		kKCMInternalPopupMenuNameKey,	kKCMInternalPopupMenuNameKey,
	}
};
//========================================================================================
// (Scripting API removed: KCM no longer exposes any script methods. The flyout item
// "About Scripting" that used to say so was also removed on 2026-07-25.)
//========================================================================================


//========================================================================================
// ChangeMarker control panel (palette)
//========================================================================================

// PNG icons (compiled into the plug-in; ON = armed/comparing, OFF = idle). Same art is used for
// the normal and rollover states since this is a non-interactive status icon.
resource PNGA(kKCMIconOnResID)  "KCM_On32.png"
resource PNGR(kKCMIconOnResID)  "KCM_On32.png"
resource PNGA(kKCMIconOffResID) "KCM_Off32.png"
resource PNGR(kKCMIconOffResID) "KCM_Off32.png"

// Small dock-tab icon shown when the panel is collapsed to its smallest. Replace
// KohakuChangeMarkerTab.png with your own artwork (a small, e.g. ~20x20, transparent PNG).
resource PNGA(kKCMPaletteIconResID) "KohakuChangeMarkerTab.png"

// The KCM toolbox icon (artwork supplied by the user). Normal = 32x32, HiDPI (2x) = 64x64.
// There is no dark version, so PNGAD points at the same light artwork. Windows 1.5x reuses the
// normal 32x32 rather than a third image (the wavetool sample does the same).
resource PNGA(kKCMToolIconResID)  "KCM_Tool_32.png"
resource PNGAD(kKCMToolIconResID) "KCM_Tool_32.png"	// no dark version: the light artwork is reused
resource PNGA(kKCMToolIconResID + kHIDPIIconOffset)  "KCM_Tool_64.png"
resource PNGAD(kKCMToolIconResID + kHIDPIIconOffset) "KCM_Tool_64.png"	// no dark version: the light artwork is reused
#ifdef WINDOWS
resource PNGA(kKCMToolIconResID + kHIDPIIconOffset150)  "KCM_Tool_32.png"
resource PNGAD(kKCMToolIconResID + kHIDPIIconOffset150) "KCM_Tool_32.png"
#endif

// The cat-paw stamp tool's icon, drawn by work/kcm-make-paw-icons.ps1 from the very table the
// drawing side uses for the paw itself. Same specification as the icon above: 32x22 normal, 64x44 for
// HiDPI, no dark version (PNGAD points at the light artwork), and Windows 1.5x reuses the
// normal one.
// ⚠No PNGR / PNGRD here, unlike the tool above. Those exist only because the PANEL carries a
//   rollover button showing the KCM tool's artwork; this tool has no panel button, and the
//   toolbox slot itself reads PNGA / PNGAD alone.
resource PNGA(kKCMPawToolIconResID)  "KCM_PawTool_32.png"
resource PNGAD(kKCMPawToolIconResID) "KCM_PawTool_32.png"	// no dark version: the light artwork is reused
resource PNGA(kKCMPawToolIconResID + kHIDPIIconOffset)  "KCM_PawTool_64.png"
resource PNGAD(kKCMPawToolIconResID + kHIDPIIconOffset) "KCM_PawTool_64.png"
#ifdef WINDOWS
resource PNGA(kKCMPawToolIconResID + kHIDPIIconOffset150)  "KCM_PawTool_32.png"
resource PNGAD(kKCMPawToolIconResID + kHIDPIIconOffset150) "KCM_PawTool_32.png"
#endif
// ★The rollover forms exist because **the tool switch button inside the panel**
//   (kKCMToolButtonWidgetID) shows the same artwork. A RollOverIconButtonWidget asks for PNGR
//   while the pointer is over it, so with PNGA alone the picture vanishes on hover. As with the
//   cat illustration above there is no reason for the two states to differ, so the normal
//   artwork is reused. The toolbox's own tool slot reads PNGA / PNGAD only, so adding these
//   changes nothing there.
resource PNGR(kKCMToolIconResID)  "KCM_Tool_32.png"
resource PNGRD(kKCMToolIconResID) "KCM_Tool_32.png"	// no dark version: the light artwork is reused
resource PNGR(kKCMToolIconResID + kHIDPIIconOffset)  "KCM_Tool_64.png"
resource PNGRD(kKCMToolIconResID + kHIDPIIconOffset) "KCM_Tool_64.png"
#ifdef WINDOWS
resource PNGR(kKCMToolIconResID + kHIDPIIconOffset150)  "KCM_Tool_32.png"
resource PNGRD(kKCMToolIconResID + kHIDPIIconOffset150) "KCM_Tool_32.png"
#endif

// ✓ tool cursor. {X, Y} = the checkmark's vertex (folding point) in 1x logical pixels, which must
// match the vertex (10,18) drawn by KCMDrawCheckGlyph so the click point sits on the vertex.
// ★The image is a **PNG resource**, not a callback-drawn bitmap (KCMCheckCursorBitmapProc).
//   The intermittent "rubbish" that showed on press came from the base
//   CTracker::BeginTracking re-installing the check cursor (its modal cursor fetch), which ran
//   the drawing callback again. A resource draws into no buffer when it is re-installed, so
//   the source of it is gone. The artwork is generated with the same geometry as
//   KCMCheckGlyph.h (see the script under work/).
//   1x = 32x32 / 2x = +kHIDPICrsrOffset (3000) / Windows 1.5x = +kHIDPI150CrsrOffset (4000).
//   Modelled on sdksamples/snapshot.
resource PNGC(kKCMCheckCursorResID) "KCM_Check_10_18.png"
resource PNGC(kKCMCheckCursorResID + kHIDPICrsrOffset) "KCM_Check_10_18@2x.png"
#ifdef WINDOWS
resource PNGC(kKCMCheckCursorResID + kHIDPI150CrsrOffset) "KCM_Check_10_18@3to2x.png"
#endif
resource HOTC(kKCMCheckCursorResID) {10, 18};

// The cat-paw stamp tool's cursor: a pink paw with a dark rim, drawn by
// work/kcm-make-paw-icons.ps1 from the same five outlines the stamp itself is drawn from.
// ★The hot spot is the paw's CENTRE (10,10), not a corner -- the paw is placed centred on the
//   point pressed, so the cursor has to sit where the paw will land. (The check cursor's (10,18)
//   is its vertex, because that is what a tick points with.)
resource PNGC(kKCMPawCursorResID) "KCM_PawCursor_10_10.png"
resource PNGC(kKCMPawCursorResID + kHIDPICrsrOffset) "KCM_PawCursor_10_10@2x.png"
#ifdef WINDOWS
resource PNGC(kKCMPawCursorResID + kHIDPI150CrsrOffset) "KCM_PawCursor_10_10@3to2x.png"
#endif
resource HOTC(kKCMPawCursorResID) {10, 10};

// Hotspot of the CMYK readout cursor (Alt + left = "compare colour"). The same vertex (10,18) as
// the check mark, so it sits on the click point. Its CursorID is kept separate from the check
// cursor's: sharing one made the cursor cache confuse the 24x24 check with the 150x60 readout,
// and rubbish showed for one frame (see KCMUIID.h).
resource HOTC(kKCMCmykCursorResID) {10, 18};

// The second ID, alternated with the one above. While dragging, the numbers are updated by
// re-installing a kFalse cursor spec, and 1021 / 1022 are used in turn so that re-installing the
// same spec is never taken as a no-op (KCMTracker.cpp, InstallCmykCursor). Same hotspot.
resource HOTC(kKCMCmykCursor2ResID) {10, 18};

// The inactive form of the check cursor (outlined: black edge, white body). Same vertex (10,18)
// as the black one, so switching does not move the pointer. It is shown **while the comparison
// is stopped, or while the pointer is not over a layout view**.
// ★The rule lives in KCMToolCursorShouldBeBlack, **which is defined in KCMCmykCursor.cpp**;
//   KCMCursorProvider.cpp is the caller.
// ⚠This comment described a rule that had been withdrawn: "black only while Started AND with the
//   pointer over the Target document". The rule since then is **black over any document while
//   Started** (a third document included -- black says "the comparison is running").
//   **The code was corrected the day the rule changed; this resource comment was not.**
// A PNG resource as well, for the reason given for the black one above.
resource PNGC(kKCMCheckCursorInactiveResID) "KCM_CheckOff_10_18.png"
resource PNGC(kKCMCheckCursorInactiveResID + kHIDPICrsrOffset) "KCM_CheckOff_10_18@2x.png"
#ifdef WINDOWS
resource PNGC(kKCMCheckCursorInactiveResID + kHIDPI150CrsrOffset) "KCM_CheckOff_10_18@3to2x.png"
#endif
resource HOTC(kKCMCheckCursorInactiveResID) {10, 18};

// Panel LocaleIndex - a single (string-key driven) view is used for every locale; the labels
// themselves come from the enUS string table (KCMUI_enUS.fr - the table moved here whole with the
// split on 2026-08-15; this line still said "KCM_enUS.fr" until 2026-08-18, bug recheck B-U1).
// Japanese is switched in at run time by KCMLoc.h - the jaJP string table was retired on 2026-08-05.
resource LocaleIndex (kSDKDefPanelResourceID)
{
	kViewRsrcType,
	{
		kWildFS, k_Wild, kSDKDefPanelResourceID + index_enUS
	}
};

// Type definition for the panel widget boss.
type KCMPanelWidget(kViewRsrcType) : PalettePanelWidget(ClassID = kKCMPanelWidgetBoss)
{
	CPanelMenuData;
};

// Panel illustration (ON/OFF icon) widget type: same as RollOverIconButtonWidget, but backed by
// kKCMIconWidgetBoss so it carries IID_ITIP (tooltip showing the repo URL on hover).
type KCMIconWidget(kViewRsrcType) : RollOverIconButtonWidget(ClassID = kKCMIconWidgetBoss) { };

// Scroll-map strip widget type (custom-drawn; injected at runtime by KCMScrollMap.cpp).
type KCMScrollMapWidget(kViewRsrcType) : GenericPanelWidget(ClassID = kKCMScrollMapWidgetBoss) { };

// "Story Edits" section toggle: a rollover icon button backed by kKCMStorySectionToggleBoss so it
// carries IID_IOBSERVER. It draws no artwork of its own - the resource it points at is the stock
// disclosure triangle owned by the application (kTreeBranchCollapsedRsrcID / ...ExpandedRsrcID),
// the same pair the Links panel uses for its Link Info toggle.
type KCMStorySectionToggleWidget(kViewRsrcType) : RollOverIconButtonWidget(ClassID = kKCMStorySectionToggleBoss) { };

// "Story Edits" section body (the splitter's lower pane): a generic panel that additionally carries
// one persistent integer, the height it had when it was last closed. Same construction as the Links
// panel's kLinkInfoPanelWidgetBoss, which holds its IID_ISAVEDINFOPANESIZE the same way
// (LinksUIViews.fr:45 for the type, LinksUIClass.fr:91 for the interface).
type KCMStorySectionPanelWidget(kViewRsrcType) : GenericPanelWidget(ClassID = kKCMStorySectionPanelBoss) { };

// The splitter itself, backed by kKCMSplitterPanelBoss so that its divider cannot be dragged (see
// that Class above). ★The field list is SplitterPanelWidget's, unchanged - the resource below is
// byte for byte what it was, and the layout with it.
type KCMSplitterPanelWidget(kViewRsrcType) : SplitterPanelWidget(ClassID = kKCMSplitterPanelBoss) { };

// The "Story Edits" list itself.
type KCMStoryTreeWidget(kViewRsrcType) : TreeViewWidget(ClassID = kKCMStoryTreeWidgetBoss) { };

// One row of that list. ★PrimaryResourcePanelWidget is the point: the widget manager creates each
// row with CreateObjectNoInit (boss only) and calls DoPostCreate() afterwards to build the three
// cells inside it, which is the sequence that lets the palette theme be set in between.
type KCMStoryRowWidget(kViewRsrcType) : PrimaryResourcePanelWidget(ClassID = kKCMStoryRowWidgetBoss) { };

// One cell of that row: an InfoStaticText whose only difference is that it stays silent on hover
// (see kKCMStoryRowCellBoss above). The field list is InfoStaticTextWidget's, unchanged.
type KCMStoryRowCellWidget(kViewRsrcType) : InfoStaticTextWidget(ClassID = kKCMStoryRowCellBoss) { };

// The text cell of a CHANGE row: drawn by hand so that the changed characters can keep the theme's
// text colour while the context around them fades (see kKCMStoryChangeCellBoss above).
// ⚠The field list is GenericPanelWidget's, NOT the cell type above it: no alignment, no ellipsize
//  style, no font IDs - a hand-drawn cell decides all three itself (KCMStoryCellView.cpp), and
//  it ends with a child list rather than a text string.
type KCMStoryChangeCellWidget(kViewRsrcType) : GenericPanelWidget(ClassID = kKCMStoryChangeCellBoss) { };

// The panel's message area: drawn by hand for the same reason (see kKCMStatusTextWidgetBoss).
// ⚠The field list is GenericPanelWidget's, NOT StaticMultiLineTextWidget's - gone from the line
//  that uses it are the alignment, the ellipsize style, the ampersand flag, the font ID, the LINE
//  COUNT and the initial string. The drawing code decides all of them, and the line count is now
//  the box's own height rather than a number that can disagree with it (KCMStatusTextView.cpp).
type KCMStatusTextWidget(kViewRsrcType) : GenericPanelWidget(ClassID = kKCMStatusTextWidgetBoss) { };

// The book comparison dialog (2026-08-11). "DialogBoss" is the exotic name of what is really a
// widget type - the basicdialog shape, WidgetEveInfo and all. Same form as KESCL's Jump Offset
// dialog (KESCL.fr:953), which is the closest working example: a fixed-size dialog by the same
// author. ⚠ The WidgetEveInfo line is required; without it the resource below will not parse.
type KCMBookDialogWidget(kViewRsrcType) : DialogBoss(ClassID = kKCMBookDialogBoss)
{
	WidgetEveInfo;
};

// The chapter list inside that dialog. ★WidgetEveInfo, unlike the panel's tree: this one lives
// among EVE children, so it has to carry the trailing EVE flag they all carry. Both official
// examples of a tree in an EVE dialog declare their tree type exactly this way - the product's
// linksui (LinksUIViews.fr:95, "EVETreeViewWidget") and the SDK's basicselectabledialog
// (BscSlDlg.fr:373).
type KCMBookTreeWidget(kViewRsrcType) : TreeViewWidget(ClassID = kKCMBookTreeWidgetBoss)
{
	WidgetEveInfo;
};

// One row of that list - same construction as the panel's row (PrimaryResourcePanelWidget so that
// the manager can create the boss first, set the theme, and only then build the cells).
type KCMBookRowWidget(kViewRsrcType) : PrimaryResourcePanelWidget(ClassID = kKCMBookRowWidgetBoss) { };

// One cell of that row: an InfoStaticText that stays silent on hover (see kKCMBookRowCellBoss).
// The field list is InfoStaticTextWidget's, unchanged. ⚠ No WidgetEveInfo: the cells are children
// of the row, not of the dialog, and the row is built outside EVE.
type KCMBookRowCellWidget(kViewRsrcType) : InfoStaticTextWidget(ClassID = kKCMBookRowCellBoss) { };

// The dialog's Target:/Source: lines. Field for field an EVEStaticTextWidget - only the boss differs,
// and with it the answer EVE gets when it asks how wide this widget wants to be (see
// kKCMBookPathTextWidgetBoss: the frame becomes the size instead of the minimum).
type KCMBookPathTextWidget(kViewRsrcType) : EVEStaticTextWidget(ClassID = kKCMBookPathTextWidgetBoss) { };

// Scroll-map strip view resource: instantiated with ::CreateObject2<IControlView>(db, RsrcSpec(...,
// kViewRsrcType, kKCMScrollMapRsrcID)) — same runtime-creation pattern as linksui's dynamic info
// widgets, in the typed form the widget bin itself uses (CTreeViewWidgetMgr::CreateWidgetForNode).
// The Frame here is a placeholder; the real frame/binding are assigned right after AddWidget from
// the live scrollbar geometry.
// Corrected on 2026-08-19 (bug re-check B-U8): the C++ moved to the typed CreateObject2 -- which
// takes no IID -- on 2026-08-17, yet this description of that very call still spelled the old
// ::CreateObject(..., IID_ICONTROLVIEW). The same stale wording sat in KCMUIID.h beside
// kKCMScrollMapRsrcID: when an implementation changes, the resource and the ID header that
// describe it are siblings, and a grep for the old call spelling finds both at once.
resource LocaleIndex (kKCMScrollMapRsrcID)
{
	kViewRsrcType,
	{
		kWildFS, k_Wild, kKCMScrollMapRsrcID + index_enUS
	}
};

// The book comparison dialog's view (2026-08-11). Not localised as a view: the strings it shows
// come from the string table, like every other KCM label.
resource LocaleIndex (kKCMBookDialogRsrcID)
{
	kViewRsrcType,
	{
		kWildFS, k_Wild, kKCMBookDialogRsrcID + index_enUS
	}
};

resource KCMScrollMapWidget(kKCMScrollMapRsrcID + index_enUS)
{
	kKCMScrollMapWidgetID,		// WidgetId
	kPMRsrcID_None,					// RsrcId
	kBindNone,						// Frame binding (placeholder; set at runtime)
	Frame(0, 0, 5, 100)				// Frame (placeholder; set at runtime)
	kTrue, kTrue,					// Visible, Enabled
	"",								// Panel name (none)
	{
	}
};

// One row of the "Story Edits" list, created at runtime by KCMStoryTreeWidgetMgr. ★The
// LocaleIndex wrapper is required, not decoration: the widget manager asks for the row with
// RsrcSpec(LocaleSetting::GetLocale(), ...), so the base ID has to resolve through a locale table
// before it finds a body. The row carries no localized strings of its own - both cells are stamped
// at runtime - so one wild locale row is the whole table.
resource LocaleIndex (kKCMStoryRowRsrcID)
{
	kViewRsrcType,
	{
		kWildFS, k_Wild, kKCMStoryRowRsrcID + index_enUS
	}
};

resource KCMStoryRowWidget(kKCMStoryRowRsrcID + index_enUS)
{
	__FILE__, __LINE__,
	kKCMStoryRowWidgetID, kPMRsrcID_None,	// WidgetId, RsrcId
	kBindLeft | kBindRight,				// Frame binding: follow the list's width
	Frame(0, 0, 224, kKCMStoryRowHeight),	// Frame (left, top, right, bottom)
	kTrue, kTrue,						// Visible, Enabled
	"",									// Panel name
	{
		// ★★THE EXPAND / COLLAPSE ARROW (user's request: "next to the UID, an expander that opens and
		//   closes, like the tree in KBS"). Stock part - the tree framework owns
		//   its clicks and swaps the collapsed / expanded icon itself. Field for field the same as
		//   KBS's (KBS.fr:1220) and paneltreeview's.
		// ★It is HIDDEN on a row with no children, by CTreeViewWidgetMgr::HideExpanderIfNotExpandable
		//   - which the widget manager calls, and which finds this widget by its stock WidgetID. In
		//   the pixel mode no row has children, so no arrow is ever drawn there.
		// ⚠The 16px it occupies is taken whether or not an arrow is drawn: the cells after it start
		//   16px further right than they did before 2026-08-20. That shift is the visible cost of
		//   having an arrow at all, and it applies to both modes.
		TreeExpanderWidget
		(
			kTreeNodeExpanderWidgetID,		// WidgetId (stock - the base class looks for exactly this)
			kTreeBranchCollapsedRsrcID,		// RsrcId for collapsed node icon
			kApplicationRsrcPluginID,		// RsrcPlugin for collapsed node icon
			kBindNone,						// Frame binding
			Frame(4, 1, 20, kKCMStoryRowHeight - 2),	// Frame
			kTrue, kTrue,					// Visible, Enabled
			kTreeBranchExpandedRsrcID,		// RsrcId for expanded node icon
			kApplicationRsrcPluginID,		// RsrcPlugin for expanded node icon
			kTrue,							// Cmd-Click expands/collapses children
			kFalse,							// Scroll to show children when expanded
			kIconNoCentering,
			kIconRaisedLook,				// Icon look
			kFalse							// Draws a well
		),

		// ★Left: the story's UID, in decimal (user's request, 2026-08-10: "UID, text, what changed").
		//   It is the one thing on the row that is certainly unique - two stories can open with the
		//   same words, and the kind column repeats by design. ★kBindLeft only: a fixed column at the
		//   left edge, so widening the panel gives the space to the text cell rather than to a number
		//   that is never more than a few digits wide.
		KCMStoryRowCellWidget
		(
			kKCMStoryRowUIDWidgetID,		// WidgetId
			kPMRsrcID_None,					// RsrcId
			kBindLeft,						// Frame binding: stay at the row's left edge
			// ★8 -> 24 on 2026-08-20: the expander above now holds the row's left edge.
			Frame(24, 1, 64, kKCMStoryRowHeight - 2),	// Frame (40px = room for 5-6 digits at the palette font)
			kTrue, kTrue,					// Visible, Enabled
			kAlignLeft,						// Alignment
			kDontEllipsize, kFalse,			// Ellipsize style, Convert ampersands
			"",								// Text Control Data
			0,								// WidgetId for associated control for shortcut focus
			kPaletteWindowSystemScriptFontId, kPaletteWindowSystemScriptFontId,
		),

		// Middle: the story's opening words. Ellipsized in the MIDDLE, the way this panel's
		// Target / Source lines treat a document name - the start and the end both survive.
		// ★Convert ampersands = kFalse. This cell shows text taken out of the document, and a lone
		//   '&' in it is not an accelerator: "Q&A" has to read as "Q&A" (memory
		//   ampersand-eaten-in-ui-strings). KBS's rows set kTrue instead, because on that side C++
		//   doubles the ampersands up first (InsertAmpersandForDisplay); KCM does not, so the
		//   conversion is turned off here rather than compensated for there.
		// ★KCMStoryRowCellWidget, not the plain InfoStaticTextWidget: the only difference is that
		//   it does not pop the full text up on hover (see kKCMStoryRowCellBoss).
		KCMStoryRowCellWidget
		(
			kKCMStoryRowTextWidgetID,		// WidgetId
			kPMRsrcID_None,					// RsrcId
			kBindLeft | kBindRight,			// Frame binding: take the space the kind cell leaves
			// ★Left inset 8, the same margin the rest of the panel uses (user's call, 2026-08-10:
			//   "make the padding at the bottom the same as at the top"). Target / Source
			//   (Frame(8, ...)), the status block (Frame(8, 76, ...)) and the tool button
			//   (Frame(8, 48, ...)) are all 8; the list alone sat at 4 and read as cramped.
			//   ★Right edge 158 -> 154: the 4px comes off this cell so the kind column keeps its
			//   width (see its comment below).
			//   ★★Left edge 8 -> 52 (2026-08-10): the UID column above now holds the row's left
			//     margin, and this cell starts 4px after it. This is the cell that gives way - it is
			//     the only one that grows when the panel is widened.
			// ★52 -> 68 on 2026-08-20, the same 16px the UID cell moved: the expander took the left edge.
			Frame(68, 1, 154, kKCMStoryRowHeight - 2),	// Frame
			kTrue, kTrue,					// Visible, Enabled
			kAlignLeft,						// Alignment
			kEllipsizeMiddle, kFalse,		// Ellipsize style, Convert ampersands
			"",								// Text Control Data
			0,								// WidgetId for associated control for shortcut focus
			kPaletteWindowSystemScriptFontId, kPaletteWindowSystemScriptFontId,
		),

		// Right: which kinds of change moved. A fixed column, so the words line up down the list
		// and it is the story text that gives way when the panel is narrow.
		KCMStoryRowCellWidget
		(
			kKCMStoryRowKindWidgetID,		// WidgetId
			kPMRsrcID_None,					// RsrcId
			kBindRight,						// Frame binding: stay at the row's right edge
			// ★Right inset 8 (220 -> 216), matching the panel's other right edges: Target / Source
			//   end at 216, so do Next and both cat illustrations. ★The left edge moves with it
			//   (158 -> 154) so this column stays 62px wide - two words ("Text Attr") have to fit,
			//   and kDontEllipsize means anything wider is simply clipped.
			Frame(154, 1, 216, kKCMStoryRowHeight - 2),	// Frame
			kTrue, kTrue,					// Visible, Enabled
			kAlignRight,					// Alignment
			kDontEllipsize, kFalse,			// Ellipsize style, Convert ampersands
			"",								// Text Control Data
			0,								// WidgetId for associated control for shortcut focus
			kPaletteWindowSystemScriptFontId, kPaletteWindowSystemScriptFontId,
		),
	}
};

// ---------------------------------------------------------------------------------------
// One CHANGE row of the Story Edits list - the second level, added 2026-08-20 with the Story
// Changes mode. It hangs under a story row and names one difference found inside that story.
//
// ★★★THIS RESOURCE *IS* THE INDENT. The cells start further right than the story row's, and that
// is the whole of the hierarchy's visual offset - nothing moves them at runtime. The reason is in
// KCMStoryTreeWidgetMgr::ApplyIndentToWidget: row widgets are recycled, so an indent applied as
// "move right by N" accumulates every time the row is scrolled back into view, and the absolute
// form the base class uses needs fBaseIndentOffset, which is 0 in this manager.
// ⇒ Two levels, two resources. ⚠A THIRD level cannot be done this way.
//
// ★Same three-cell shape as the story row, on purpose: the two rows then behave identically under
// every part of the framework that walks cells, and only the numbers differ.
// ★Same cell WidgetIDs as the story row, too (48 / 52 / 49). A widget ID has to be unique only
// among one parent's descendants, and these rows are never each other's descendants - the book
// dialog's row already shares the same three.
// ---------------------------------------------------------------------------------------
resource LocaleIndex (kKCMStoryChangeRowRsrcID)
{
	kViewRsrcType,
	{
		kWildFS, k_Wild, kKCMStoryChangeRowRsrcID + index_enUS
	}
};

resource KCMStoryRowWidget(kKCMStoryChangeRowRsrcID + index_enUS)
{
	__FILE__, __LINE__,
	kKCMStoryChangeRowWidgetID, kPMRsrcID_None,	// WidgetId (★NOT the story row's - see KCMUIID.h)
	kBindLeft | kBindRight,				// Frame binding: follow the list's width
	Frame(0, 0, 224, kKCMStoryRowHeight),	// Frame (left, top, right, bottom)
	kTrue, kTrue,						// Visible, Enabled
	"",									// Panel name
	{
		// ★★★TWO CELLS, NOT THREE, SINCE 2026-08-20 (user's call). The sign that says what sort of
		//   edit this was used to sit HERE, in front of the text, in the column the story row uses
		//   for its UID. It now sits in the RIGHT-HAND column instead, so that the two levels put
		//   the same kind of answer in the same place: the story row's right-hand cell names what
		//   changed in that story ("Text+"), and the change row's names what this one edit was
		//   ("+" / "-" / "≠"). ⇒ The left column belongs to the UID alone, and the text starts
		//   where the sign used to.
		//   ⚠The note above this resource said the two shapes match cell for cell. They no longer
		//     do, and nothing needed them to - the framework walks each row's own cell list.
		//
		// Left: the words the edit concerns. ★For a deletion this is what was REMOVED (the model
		// chose which side - KCMStoryList.h); for everything else it is the new text.
		//
		// ★★★IT STARTS WHERE THE STORY ROW'S TEXT STARTS - 68, THE SAME NUMBER (user's call: "let a
		//   child's text begin where its parent's text begins"). It went 84 ->
		//   40 -> 68 in one afternoon, and the last move is the one to keep: the two levels read as
		//   one column of text, and a change reads directly under the story it belongs to.
		//   ⇒ ★THE INDENT IS NOT IN THE TEXT ANY MORE. What says "this row hangs under that one" is
		//     the expander in front of the story row and the blank where a change row's would be -
		//     the 24px column at the left that only a story row fills. Nothing needs the text to
		//     say it a second time, and saying it cost the cell 28px of the little width it has.
		// ⚠A change row has NO expander of its own - it is a leaf.
		//
		// ★★DRAWN BY HAND, WHERE THE STORY ROW'S IS A STOCK STATIC TEXT (2026-08-20). The changed
		//   characters keep the theme's text colour and the context on either side of them is faded
		//   toward the panel's background, which one static text cannot do - it has one colour for
		//   its whole string (user's request: "everything but the changed part in a lighter colour,
		//   follow KBS").
		//   ⚠The three cells are therefore NO LONGER the same widget type on the two rows. Everything
		//     that matters stays the same: the same WidgetID, the same frame, the same font (named in
		//     KCMStoryCellView.cpp, since a generic panel carries no font field). What is gone from
		//     this line is what the drawing code now decides: alignment (always left), the ellipsize
		//     style (kEllipsizeMiddle would cut away the change itself - the middle is exactly where
		//     it is) and the ampersand conversion (kFalse either way; this is document text).
		KCMStoryChangeCellWidget
		(
			kKCMStoryRowTextWidgetID,		// WidgetId (reused)
			kPMRsrcID_None,					// RsrcId
			kBindLeft | kBindRight,			// Frame binding: this is the cell that grows
			Frame(68, 1, 176, kKCMStoryRowHeight - 2),	// Frame (84 -> 68 = the story row's text cell;
															// right edge 154 -> 176, see the sign's cell below)
			kTrue, kTrue,					// Visible, Enabled
			"",								// Panel name (none)
			{
			}
		),

		// Right: WHAT SORT of edit, as one sign - "+" inserted, "-" deleted, "≠" replaced ("it is
		// not equal any more" - user's call, 2026-08-20).
		// ★A sign rather than a word: this column is being scanned down, not read, and a sign needs
		//   no translation. (The story row's right-hand column names its kinds in WORDS because
		//   there the words ARE the answer, and there is one per story rather than one per edit.)
		// ★★It moved here from the left on 2026-08-20 - see the note at the top of this list.
		//   ⚠It is 40px wide where the story row's kind column is 62: a sign needs no more, and the
		//     40 goes to the text cell, which is the one that runs out of room. The two columns
		//     still END at the same place (216), so the signs line up under "Text+" rather than
		//     starting under it.
		// ★This is also where an attribute difference will name what changed when that arrives
		//   (KCMStoryList.h's fWhat) - it will be a word there, beside these signs.
		KCMStoryRowCellWidget
		(
			kKCMStoryRowKindWidgetID,		// WidgetId (reused)
			kPMRsrcID_None,					// RsrcId
			kBindRight,						// Frame binding: stay at the row's right edge
			Frame(176, 1, 216, kKCMStoryRowHeight - 2),	// Frame (154 -> 176: the text cell took it)
			kTrue, kTrue,					// Visible, Enabled
			kAlignRight,					// Alignment
			kDontEllipsize, kFalse,			// Ellipsize style, Convert ampersands
			"",								// Text Control Data
			0,								// WidgetId for associated control for shortcut focus
			kPaletteWindowSystemScriptFontId, kPaletteWindowSystemScriptFontId,
		),
	}
};

// ---------------------------------------------------------------------------------------
// ★★A RUBY CHANGE ROW - the same row as above, on two lines (2026-08-22).
//
// Ruby is set ABOVE the characters it belongs to, and the user asked for it to look like that
// rather than like a second column of text ("it need not be small - the same character size,
// placed above the kanji, the way real ruby is" / "the position is what matters"). At the
// palette font's own size that needs two
// lines, so this row is twice as tall and KCMStoryCellView splits its text cell in half.
//
// ★WHY A THIRD RESOURCE RATHER THAN A TALLER SECOND ONE. Only ruby rows are tall; an ordinary text
// change is still one line, and so is every row of the pixel mode. The framework decides which
// widget to build from GetWidgetTypeForNode, so the two kinds have to answer different WidgetIDs
// or a tall widget gets recycled onto a short row (KCMUIID.h at kKCMStoryRubyRowWidgetID).
//
// ★WHAT IS THE SAME AS 1014, DELIBERATELY: the cell boss, the cell WidgetIDs and the columns. The
// only differences are heights - which is what keeps "how a change row is filled in" one piece of
// code (KCMStoryTreeWidgetMgr::ApplyChangeRow) rather than two that have to be kept in step.
// ---------------------------------------------------------------------------------------
resource LocaleIndex (kKCMStoryRubyRowRsrcID)
{
	kViewRsrcType,
	{
		kWildFS, k_Wild, kKCMStoryRubyRowRsrcID + index_enUS
	}
};

resource KCMStoryRowWidget(kKCMStoryRubyRowRsrcID + index_enUS)
{
	__FILE__, __LINE__,
	kKCMStoryRubyRowWidgetID, kPMRsrcID_None,	// WidgetId (★NOT the plain change row's - see above)
	kBindLeft | kBindRight,				// Frame binding: follow the list's width
	Frame(0, 0, 224, kKCMStoryRubyRowHeight),	// Frame (left, top, right, bottom)
	kTrue, kTrue,						// Visible, Enabled
	"",									// Panel name
	{
		// Left: the base characters on the LOWER line and the reading on the upper one. The cell
		// takes the WHOLE height and divides it itself - it is the only thing here that knows the
		// two lines exist, and it has to, because the reading is centred over the changed
		// characters and where those land is not known until the line has been laid out.
		KCMStoryChangeCellWidget
		(
			kKCMStoryRowTextWidgetID,		// WidgetId (reused - see 1014)
			kPMRsrcID_None,					// RsrcId
			kBindLeft | kBindRight,			// Frame binding: this is the cell that grows
			Frame(68, 1, 176, kKCMStoryRubyRowHeight - 2),	// Frame (the full two lines)
			kTrue, kTrue,					// Visible, Enabled
			"",								// Panel name (none)
			{
			}
		),

		// Right: the sign, ON THE LOWER LINE with the base text rather than centred in the row.
		// ★A stock static text centres itself in its own frame, so the frame is the lower half.
		//   Centred in the WHOLE row it would land exactly on the boundary between the two lines,
		//   reading as if it belonged to neither.
		// ⚠The upper half's height is written as half the row's, not as kKCMStoryRowHeight: the
		//   two happen to be the same number today, and only one of them means "one line of this
		//   row" (see KCMUIID.h - 19 is "one line + 1px", 38 is "two lines + 2px").
		KCMStoryRowCellWidget
		(
			kKCMStoryRowKindWidgetID,		// WidgetId (reused)
			kPMRsrcID_None,					// RsrcId
			kBindRight,						// Frame binding: stay at the row's right edge
			Frame(176, kKCMStoryRubyRowHeight / 2, 216, kKCMStoryRubyRowHeight - 2),	// Frame (lower line)
			kTrue, kTrue,					// Visible, Enabled
			kAlignRight,					// Alignment
			kDontEllipsize, kFalse,			// Ellipsize style, Convert ampersands
			"",								// Text Control Data
			0,								// WidgetId for associated control for shortcut focus
			kPaletteWindowSystemScriptFontId, kPaletteWindowSystemScriptFontId,
		),
	}
};

// One row of the book comparison dialog's chapter list, created at runtime by
// KCMBookTreeWidgetMgr. Same construction as the Story Edits row above - including the
// LocaleIndex wrapper, which is required rather than decorative: the widget manager asks for the
// row with RsrcSpec(LocaleSetting::GetLocale(), ...), so the base ID has to resolve through a
// locale table before it finds a body. Both cells are stamped at runtime, so one wild locale row
// is the whole table.
resource LocaleIndex (kKCMBookRowRsrcID)
{
	kViewRsrcType,
	{
		kWildFS, k_Wild, kKCMBookRowRsrcID + index_enUS
	}
};

resource KCMBookRowWidget(kKCMBookRowRsrcID + index_enUS)
{
	__FILE__, __LINE__,
	kKCMBookRowWidgetID, kPMRsrcID_None,	// WidgetId, RsrcId
	kBindLeft | kBindRight,				// Frame binding: follow the list's width
	// 364 to match the list it sits in (2026-08-13). ★The binding above means this is only a starting
	// size - the row is stretched to the list's real width - but a template whose numbers disagree
	// with the list's is a trap for whoever reads the cell frames below and works out the insets
	// from them.
	Frame(0, 0, 364, kKCMBookRowHeight),	// Frame (left, top, right, bottom)
	kTrue, kTrue,						// Visible, Enabled
	"",									// Panel name
	{
		// Left: the chapter's file name, and for a chapter that could not be opened the reason
		// after it. ★Ellipsized in the MIDDLE so that both the start and the extension survive -
		// "ch01_final_v3.indd" and "ch01_final_v4.indd" differ near the end, and a chapter list
		// whose rows all read "ch01_fi..." would be unreadable.
		// ⚠★★THAT REASONING IS ABOUT A FILE NAME, AND THIS CELL DOES NOT ALWAYS HOLD ONLY ONE.
		//   On a Failed row the widget manager appends " - <reason>", and then the extension is no
		//   longer at the end - it is in the MIDDLE, which is the one place this style throws away.
		//   MEASURED 2026-08-19 (bug recheck B-U5, third pass) with a 43-character row:
		//       model : ch3.indd - could not be opened (missing)
		//       screen: ch3.ind...ould not be opened (missing)
		//   ⇒ the row named "ch3.ind", an extension that does not exist, and the reason was cut at
		//   both ends. ★THE FIX WENT IN THE REASONS, NOT HERE: they no longer repeat the verdict
		//   that the state column beside them already carries ("missing", not "could not be opened
		//   (missing)") - see KCMBookResult.h's fWhy. The ellipsis stays in the middle because for
		//   a file name it is still the right choice; what changed is that the strings now fit.
		//   ⚠So the width here is a BUDGET, not just a layout number: 230px is about 38 characters,
		//   and a file name plus a reason has to live inside it.
		// ★Convert ampersands = kFalse: a chapter called "A&B.indd" would otherwise display as
		//   "AB.indd" (memory ampersand-eaten-in-ui-strings).
		// ***** 11px IN FROM THE ROW'S EDGE, NOT 8. ***** (User, 2026-08-13: "the list part, another
		// 3px wider still".) ★This works only because ApplyIndentToWidget is overridden empty in
		// KCMBookTreeWidgetMgr.cpp (the override itself, named rather than numbered - ":129" was
		// nine lines short by 2026-08-18, having been pushed down by that file's OWN bug-recheck
		// corrections the same day) - a cell bound on BOTH sides has its .fr left edge thrown
		// away by the framework's version, which is what memory treeview-indent-overwrites-cell-frames
		// is about. Change that override and this number silently becomes 0.
		KCMBookRowCellWidget
		(
			kKCMBookRowNameWidgetID,		// WidgetId
			kPMRsrcID_None,					// RsrcId
			kBindLeft | kBindRight,			// Frame binding: this is the cell that gives way
			Frame(11, 1, 241, kKCMBookRowHeight - 2),	// Frame
			kTrue, kTrue,					// Visible, Enabled
			kAlignLeft,						// Alignment
			kEllipsizeMiddle, kFalse,		// Ellipsize style, Convert ampersands
			"",								// Text Control Data
			0,								// WidgetId for associated control for shortcut focus
			kDialogWindowSystemScriptFontId, kDialogWindowSystemScriptFontId,
		),

		// Right: the verdict. A fixed column so the words line up down the list, wide enough for
		// the longest of them ("ChapterDeleted") because kDontEllipsize means anything wider is
		// clipped without a sign that something is missing - the mistake the panel's kind column
		// made before it was narrowed to one word.
		KCMBookRowCellWidget
		(
			kKCMBookRowStateWidgetID,		// WidgetId
			kPMRsrcID_None,					// RsrcId
			kBindRight,						// Frame binding: stay at the row's right edge
			// ★Moved as a WHOLE rather than narrowed, every time the row changed width: 380→377 for
			//   the wider inset, then 377→347→197→241 as the dialog was resized. The right inset
			//   stays 11px, matching the left (364 - 11 = 353), and the column KEEPS ITS 112px
			//   throughout. Narrowing it instead would have clipped "ChapterDeleted" without a sign -
			//   see the note above.
			Frame(241, 1, 353, kKCMBookRowHeight - 2),	// Frame (112px)
			kTrue, kTrue,					// Visible, Enabled
			kAlignRight,					// Alignment
			kDontEllipsize, kFalse,			// Ellipsize style, Convert ampersands
			"",								// Text Control Data
			0,								// WidgetId for associated control for shortcut focus
			kDialogWindowSystemScriptFontId, kDialogWindowSystemScriptFontId,
		),
	}
};

// PanelList - registers the panel and makes it appear under the Window menu.
resource PanelList (kSDKDefPanelResourceID)
{
	{
		kSDKDefPanelResourceID,		// Resource ID for this panel
		kKCMUIPluginID,				// owning plug-in
		kIsResizable,				// ★Resizable, at the user's request (it used to be kNotResizable).
							//   The floor is kept by KCMPanelView::ConstrainDimensions: the width
							//   never goes below what used to be the fixed width, and while Story
							//   Edits is closed the height is pinned to the top pane's.
		kKCMPanelWidgetActionID,	// Action ID to show/hide the panel
		kKCMPanelWindowMenuName,	// Window > Kohaku Plug-Ins > Kohaku Change Marker. ★The colon
									// inside this key is what buys the sub-menu level (PanelList.fh
									// on this field).
		"",							// ★NO ALTERNATE MENU PATH (2026-08-27, the user's decision):
									// this panel lives on the Window menu alone, which is where
									// InDesign's own panels live and where people look for one.
									// It used to sit under Plug-Ins instead, and that was not a
									// preference - an empty panelName means NO Window entry at all,
									// so Plug-Ins was the only place left to put it.
		0.0,						// Alternate menu position - meaningless without a path.
		kKCMPaletteIconResID, kKCMUIPluginID,	// PNG icon for the collapsed dock tab
		c_Panel
	}
};

// PanelView - widget layout. Labels reference string keys so they localize automatically.
resource KCMPanelWidget(kSDKDefPanelResourceID + index_enUS)
{
	__FILE__, __LINE__,
	kKCMPanelWidgetID,			// WidgetID
	kPMRsrcID_None,					// RsrcID
	kBindNone,						// Binding
	0, 0, 224, 185,					// Frame: left, top, right, bottom.
									// ★The height includes the band at the bottom that carries the Story
									//   Edits expander and the cat illustration. **The band is 32px because
									//   a 20px one cannot hold the 32x32 artwork** -- that is what the last
									//   growth of this panel paid for, and the message area took the width
									//   the cat left behind (see kKCMStatusTextWidgetID below).
	kTrue, kTrue,					// Visible, Enabled
	kFalse,							// Erase background
	kInterfacePaletteFill,			// Erase to color
	kFalse,							// Draw dropshadow
	kKCMPanelTitleKey,			// Panel name
	{
	// ★2026-08-09: everything the panel used to hold now sits inside a SplitterPanelWidget, so that a
	//   "Story Edits" section can open below it. This is the structure the product's Links panel uses
	//   for its Link Info section (LinksUIViews_enUS.fr:43-68) - the feature this one is modelled on.
	//
	//   ★★THE WIDGETS BELOW ARE UNCHANGED - not one Frame moved. The top pane covers the whole panel
	//   (0,0,224,185 - the whole panel), so every coordinate inside it means what it always meant.
	//   Their indentation was
	//   deliberately left alone too, so the diff shows the nesting and nothing else.
	//
	//   Field order is CSplitterPanelControlData (Widgets.fh:403-431) - fourteen of them. The trailing
	//   IsSplitBarRecessed field is NOT written: it carries a default, and default-bearing fields fail
	//   to parse when spelled out. linksui leaves it out for the same reason.
	// ★2026-08-12: KCMSplitterPanelWidget, not the stock SplitterPanelWidget - same fields, same
	//   numbers, but a boss whose divider cannot be dragged (see kKCMSplitterPanelBoss above).
	KCMSplitterPanelWidget
	(
		kKCMSplitterWidgetID, kPMRsrcID_None,
		kBindAll,
		Frame(0, 0, 224, 185)
		kTrue, kTrue,
		"",
		kFirstWidgetIsTop,
		kTrue,							// Top pane visible
		kFalse,							// ★Bottom pane hidden = the section starts closed
		185,							// Splitter position
		100,							// Splitter init percentage
		185,							// Top snap = the top pane is never squeezed below its designed height
		kDontSnapSlider,
		60 + kKCMStoryHeaderHeight,	// Bottom snap = smallest useful height for the section. ★+18 (2026-08-10): the heading band is always there, so the floor has to rise with it or the smallest section shows two rows where it used to show three
		kDontSnapSlider,
		kHorizontalSplitter,
		5,								// Splitter radius
		kKCMTopPaneWidgetID,			// ★the widget NOT to resize (SplitterPanelDefs.h:40) = only the section grows
		kSingleClickDoNothing,
	#ifdef MACINTOSH
		kDrawPallets,
	#endif
	#ifdef WINDOWS
		kDrawXORSplitter,
	#endif
		{
			GenericPanelWidget
			(
				kKCMTopPaneWidgetID, kPMRsrcID_None,
				kBindAll,
				Frame(0, 0, 224, 185)
				kTrue, kTrue,
				"",
				{
		// Target / Source status (label stays English; the document name is filled in by the observer).
		StaticTextWidget
		(
			kKCMTargetTextWidgetID,
			kSysStaticTextPMRsrcId,
			kBindLeft | kBindRight | kBindTop,
			Frame(8, 8, 216, 24)		// right edge follows the panel width
			kTrue, kTrue,
			// ★★kEllipsizeBeginning, not kEllipsizeMiddle. **This line shows a FULL PATH**, not a document
			//   name (KCMDocPathFromDB), and the two documents being compared are versions of one job, so
			//   the file names are often identical: what tells them apart is the tail of the path (the
			//   parent folder).
			//   ⇒ On overflow, **cut from the front** and keep the deciding part with the file name
			//     (`...\new\ch01.indd`). Middle-ellipsis removes exactly that parent folder and the two
			//     lines then read as the same string. The book comparison dialog does the same.
			//   ⚠**This line is 208px wide, so a full path usually overflows and the leading "Target: "
			//     label goes with it.** That was accepted deliberately (user: "try the full path"): the
			//     order of the two lines -- Target above, Source below -- stands in for the labels.
			//   ★Fitting is decided HERE and nowhere else: the C++ side trims nothing (a character-count
			//     shortener used to exist and was removed).
			// ★The trailing kFalse turns Convert ampersands OFF. With kTrue a lone '&' is eaten as a
			//   keyboard accelerator and "A&B.indd" shows as "AB.indd" (with B underlined).
			//   All four of KCM's static texts have kInvalidWidgetID as their associated widget, so there
			//   is no accelerator target anywhere and nothing to gain from kTrue.
			//   The product's linksui also uses kFalse for the link file name (LinksUIViews_enUS.fr:412).
			//   ⚠There are two official ways: layerpanel keeps kTrue on its tree rows and doubles the
			//     ampersand in C++ instead ('&' -> '&&' through InsertAmpersandForDisplay,
			//     LayerPanelViewsPageItemTreeNode.fr:86). KBS takes that road because it has tree rows and
			//     CAlert text, neither of which a .fr reaches.
			//     KCM puts no variable string in a CAlert and has no such rows, so turning it off in the
			//     widget removes the whole "forgot to double it in a new message" route.
			kAlignLeft, kEllipsizeBeginning, kFalse,
			kKCMTargetLabelKey,
			kInvalidWidgetID,
		),
		StaticTextWidget
		(
			kKCMSourceTextWidgetID,
			kSysStaticTextPMRsrcId,
			kBindLeft | kBindRight | kBindTop,
			Frame(8, 26, 216, 42)		// right edge follows the panel width
			kTrue, kTrue,
			kAlignLeft, kEllipsizeBeginning, kFalse,	// ★ellipsize and ampersand for the same reasons as the Target line above
			kKCMSourceLabelKey,
			kInvalidWidgetID,
		),

		// (The rule below Target/Source is gone, and what follows moved up by 8px.)

		// (Start / Stop, "Print comparison marks" and the 25% / 75% opacity radios left the panel for
		//  the flyout menu: kKCMPopupStartStopActionID / kKCMPopupPrintMarksActionID /
		//  kKCMPopupOpacity25ActionID / kKCMPopupOpacity75ActionID. **The panel deliberately holds no
		//  buttons for them** -- what is left here is Target/Source, Prev/Next, the message area and
		//  the icons.)

		// Change navigation: jump the Target layout view to the previous / next page that carries a
		// KCM mark (changed ring, Added border, or overflow "/"). Handled by KCMChangeNav.cpp.
		// The layout follows the KESCL panel: "[Prev]  3/12  [Next]". The buttons are narrowed to about
		// the width of their captions and the position readout (kKCMNavPosTextWidgetID) sits between
		// them; the left and right margins are a symmetric 12px.
		ButtonWidget
		(
			kKCMPrevChangeButtonWidgetID,
			kSysButtonPMRsrcId,
			kBindLeft | kBindTop,
			Frame(48, 48, 106, 70)		// width kept at 58. ★Swapped left-right with the tool switch button, so the cluster is on the right (8px from the tool's right edge, 40)
			kTrue, kTrue,
			kKCMPrevChangeKey,
		),
		// The position readout "3/12" between Prev and Next (centred). KCMChangeNav.cpp fills it in at
		// run time through KCMSetNavPosition; it starts empty. It used to be part of the status line.
		StaticTextWidget
		(
			kKCMNavPosTextWidgetID,
			kSysStaticTextPMRsrcId,
			// ★★**It does not move when the panel is widened** (user: "Prev and Next end up far apart --
			//   keep the space between them fixed and the whole thing to the left"). kBindRight was tried
			//   here once, pinning Next to the right edge, and widening then tore the cluster in two.
			//   ★Prev, the readout and Next are read as **one control**, so a growing gap makes them look
			//     like three unrelated ones. What may grow is the Target/Source lines, the message area
			//     and the list.
			kBindLeft | kBindTop,
			Frame(106, 51, 158, 70)		// between Prev (..106) and Next (158..), width 52; top +3px to line the text up with the buttons
			kTrue, kTrue,
			kAlignCenter, kEllipsizeEnd, kFalse,	// ★ampersand conversion off (see the Target line). Only "3/12" appears here, but all four static texts follow one rule
			"",							// empty to start with; the position is written at run time
			kInvalidWidgetID,
		),
		ButtonWidget
		(
			kKCMNextChangeButtonWidgetID,
			kSysButtonPMRsrcId,
			kBindLeft | kBindTop,		// ★stays left, as one piece with Prev (see the readout comment)
			Frame(158, 48, 216, 70)		// width kept at 58. ★The right edge, 216, lines up with the cat illustration (184..216); 8px from the panel edge at 224
			kTrue, kTrue,
			kKCMNextChangeKey,
		),

		// ★The tool switch button (user's request). Pressing it makes **the plug-in's toolbox tool**
		//   (kKCMToolBoss) the active tool. The artwork is the very resource the toolbox shows
		//   (kKCMToolIconResID) -- no second image was made for it.
		//   It is a KCMIconWidget so that it can carry IID_ITIP: its tooltip is not the cat
		//   illustration's but the tool name from the toolbox, and KCMIconTip.cpp tells them apart by
		//   WidgetID.
		//
		// ★Position = to the left of the Prev button (48..), 8px from the panel edge so that it lines
		//   up with the Target label and the message area; vertically level with Prev/Next (48..70) so
		//   the three read as one row.
		// ★★**The frame is deliberately NOT square** (user: "clip it the way the toolbox does -- the
		//   toolbox one is not square"). Putting a 32x32 PNG into a 24x22 frame clips the margin
		//   around the drawing, which is what makes it look like a toolbox tool slot.
		//   ⚠**Nothing of the drawing is lost**: this tool icon is drawn to the spec of 69% of 32px
		//     across (about 22px) and 56% down (about 18px) ([[toolbox-icon-spec]]), so what gets cut
		//     off is the margin.
		KCMIconWidget
		(
			kKCMToolButtonWidgetID,
			kKCMToolIconResID, kKCMUIPluginID,
			kBindLeft | kBindTop,		// bound like Next, so the row moves as one
			Frame(8, 48, 40, 70)		// 32x22. ★Swapped left-right with the Prev/Next cluster
									//   at the user's request; the left edge, 8px, lines up with the
									//   Target label and the message area
			kTrue, kTrue,
			// ★★kADBEIconSuiteButtonDrawWellType is the type that draws a **sunken (pressed) look while
			//   selected** (user's request: "change colour when selected, the way the toolbox does").
			//   IconStyleDefs.h:46 spells it out as kIconCentering, (kIconRaisedLook | kIconWellLook),
			//   kTrue, where the third is Widgets.fh:84's "bool, draw Well". The plain
			//   kADBEIconSuiteButtonType is (..., kIconRaisedLook, kFalse) -- it draws no well, so the
			//   selected state never shows.
			//   The state itself is written to ITriStateControlData by KCMTool::Select / Deselect.
			kADBEIconSuiteButtonDrawWellType,
		),

		// Status icon (OFF visible by default; the observer swaps ON/OFF based on the armed state).
		// KCMIconWidget (not the plain RollOverIconButtonWidget) so it carries IID_ITIP (tooltip).
		KCMIconWidget
		(
			kKCMIconOffWidgetID,
			kKCMIconOffResID, kKCMUIPluginID,
			// ★kBindRight is needed now the panel is resizable: without the intent expressed in the
			//   binding, the illustration is left where it was while the message area grows to the right,
			//   and the two overlap.
			kBindRight | kBindTop,
			// ★★It sits in the Story Edits band (user: "put the cat illustration on the Story Edits row,
			//   and if that lets the panel message grow wider, let it").
			//   ⚠The band was 20px, and this artwork is a cat drawn to the full height of its 32x32 --
			//     unlike the tool icon it has no margin to clip -- so **the band was widened to 32px**
			//     instead, which is what made the panel taller.
			//   ★The width it left behind is taken by the message area (kKCMStatusTextWidgetID below).
			Frame(178, 149, 210, 181)	// 32x32. ★Nudged up and left from the band-exact
									//   (184,153,216,185), at the user's request ("a little further up and
									//   left"). ⚠**The band (32px) and the artwork (32px) are the same
									//   height, so no padding can exist inside the band** -- what pokes out
									//   at the top runs up against the message area above. Same coordinates
									//   as the ON icon.
			kTrue, kTrue,
			kADBEIconSuiteButtonType,
		),
		KCMIconWidget
		(
			kKCMIconOnWidgetID,
			kKCMIconOnResID, kKCMUIPluginID,
			kBindRight | kBindTop,		// ★same reason as the OFF icon
			Frame(178, 149, 210, 181)	// ★same coordinates as the OFF icon (which carries the reason)
			kFalse, kTrue,
			kADBEIconSuiteButtonType,
		),

		// Status text (filled in by the observer with the result of each action).
		// ★★This used to be a StaticMultiLineTextWidget. **Only the drawing changed**: the same
		//   WidgetID, the same Frame, the same binding, the same messages arriving through
		//   KCMSetStatus. What stock could not do is **two colours in one box**, and this box shows
		//   **the other side of the edit** whose row was clicked, where the reader's question is
		//   "which characters differ" (KCMStatusTextView.cpp / IKCMStatusTextData.h).
		// ⚠The fields below belong to GenericPanelWidget. **Five of them are gone**, because the
		//   drawing code decides them now: alignment (always left), ellipsize style (a wrapping box
		//   has no "one line"), ampersand conversion (kFalse either way, see below), the font ID and
		//   **the line count**.
		//   ★★**The line count is the one that matters.** It used to say 4; a self-drawn box takes
		//     **as many whole lines as its height allows**, which is 4 on a Japanese UI (17.9px lines
		//     in a 74px box) and 6 on an English one. The stock widget left the remainder empty.
		// ★Ampersand conversion is off (see the Target line). This is the row that prints **full save
		//   paths** for Save Panel Settings / Save Check & Register / Export Changed Pages, so a
		//   folder named "Q&A資料" was losing its ampersand. The drawing code states the same kFalse
		//   (KCMStatusTextView.cpp).
		KCMStatusTextWidget
		(
			kKCMStatusTextWidgetID,
			kPMRsrcID_None,
			kBindLeft | kBindRight | kBindTop,
			Frame(8, 76, 216, 150)		// ★★The bottom edge is 150 because **a Japanese UI did not fit
									//   four lines**: a palette-font line is taller than a measured string
									//   suggests, so four of them needed more than the box had and the
									//   fourth was clipped.
									//   ⚠**The measurement is in KCMStatusTextView.cpp**, taken there with a
									//   diagnostic build (ascent + descent + leading from the font, not
									//   PMMeasureString). It is not restated here: two copies of that one
									//   measurement already disagreed in the first decimal.
									//   ⚠The older note claiming "four lines with room to spare" was
									//   counting CHARACTERS; the height was short.
									//   ★An English UI draws 12px lines, so the extra height is simply
									//   spare there.
									//   ★The right edge, 216, lines up with the Target/Source lines and the
									//   Next button. The width came from the cat illustration moving down
									//   into the Story Edits band.
			kTrue, kTrue,
			"",								// Panel name (none)
			{
			}
		),

		// ★The Story Edits section's expander.
		// ★★**It has to live in the TOP pane.** Put it in the lower one and it vanishes together with
		//   the section the moment that closes, leaving no way to open it again. The product's linksui
		//   puts its own toggle in the top pane for the same reason (LinksUIViews_enUS.fr:135-142 is
		//   inside the upper pane, not the splitter's lower one).
		// ★It carries no PNG of its own: it borrows InDesign's expander triangles
		//   (kTreeBranchCollapsed / ExpandedRsrcID), and KCMUpdateStorySectionButtonState swaps the
		//   direction from the real state.
		KCMStorySectionToggleWidget
		(
			kKCMStorySectionToggleWidgetID,
			kTreeBranchCollapsedRsrcID, kApplicationRsrcPluginID,
			// ★★**kBindTop, NOT kBindBottom** (the user reported it when it was the other way). The top
			//   pane is kBindAll, so it grows and shrinks with the panel. Every other widget in it is
			//   kBindTop and stays put; bind this one to the bottom and **the button alone drifts
			//   downwards** -- which is exactly what happened once it was docked and reopened.
			//   "Sit in the band at the bottom" is carried by the Frame coordinates, not by the binding.
			kBindLeft | kBindTop,
			Frame(4, 161, 20, 177)		// centred vertically in the band at the bottom of the top pane
									//   (153..185; the artwork is 16px, so 8px above and below). The left
									//   edge, 4px, sits slightly inside the message area's 8px.
			kTrue, kTrue,
			kADBEIconSuiteButtonType,
		),

		// ★The section heading, to the right of the expander and inside the same band. The count is
		//   appended at run time by KCMUpdateStorySectionLabel ("Story Edits (3)").
		// ★★The count is here because **the message area has no room left**: its lines are already
		//   used, and one more would push `failed=N` out of the box. It also means the count stays
		//   readable while the section is closed.
		// ★The binding matches the expander's, kBindLeft | kBindTop (the reason is in its comment).
		StaticTextWidget
		(
			kKCMStorySectionLabelWidgetID,
			kSysStaticTextPMRsrcId,
			kBindLeft | kBindRight | kBindTop,	// the heading stretches with the panel
			Frame(24, 162, 174, 176)	// to the right of the expander (4..20), centred vertically in the
									//   band (153..185). ★The right edge stops 4px short of the cat
									//   illustration (178..210); both are kBindRight, so widening the
									//   panel keeps that gap.
			kTrue, kTrue,
			kAlignLeft, kDontEllipsize, kFalse,
			kKCMStorySectionLabelKey,
			kInvalidWidgetID,
		),
				}
			),
			// ★Lower pane = the "Story Edits" section itself. Visible = kFalse to match the
			//   splitter's "Bottom pane hidden" above - the two have to agree or the section
			//   starts half-open.
			// ★KCMStorySectionPanelWidget rather than a plain GenericPanelWidget: the only
			//   difference is the persistent integer it carries, which is the height this section
			//   had when it was last closed (see kKCMStorySectionPanelBoss above).
			KCMStorySectionPanelWidget
			(
				kKCMStorySectionWidgetID, kPMRsrcID_None,
				kBindAll,
				Frame(0, 185, 224, 285 + kKCMStoryHeaderHeight)	// ★+18px at the bottom: the heading band
												// is added without costing the
												// section a visible row
				kFalse, kTrue,			// ★Visible = kFalse: starts closed
				"",
				{
					// ★★★COLUMN HEADINGS (user's request, 2026-08-10: "put UID / Text / what changed
					//   at the top"). Three labels and a rule, in the SECTION - deliberately not in the
					//   tree.
					//
					//   ★Why outside the tree: a heading that is a row scrolls away with the rows, and
					//     the framework would also treat it as selectable and clickable. Sitting in the
					//     lower pane above the tree, it stays put and takes no part in selection.
					//
					//   ★★What keeps the headings lined up with the cells below them is that each one
					//     repeats its cell's Frame and its cell's binding EXACTLY (compare the row
					//     resource above): 24..64 fixed at the left, 68..154 stretching, 154..216
					//     fixed at the right. Change a column here and the row has to change with it -
					//     the agreement is only in these numbers, nothing enforces it.
					//     ⚠★★AND IT WENT WRONG EXACTLY THAT WAY (fixed 2026-08-20, user's report:
					//       "put UID about where the numbers begin, and Story about where the text begins").
					//       When the expander was put in front of the story row on 2026-08-20, every
					//       cell in the row moved 16px right - and these three did not follow, because
					//       nothing links them. They read 8..48 and 52..154 against cells that had
					//       become 24..64 and 68..154, so both headings sat a column-and-a-half to the
					//       left of what they name. ⇒ When one side of an agreement that "nothing
					//       enforces" moves, the comment saying so is not a warning to the future -
					//       it is a task for the same commit.
					//
					//   ★The heading cells are KCMStoryRowCellWidget for the same reason the row's
					//     are: that boss stays silent on hover (kKCMStoryRowCellBoss). They also take
					//     the same font, so heading and value are drawn identically.
					KCMStoryRowCellWidget
					(
						kInvalidWidgetID,	// WidgetId
						kPMRsrcID_None,					// RsrcId
						kBindLeft,						// Frame binding: as the UID cell (a fixed left column)
						Frame(24, 2, 64, kKCMStoryHeaderHeight - 2),	// Frame (8..48 -> 24..64: the row's UID cell)
						kTrue, kTrue,					// Visible, Enabled
						kAlignLeft,						// Alignment
						kDontEllipsize, kFalse,			// Ellipsize style, Convert ampersands
						kKCMStoryColUIDKey,			// Text Control Data
						0,								// WidgetId for associated control for shortcut focus
						kPaletteWindowSystemScriptFontId, kPaletteWindowSystemScriptFontId,
					),
					KCMStoryRowCellWidget
					(
						kInvalidWidgetID,	// WidgetId
						kPMRsrcID_None,					// RsrcId
						kBindLeft | kBindRight,			// Frame binding: as the text cell (the one that grows)
						Frame(68, 2, 154, kKCMStoryHeaderHeight - 2),	// Frame (52..154 -> 68..154: the row's text cell)
						kTrue, kTrue,					// Visible, Enabled
						kAlignLeft,						// Alignment
						kDontEllipsize, kFalse,			// Ellipsize style, Convert ampersands
						kKCMStoryColTextKey,			// Text Control Data
						0,								// WidgetId for associated control for shortcut focus
						kPaletteWindowSystemScriptFontId, kPaletteWindowSystemScriptFontId,
					),
					KCMStoryRowCellWidget
					(
						kInvalidWidgetID,	// WidgetId
						kPMRsrcID_None,					// RsrcId
						kBindRight,						// Frame binding: as the kind cell (a fixed right column)
						Frame(154, 2, 216, kKCMStoryHeaderHeight - 2),	// Frame
						kTrue, kTrue,					// Visible, Enabled
						kAlignRight,					// Alignment: right, as the values under it
						kDontEllipsize, kFalse,			// Ellipsize style, Convert ampersands
						kKCMStoryColKindKey,			// Text Control Data
						0,								// WidgetId for associated control for shortcut focus
						kPaletteWindowSystemScriptFontId, kPaletteWindowSystemScriptFontId,
					),

					// ★The line under the headings: a panel one pixel tall that erases itself to the
					//   separator colour. Drawing nothing else, that erase IS the line.
					//   ★kInterfaceSeparatorColor is the right colour by name: InterfaceColorDefines.h:105
					//     describes it as "Used in tree node separators and HEADER SEPARATORS IN
					//     MULTICOLUMN LISTS" - this exact job. Being an interface colour, it follows
					//     the light / dark UI theme without any code here.
					//   ⚠★2026-08-10: this WAS a stock RuleWidget (Widgets.fh:887 / kRuleWidgetBoss),
					//     which takes a colour index and exists to draw a rule. It parsed, built and
					//     drew NOTHING (measured - the user's capture shows the headings with no line
					//     under them). ★It has no .fr instance anywhere in the SDK or in source/open,
					//     which is the warning that was there to read: a stock type nobody instantiates
					//     is not a supported path. ErasablePrimaryResourcePanelWidget is used by the
					//     product and by this very panel's tree (kTrue + kInterfacePaletteFill below).
					ErasablePrimaryResourcePanelWidget
					(
						__FILE__, __LINE__,
						kInvalidWidgetID,	// WidgetId
						kPMRsrcID_None,					// RsrcId
						kBindLeft | kBindRight | kBindTop,	// Frame binding: full width, stays at the top
						Frame(0, kKCMStoryHeaderHeight - 1, 224, kKCMStoryHeaderHeight)	// Frame: 1px tall, at the bottom of the band
						kTrue, kTrue,					// Visible, Enabled
						kTrue,							// Erase before draw - this is what paints the line
						kInterfaceSeparatorColor,		// Erase to color
						"",								// Panel name
						{
						}
					),

					// The list of changed stories, filling the rest of the section. ★Its Frame is in
					// the LOWER PANE's own coordinates - (0,0) is the top left of the section, not
					// of the panel - so the heading band's height is where the list now starts.
					// Field order is TreeViewWidget's, copied from KBS.fr:1142-1165.
					KCMStoryTreeWidget
					(
						kKCMStoryTreeWidgetID, kPMRsrcID_None,	// WidgetId, RsrcId
						kBindAll,						// Frame binding: grow with the section
						Frame(0, kKCMStoryHeaderHeight, 224, 100 + kKCMStoryHeaderHeight)	// Frame (the lower pane below the headings)
						kTrue, kTrue,					// Visible, Enabled
						kTrue,							// EraseBeforeDraw
						kInterfacePaletteFill,			// InterfaceColor
						"",								// Panel name
						kHideRootNode,					// Options: the root is not a row
						kFalse,							// Use H scroll bar
						kTrue,							// Use V scroll bar
						kKCMStoryRowHeight,			// fVScrollButtonIncrement (one row)
						kKCMStoryRowHeight,			// fVThumbScrollIncrement
						kKCMStoryRowHeight,			// fHScrollButtonIncrement (unused, no H bar)
						kKCMStoryRowHeight,			// fHThumbScrollIncrement
						1,								// Items selectable: 1 = single selection
						kFalse,							// Allow children from multiple parents to be selected
						kFalse,							// Allow discontiguous selection
						{
						},
					),
				}
			),
		}
	),
	}

	kKCMInternalPopupMenuNameKey		// Popup (flyout) menu name (internal)
};

/*
 * What the UI half adds to the object model: the toolbox tool's identity.
 *
 * ⚠2026-08-15 (split stage 2 task 6B-2): this resource used to sit in KCM.fr and carried
 * app.kcmStatus and app.kcmBookResult as well. Those two are the MODEL's answers - served by
 * kKCMScriptProviderBoss, which stayed model-side - so they stayed with it. Only the tool's
 * enumerator came here, because the tool is a UI boss (kGenericToolBoss cannot live in a
 * kModelPlugIn). ★Both halves publishing their own VersionedScriptElementInfo is normal: the
 * object model is assembled from every plug-in that contributes to it.
 *
 * The tool entry is what ITool.h:192-223 spells out (its worked example is "the pumpkin tool"):
 * define a ScriptID (KCMScriptingDefs.h), add it to kToolBoxEnumScriptElement here, and return
 * it from ITool::GetScriptID (KCMTool.cpp). The second string is the name scripts see:
 * "kohaku change marker tool" surfaces as UITools.KOHAKU_CHANGE_MARKER_TOOL, so a script can both
 * read app.toolBoxTools.currentTool and assign to it to select this tool - neither was possible
 * while GetScriptID returned en_None (measured 2026-08-06, audit block 7).
 * Same shape as the official samples: snapshot (Snap.fr:2085-2101) / wavetool (WavTl.fr:319-336).
 *
 */
resource VersionedScriptElementInfo(10)
{
	//Contexts
	{
		// ★★The feature set is kInDesignAllLanguagesFS (InDesign in every language, InCopy and
		//   InDesign Server excluded), and that is **correct**. The model is snapshot: the resource
		//   that registers SnapTool's ScriptID in kToolBoxEnumScriptElement declares exactly the same
		//   single kInDesignAllLanguagesFS. The reason is plain -- **a toolbox exists only in the
		//   InDesign desktop application**, not in InCopy and not in Server -- so the context of a
		//   tool enumerator belongs to InDesign.
		//   ★The same sample uses kWildFS in its OTHER scripting resource, the one that contains no
		//     tool: **the official code chooses per content inside one plug-in.**
		//   ⚠**KBS using kWildFS is not a disagreement.** Its VersionedScriptElementInfo publishes
		//     properties only and contains no tool -- **different content, correctly different** --
		//     and this half does still own the tool, so the "a toolbox is InDesign-only" reason holds
		//     here. (⚠In the model half's KCM.fr the same sentence lapsed, because the tool left for
		//     this side.)
		// ⚠kWildFS was tried here once and withdrawn the same day. The judgement "there is no official
		//   example of a bare kInDesignAllLanguagesFS" was wrong: snapshot's tool registration is one,
		//   and a result-count limit in that scan had hidden it.
		// ★The script version is kCS5. The official samples range from CS2 to Firedrake, so choosing a
		//   recent one is inside the official range (snapshot's tool registration is kCS5 as well).
		kCS5ScriptVersion, kCoreScriptManagerBoss, kInDesignAllLanguagesFS, k_Wild,
	}
	//Elements
	{
		Enumerator
		{
			kToolBoxEnumScriptElement,
			{
				en_KCMTool, "kohaku change marker tool", "The Kohaku Change Marker tool.",
				// ★The stamp tool is registered here on the same terms as the one above: a
				//   subtool is a tool, so it needs its own enumerator to be told apart from
				//   "nothing selected" and to be selectable from a script. The name below
				//   surfaces as UITools.KOHAKU_PAW_STAMP_TOOL. wavetool registers its own
				//   subtool in exactly this way (en_SineWaveTl, WavTl.fr:319-336).
				en_KCMPawTool, "kohaku paw stamp tool", "The Kohaku Paw Stamp tool.",
			}
		}
	}
};


/*
 * The book comparison dialog's view (2026-08-11).
 *
 * ***** Laid out at a FIXED size on purpose. ***** A modeless dialog's panel never follows the
 * window when the user drags its edge - measured 2026-07-17 over three builds, with EVE at every
 * layer and with kResizeDialogBoss - so offering a resize handle that does nothing would be worse
 * than not offering one. The size is chosen generous enough that the chapter list (next task) is
 * readable without resizing.
 *
 * Shape copied from KESCL's Jump Offset dialog (KESCL.fr:1538), which is the closest working
 * example: a fixed-size dialog by the same author, built on the same stock kDialogBoss.
 * ⚠ The trailing arrange flag after the children is REQUIRED - without it ODFRC fails with R32697.
 */
resource KCMBookDialogWidget (kKCMBookDialogRsrcID + index_enUS)
{
	__FILE__, __LINE__,
	kKCMBookDialogWidgetID,		// WidgetID
	kPMRsrcID_None,					// RsrcID
	kBindNone,						// Binding
	// ⚠★★THIS FRAME DOES NOT SET THE DIALOG'S SIZE - NEITHER NUMBER. Measured 2026-08-13 over eight
	//   builds, and the old comment here ("EVE resizes it to fit the children") had it backwards:
	//
	//       window width = max(widest CHILD frame, widest CHILD's own text) + 2 x margin + 16
	//
	//   This frame is not in that formula. It was set to 540, 510, 340 and 390 while the window went
	//   540→506→356→356, following the CHILDREN every time. Each measurement:
	//       child 500, 74-char path, margin  5  → 600      child 500, same path, margin 10 → 610
	//       child 470, same path,    margin 10 → 610      child 470, path shortened      → 506
	//       child 320, path shortened, margin 10 → 356    (this frame 340 and 390 both → 356)
	//   ⇒ To change the width, change the CHILD frames below (they are all kept equal), or shorten
	//     the text they are given. Changing this line does nothing.
	//
	// ★★AND WHY THE CHILD FRAMES NOW HOLD. Until 2026-08-15 they did not: a full 74-character path
	//   made the window 610px wide whatever the frames said, because EVE treats a .fr width as a
	//   MINIMUM and resizes static text to fit its label ("we treat the width in the .fr file as a
	//   minimum width" - Using EVE, Example 2). The path was therefore shortened in C++ before it
	//   reached the widget, which hid the problem rather than fixing it.
	//   ⇒ The two path lines are now KCMBookPathTextWidget, whose boss answers EVE's size question
	//     with "what the resource wrote" (kFixedSizeEVEInfoImpl). Measured after the change: 400px
	//     with a 66-character path in it, and the widget's own kEllipsizeBeginning shortening it -
	//     the same way the panel's Target:/Source: lines do.
	// ★HEIGHT does follow the children (393 measured against the 420 written here), which is
	//   presumably how the old comment came to be believed.
	Frame(0, 0, 390, 420),			// Frame (l,t,r,b) - ★NOT the dialog's size; see above
	kTrue, kTrue,					// Visible, Enabled
	kKCMBookDialogTitleKey,		// Dialog name

	{
		// ----- which two books this report is about -----
		// ***** These two lines are the whole safety net. ***** Target is whichever book had the
		// front tab in the Book panel, and that is NOT the same thing as InDesign's "active book" -
		// the two drift apart silently. ★Since 2026-08-12 the same two strings are shown in the
		// confirmation alert BEFORE anything is read (KCMBookRun.cpp), and what is printed here is
		// what that run was given - not a fresh look at the Book panel, which by now may have moved.
		// ⚠ Convert ampersands = kFalse: a path through a folder called "Q&A" would otherwise display
		// as "QA" (the ampersand is eaten as an accelerator marker).
		KCMBookPathTextWidget
		(
			kKCMBookTargetTextWidgetID,	// WidgetId
			kSysStaticTextPMRsrcId,			// RsrcId
			kBindNone,						// Frame binding
			// ***** 364 HERE IS WHAT MAKES THE WINDOW 400px WIDE. ***** This number, not the root
			// frame, is the dialog's width: 364 + 2x10 margin + 16 = 400 (formula and the eight
			// measurements behind it are at the root frame above).
			// ★400 is what the TITLE needs. At 356 it came out as "Kohaku Change Marker - Compare
			//   ..." - 32 of its 36 characters - and the user asked for a size where it fits
			//   properly. The title is invisible to EVE, so it can only be served from here.
			//   ⚠ Re-measure if the title string changes.
			// ★The hint line ("Right-click a changed chapter...", ~318px) is the widest CONTENT, so
			//   anything from ~318 up is safe for the content itself; the extra is for the title.
			// ⚠ EVERY CHILD BELOW CARRIES THE SAME NUMBER, and they must stay equal - the widest one
			//   wins silently, so a stale 500 in any of them would set the width on its own.
			Frame(0, 0, 364, 20)			// Frame (l,t,r,b)
			kTrue, kTrue, kAlignLeft,		// Visible, Enabled, Alignment
			// ★★Ellipsized at the BEGINNING (2026-08-12, was kEllipsizeMiddle). These lines carry a
			//   FULL PATH now, and what tells two versions of one job apart is the tail - the last
			//   folder and the file name ("...\New\a.indb" against "...\Old\a.indb"). The middle is
			//   exactly where that distinguishing folder sits, so a middle ellipsis would eat the
			//   one part worth reading. (The user asked for the front to go, 2026-08-12.)
			kEllipsizeBeginning, kFalse,	// Ellipsize style, Convert ampersands
			"",								// Text (the controller fills it)
			kInvalidWidgetID				// Associated control (none)

			// ***** THE GAP TO Source IS THE PANEL'S GAP. ***** (User, 2026-08-13: "the line spacing
			// between target and source is wide - make it about the same as the panel's target and
			// source".) The panel's two labels were measured with app.ktWidgetMap the same day:
			//   Target: y 196→212, Source: y 214→230  ⇒ 2px between them
			// kEVEVerySmallSpaceAfter is Spacing 2 (EveInfo.fh:48) - that number exactly. It was
			// kEVERegularSpaceAfter, which is 5 (:44).
			// ⚠ The remaining difference is the LINE HEIGHT, not the gap: these two widgets are 20px
			//   tall where the panel's are 16, so the pitch stays 4px looser than the panel's. Left
			//   alone deliberately - a Japanese UI needs 18px of line box (memory
			//   palette-font-line-height-by-ui-language), and trimming the frame to match the panel
			//   would risk clipping the text to win back pixels nobody asked for.
			//
			// ***** Fill, not Left - but ⚠ FILL IS NOT WHAT FIXES THE WIDTH. ***** The comment here
			// used to say it was, and 2026-08-15 disproved it: with the C++ shortening taken out,
			// this dialog measured 593px, Fill and all. Fill means "take the PARENT's width", and
			// the parent is itself grown by whichever child asks for more - so Fill decides how the
			// space is shared, never how much of it there is to share.
			// ★What holds the width is the BOSS of these two lines (KCMBookPathTextWidget →
			//   kKCMBookPathTextWidgetBoss), which answers EVE's size question with the frame
			//   rather than with the text. Fill still earns its keep: it makes this widget span the
			//   parent, so the frame above is the width actually used - and that is what leaves
			//   kEllipsizeBeginning something to elide (a widget grown to fit its text never elides).
			kEVEAlignFill | kEVEVerySmallSpaceAfter,
		),

		KCMBookPathTextWidget
		(
			kKCMBookSourceTextWidgetID,	// WidgetId
			kSysStaticTextPMRsrcId,			// RsrcId
			kBindNone,						// Frame binding
			Frame(0, 0, 364, 20)			// Frame (l,t,r,b) - same width as Target above
			kTrue, kTrue, kAlignLeft,		// Visible, Enabled, Alignment
			kEllipsizeBeginning, kFalse,	// Ellipsize style, Convert ampersands (as Target above)
			"",								// Text (the controller fills it)
			kInvalidWidgetID				// Associated control (none)

			kEVEAlignFill | kEVELargeSpaceAfter,	// Fill, for the reason spelled out on Target above
		),

		// (The Compare button stood here until 2026-08-12. The comparison is now confirmed in an
		//  alert and run from the flyout, so the dialog opens with the answer already in it and has
		//  nothing left to press - see KCMBookRun.h. Its WidgetID and its label string are kept
		//  declared, unused, so the pair can be put back together if the flow is ever reverted.)

		// ----- the status line -----
		// Always states the chapter COUNT, so "nothing listed" can never be misread as "nothing
		// could be opened".
		// ⚠★Ellipsized in the MIDDLE, and that is not cosmetic. The summary grows a clause per
		// non-zero outcome and the LAST of them is "N failed" - the one clause the reader must not
		// miss. Measured 2026-08-11 with 15 chapters: ending-ellipsis cut it to "...1 fai…". The
		// middle is the safe place to lose text, because both the chapter count and the failure
		// count survive there.
		EVEStaticTextWidget
		(
			kKCMBookStatusTextWidgetID,	// WidgetId
			kSysStaticTextPMRsrcId,			// RsrcId
			kBindNone,						// Frame binding
			Frame(0, 0, 364, 20)			// Frame (l,t,r,b) - same width as the lines above
			kTrue, kTrue, kAlignLeft,		// Visible, Enabled, Alignment
			kEllipsizeMiddle, kFalse,		// Ellipsize style, Convert ampersands
			kKCMBookReadyKey,				// Text (replaced after each comparison)
			kInvalidWidgetID				// Associated control (none)

			// Close up to the hint below it: the two lines are ONE message (see the next widget).
			// Fill for the same reason as the two path lines: a summary is short, but a widget that
			// sizes to its own text is a width nobody controls.
			kEVEAlignFill | kEVEVerySmallSpaceAfter,
		),

		// ----- the status line's second line: how to act on a row -----
		// ***** A SECOND LINE, NOT A LONGER FIRST ONE. ***** (User, 2026-08-13: "make the dialog's
		// message part two lines, and on the second line put something like - you can start from a
		// right click on a row - as a message, in English".) The first line reports THIS RUN and is
		// rewritten after every comparison; this one is a standing instruction and never changes, so
		// it is filled from the resource and no C++ ever touches it. Appending it to the summary
		// instead would have put a sentence that never varies through the summary's middle-ellipsis,
		// where a long report would eat it.
		//
		// ★"a CHANGED chapter", not "a row": the item is only enabled where the question "where did
		//   it change?" has an answer (KCMBookOpen.cpp's KCMBookRowCanStart), and InDesign does
		//   not show a popup whose every item is disabled - so on the other rows a right click
		//   produces nothing at all. Naming the row type is what keeps that from reading as a fault.
		// ★Ellipsized at the END, unlike the two path lines above: this is a sentence, and a sentence
		//   is read from the front.
		EVEStaticTextWidget
		(
			kInvalidWidgetID,		// WidgetId
			kSysStaticTextPMRsrcId,			// RsrcId
			kBindNone,						// Frame binding
			Frame(0, 0, 364, 20)			// Frame (l,t,r,b) - same width as the lines above
			kTrue, kTrue, kAlignLeft,		// Visible, Enabled, Alignment
			kEllipsizeEnd, kFalse,			// Ellipsize style, Convert ampersands
			kKCMBookHintKey,				// Text (fixed - nothing rewrites this)
			kInvalidWidgetID				// Associated control (none)

			kEVEAlignFill | kEVELargeSpaceAfter,	// Fill, as the lines above
		),

		// ----- the chapter list -----
		// One row per chapter: its file name on the left, the verdict on the right. The status
		// line above says how many of each; this says WHICH.
		// ⚠ A fixed height, and it has to be: a modeless dialog's panel never follows its window,
		// so nothing here can grow later. Ten rows at a glance, and the scroll bar for the rest.
		// ★kDrawBorder is what makes it read as a list box rather than as text on the dialog's
		//   background - the same option basicselectabledialog gives its tree (BscSlDlg.fr:414).
		KCMBookTreeWidget
		(
			kKCMBookTreeWidgetID, kPMRsrcID_None,	// WidgetId, RsrcId
			kBindNone,						// Frame binding (EVE places it)
			Frame(0, 0, 364, kKCMBookRowHeight * 10)	// Frame - same width as the lines above
			kTrue, kTrue,					// Visible, Enabled
			kTrue,							// EraseBeforeDraw
			kInterfacePaletteFill,			// InterfaceColor
			"",								// Panel name
			kHideRootNode | kDrawBorder,	// Options: the root is not a row
			kFalse,							// Use H scroll bar
			kTrue,							// Use V scroll bar
			kKCMBookRowHeight,			// fVScrollButtonIncrement (one row)
			kKCMBookRowHeight,			// fVThumbScrollIncrement
			kKCMBookRowHeight,			// fHScrollButtonIncrement (unused, no H bar)
			kKCMBookRowHeight,			// fHThumbScrollIncrement
			1,								// Items selectable: 1 = single selection
			kFalse,							// Allow children from multiple parents to be selected
			kFalse,							// Allow discontiguous selection
			{
			},

			kEVEAlignFill | kEVELargeSpaceAfter,
		),

		// (The button row - an OK button in a right-aligned panel - stood here until 2026-08-12.
		//  ***** REMOVED AT THE USER'S REQUEST, and it costs nothing. ***** A modeless dialog is
		//  closed with its close box, and this one also has a minimize box put on by hand
		//  (KCMPrepareBookDialogWindow); OK was a third way to do what the close box already does.
		//  ⚠What DOES change is the keyboard: a default button is what Enter presses, so Enter no
		//    longer closes this dialog. Whether Esc still closes it is NOT claimed here - the Escape
		//    key reaches a dialog through its Cancel button, and this one never had one. The close
		//    box is the way out, and that path is measured (2026-08-11, book comparison stage 2).)
	},

	// ***** THE MARGIN WAS SET FROM MEASUREMENT, THEN FROM THE EYE. ***** (User, 2026-08-13: the gap
	// between the edge and the text "looks different from the application's own panels - match them",
	// then, on seeing the result, "a little narrow - about 2px wider".)
	//
	// kEVELargeMargin [15,15,15,15] (EveInfo.fh:92) stood here first. Measured with app.ktWidgetMap
	// on 2026-08-13, InDesign's own panels put their text 5px from the edge:
	//   Links panel   root x1=697 → #LinkInfoNameStr x1=702, #SelectedLinkInfoSectionName x1=702  = +5
	//   Pages panel   root x1=383 → its list runs edge to edge                                    = +0
	// kEVESmallMargin [5,5,5,5] matched that exactly and was tried - and read as slightly tight.
	//
	// ⚠★EVE HAS NO 7. Its margins are a fixed ladder, not a number: on all four sides the whole
	//   choice is 0 / 1 / 5 / 10 / 15 (EveInfo.fh:89-93 - the field is a 4-bit index, so intermediate
	//   values cannot be written at all). The choice was therefore 5 or 10 (7px was reachable only by
	//   nesting wrapper panels to stack their margins, which is two extra widgets to move the text
	//   2px). ★The user chose 10.
	//   ⚠"/ 20" stood at the end of that ladder until 2026-08-18 (bug recheck B-U1) and there is no
	//     such margin: 20 appears only INSIDE an asymmetric one, kEVERegularButExtraLargeTopMargin
	//     = [10,20,10,10] (EveInfo.fh:96-99, four of those). ★The line named EveInfo.fh:89-93 as its
	//     own evidence, and those five lines are exactly the five that do not include a 20.
	// ⚠ The dialog is 10px narrower and shorter each way than it was at 15. EVE sizes the window from
	//   the children (all 364 wide) plus the margin; the fixed Frame above is overridden.
	//   ⚠"all 500 wide" until 2026-08-18 (B-U1): the children were narrowed to 364 on 2026-08-15, and
	//     the warning further up ("a stale 500 in any of them would set the width on its own") was
	//     written about exactly that number - the file kept the stale value in the line that explains
	//     the mechanism while warning about it in the line that lists the frames.
	// ★For the record, KCM's own panel sits at +8 (root x1=119 → labels at x1=127) - but that is
	//   drawn from absolute coordinates in its .fr, not by EVE, which is why it can hold a value the
	//   ladder does not have.
	kEVEArrangeChildrenInColumn | kEVERegularMargin,
};

#endif // __ODFRC__

#include "KCMUI_enUS.fr"
