#include "VCPlugInHeaders.h"

// General includes:
#include "MenuDef.fh"
#include "ActionDef.fh"
#include "ActionDefs.h"
#include "LocaleIndex.h"
#include "PMLocaleIds.h"
#include "StringTable.fh"
#include "ObjectModelTypes.fh"
#include "ShuksanID.h"
#include "ActionID.h"
#include "WidgetID.h"
// ★★**BuildNumber.h is NOT unused, and a search for its names says it is.** Not one of them
//   appears below -- but ObjectModelTypes.fh:58 defines kTargetVersion, which the PluginVersion
//   resource writes, as **RezLong(kBuildNumber) in a DEBUG build** (kReleaseVersion otherwise).
//   ⇒ Dropping it builds cleanly in Release and breaks Debug. **A header can be needed through a
//     macro, so "no name of it is mentioned" is not a reason to remove one.**
#include "BuildNumber.h"
#include "PlugInModel_UIAttributes.h"

// Panel / widget resources:
#include "PanelList.fh"
#include "Widgets.fh"				// PalettePanelWidget and the standard control widgets
// Splitter constants (kFirstWidgetIsTop / kHorizontalSplitter / kDontSnapSlider / ...). Reached by a
// relative path on purpose: this header lives under source/open, and the ODFRC response file that
// feeds this build lists ONLY source/public directories - it is generated, sits outside the repo,
// and has no counterpart in _buildproj, so a -i added there would not survive. The path is relative
// to this .fr, which is how the preprocessor resolves quoted includes.
#include "../../open/includes/ui/SplitterPanelDefs.h"
#include "InterfaceColorDefines.h"
#include "DialogLayoutID.h"		// IID_IEVEINFO / kFixedSizeEVEInfoImpl - the book dialog's path lines
#include "IControlViewDefs.h"
#include "SysControlIds.h"
#include "TreeViewDefs.h"			// kHideRootNode - the Story Edits list (2026-08-10)
#include "EveInfo.fh"				// EVE widget types + layout flags - the book comparison dialog (2026-08-11)

// ⚠**AppFrameworkID.h and DocumentID.h are deliberately NOT included, and must not come back.**
//   This file was made from KCM.fr, so the include list arrived complete with the paragraphs
//   that justify it -- but both of those headers exist for reasons that stayed on the model side:
//     * AppFrameworkID.h  defines kApplicationObjectScriptElement, the element app.kcmStatus and
//                         app.kcmBookResult hang on; the model half's kKCMScriptProviderBoss
//                         serves them.
//     * DocumentID.h      defines kAfterCloseDocSignalRespServiceImpl, the close-document
//                         responder's service impl -- and the Class that names it is in KCM.fr,
//                         not here (the old text's "see that Class below" pointed at nothing).
//   Neither is used anywhere in this file (grepped: both occurred inside comments only), and the
//   UI half builds with no warnings and no errors without them.
//   ⚠**kActiveContextBoss, which the AddIn below uses, comes from ShuksanID.h:99, not from
//     AppFrameworkID.h** (kUtilsBoss likewise, :241). Look a boss up before dropping a header --
//     "it is a boss, so it must be in AppFrameworkID.h" is how this goes wrong.
//
// ★**AdobeMenuPositions.h, CommandID.h, WorkspaceID.h and TextID.h went the same way on
//   2026-08-29** -- measured, not assumed: no name any of them defines is written in this file,
//   and no macro used here expands into one.
//   ★★**TextID.h is the one worth remembering: it was the residue of a MOVE.** It was here for
//     kGlobalTextAdornmentServiceImpl / IID_IGLOBALTEXTADORNMENT, and the Story jump marker that
//     needed them **left for the model half on 2026-08-23** (the Class comment below records the
//     move). The include stayed, and its comment went on describing a Class this file no longer
//     has. ⇒ **When a Class leaves, its headers leave with it.**
// ScriptInfoTypes.fh: a toolbox tool has to register its ScriptID in kToolBoxEnumScriptElement
// (ITool.h:192-223) - that is the tool's identity, not a scripting API. This single header is
// enough for the resource at the end of this file: it also pulls in ScriptingID.h
// (kCoreScriptManagerBoss) and defines kCS5ScriptVersion.
#include "ScriptInfoTypes.fh"	// VersionedScriptElementInfo / Enumerator
#include "GraphicsID.h"	// for IID_IDRWEVTHANDLER (the UI half's draw-event handler boss).
// ★IID_ISPRITE / IID_IPATHGEOMETRY / kPathGeometryImpl went out together with the sprite on the
//   tracker boss (the reason is in the kKCMTrackerBoss Class comment below).
#include "TipsID.h"		// for IID_ITIP

// Toolbox tool:
#include "Tool.fh"			// ToolDef resource type
#include "ToolBoxDefs.h"	// tool group / tool number constants (kSixthAdobeToolsGroup, kFirstAdobeTool, kDoesNotApply)
#include "ToolboxID.h"		// kGenericToolBoss
#include "LayoutUIID.h"		// kPointerToolBoss (ToolDef tool type)
#include "CursorID.h"		// IID_ICURSORPROVIDER (tool cursor provider)
#include "Cursor.fh"		// PNGC / SVGC / HOTC resource types (cursor image and hotspot)
#include "CursorDefs.h"	// kHIDPICrsrOffset / kHIDPI150CrsrOffset (the 2x and Windows-1.5x cursor IDs)
#include "IconPNGDefs.h"	// kHIDPIIconOffset / kHIDPIIconOffset150 (2x and Windows 1.5x of the dedicated tool icon)

// Project includes:
#include "KCMUIID.h"
#include "KCMScriptingDefs.h"	// en_KCMTool (the toolbox tool's ScriptID) - the UI half's copy


#ifdef __ODFRC__

/*  
 * Plugin version definition.
 */
resource PluginVersion (kSDKDefPluginVersionResourceID)
{
	kTargetVersion,
	kKCMUIPluginID,
	kSDKDefPlugInMajorVersionNumber, kSDKDefPlugInMinorVersionNumber,
	kSDKDefHostMajorVersionNumber, kSDKDefHostMinorVersionNumber,
	kKCMUICurrentMajorFormatNumber, kKCMUICurrentMinorFormatNumber,
	{ kInDesignProduct },
	{ kWildFS },
	kUIPlugIn,
	kKCMUIVersion
};

/*  
 * The ExtraPluginInfo resource adds extra information to the Missing Plug-in dialog
 * that is popped when a document containing this plug-in's data is opened when
 * this plug-in is not present. These strings are not translatable strings
 * since they must be available when the plug-in isn't around. They get stored
 * in any document that this plug-in contributes data to.
 */
resource ExtraPluginInfo(1)
{
	kKCMUICompanyValue,			// Company name
	kKCMUIMissingPluginURLValue,	// URL
	kKCMUIMissingPluginAlertValue,	// Missing plug-in alert text
};

/*
 * ★★★This half does not stand on its own (2026-08-15, Stage 2 Task 11).
 *
 * Everything the panel shows comes from the model plug-in through the five facades, so KCMUI
 * without KohakuExtendScriptChangeMarker is a panel with nothing behind it. Guide gs-03:55 puts
 * it plainly: a UI plug-in makes no sense without its model half - so say so here and let
 * InDesign enforce the load order and report the missing half, instead of failing later with
 * nil facades and no explanation.
 *
 * Shape copied from the SDK's own model/UI pair: transparencyeffectui/TranFxUI.fr:77-86.
 * ⚠The dependency is ONE-WAY. The model half must NOT declare a dependency on this one - it has
 *   to keep working when only it is installed (that is the whole point of the split).
 */
resource PluginDependency(kSDKDefPluginDependencyResourceID)
{
	kWildFS
	{
		kKCMPluginID,			// the model half's PluginID (KCMBoundaryID.h)
		kKCMPluginName,		// "KohakuExtendScriptChangeMarker"
		kSDKDefPlugInMajorVersionNumber,
		kSDKDefPlugInMinorVersionNumber,
	}
}

/* 
 * Boss class definitions.
 */
resource ClassDescriptionTable(kSDKDefClassDescriptionTableResourceID)
{{{

// The UI-only draw service. It carries the on-press HUD and nothing else.
// ★The model half's kKCMDrawEventServiceBoss (the comparison marks) has a different job: those
//   have to reach print and PDF export, so they are declared in KCM.fr, while this one is
//   screen-only. kDrawEventService expects several providers (InDesign itself registers over 20).
	Class
	{
		kKCMUIDrawEventServiceBoss,
		kInvalidClass,
		{
			IID_IK2SERVICEPROVIDER, kKCMUIDrawEventSrvcImpl,
			IID_IDRWEVTHANDLER,     kKCMUIDrawEventHandlerImpl,
		}
	},

// The UI half's startup / shutdown service. Its counterpart is kKCMPeekStartupBoss, in the model
// half's KCM.fr.
// ★Order matters on the way out: the subscriptions come off before the panel is taken down (see
//   the comment at the top of KCMUIStartup.cpp).
// ⚠**The relative order of the two services is not guaranteed.** It was checked line by line at
//   the split that neither depends on the other having run.
	Class
	{
		kKCMUIStartupBoss,
		kInvalidClass,
		{
			IID_ISTARTUPSHUTDOWN,   kKCMUIStartupImpl,
			IID_IK2SERVICEPROVIDER, kLazyStartupShutdownProviderImpl,
		}
	},

	// Action component: handles the About menu items (main menu + panel flyout).
	Class
	{
		kKCMActionComponentBoss,
		kBaseActionComponentBoss,
		{
			IID_IACTIONCOMPONENT, kKCMActionComponentImpl,
		}
	},

	// The ChangeMarker control panel (palette). The observer drives the Prev/Next buttons and the
	// status text/icon (the Start/print/opacity controls moved to the flyout menu, 2026-07-10);
	// the popup (flyout) menu data hosts the flyout menu itself.
	Class
	{
		kKCMPanelWidgetBoss,
		kPalettePanelWidgetBoss,
		{
			IID_IPANELMENUDATA, kCPanelMenuDataImpl,
			IID_IOBSERVER, kKCMPanelObserverImpl,
			// Roll-over: undim the panel while the pointer is over it (verified on the whole
			// panel area, 2026-07-29). Note that IMouseRollOver has no usage example anywhere
			// in the SDK; besides this AddIn it needs CREATE_PMINTERFACE *and* an entry in
			// KCMUIFactoryList.h - a missing factory entry fails completely silently.
			// Implementation: KCMPanelAlpha.cpp.
			IID_IMOUSEROLLOVER, kKCMPanelRollOverImpl,
			// The panel's view replaced (2026-08-10): PalettePanelView plus a floor under how small
			// the panel can be dragged, now that PanelList below says kIsResizable. See
			// KCMPanelView.cpp - the same shape KBS and KESCL use, which they took from
			// customconditionaltextui.
			IID_ICONTROLVIEW, kKCMPanelViewImpl,
		}
	},

	// Deferred Pages-panel thumbnail refresh. After a document close, refreshing the survivor's
	// thumbnails synchronously fails while the panel is mid-switch to the newly-active document,
	// so the close clean-up schedules this one-shot idle task (~150ms) which purges + redraws
	// once the switch has settled.
	// It takes itself off the queue by calling UninstallTask() at the end of RunTask - NOT by
	// returning kEndOfTime: CIdleTask.h:33-38 says derived tasks must not, because the task manager
	// then drops the task without going through UninstallTask, leaving fCurrentlyInstalled set and
	// making every later InstallTask a silent no-op.
	Class
	{
		kKCMThumbIdleTaskBoss,
		kInvalidClass,
		{
			IID_IIDLETASK, kKCMThumbIdleTaskImpl,
		}
	},

	// Layout view sync observer, added onto the system active-context boss (same proven pattern as
	// the user's original KESLayoutScrollObserver plug-in, which is confirmed working: an observer
	// living on kActiveContextBoss under a custom IID receives the layout views' IID_IPANORAMA
	// notifications; a free-floating observer boss did NOT receive them in practice).
	// While the flyout "Sync Layout Views" toggle is ON, this observer subscribes to the IPanorama
	// subject of every open layout view (and to the active context for document switches). Whenever
	// any view scrolls or zooms, the change is mirrored (position + zoom) to the layout views of the
	// OTHER documents. A re-entrancy guard suppresses the notifications caused by the mirroring itself.
	// ⚠Two corrections on 2026-08-19 (bug recheck B-U7), both stale since mid-July:
	//   - "all ... OTHER documents" holds only while STOPPED. While a comparison is armed the mirroring
	//     is limited to the Target<->Source pair (user's decision, 2026-07-11); a third document is
	//     neither a source nor a destination.
	//   - "same engine as Alt+middle": the middle-button gestures were removed on 2026-07-13. The engine
	//     is shared with the "Align Other Views to Active" flyout action instead.
	AddIn
	{
		kActiveContextBoss,
		kInvalidClass,
		{
			IID_IKCMLAYOUTSYNCOBSERVER, kKCMLayoutSyncObserverImpl,
			// Batch-close observer (2026-07-27). Subscribes to the application subject and waits for
			// kPendingDocumentsClosedMsg, which the built-in Links UI plug-in broadcasts once every
			// document of a multi-document close has finished closing. Closing N documents used to run
			// KCM's full close cleanup (strip detach, InvalidateViews, thumbnail refresh, panel
			// refresh) N times; now the UI half is deferred and flushed once. Lives on the same
			// active-context boss for the same proven reason as the sync observer above.
			IID_IKCMDOCSCLOSEDOBSERVER, kKCMDocsClosedObserverImpl,
			// Model-change observer (2026-08-13, Stage 1 Task 9). The model no longer calls the UI:
			// it raises a notification on the application subject under our own protocol IID, and
			// this observer turns it back into UI work. Same shape as the two above -- nothing new
			// is introduced, and with nobody listening the model simply does nothing (Server-safe).
			IID_IKCMMODELCHANGEOBSERVER, kKCMModelChangeObserverImpl,
			// Panel visibility observer (2026-07-29). Implementation: KCMPanelAlpha.cpp.
			// ★It subscribes to TWO subjects and acts on THREE messages (widened 2026-08-19, bug
			//   recheck B-U9 - this comment named one of each, which was true only on the day it
			//   was written):
			//     kPanelManagerBoss / IID_IPANELMGR -> kPaletteVisibilityChangedMessage
			//     kAppBoss / IID_IAPPLICATION       -> kDockedPaletteAreaChangedByUserMsg (2025 only;
			//                                          measured NOT to fire on 2026) and
			//                                          kApplicationSuspendMsg (the pointer was on the
			//                                          panel and left for another application).
			// ⚠kPaletteVisibilityChangedMessage is about VISIBILITY, exactly as its name says: it
			//   fires when a panel is opened, closed, iconised or pulled out as a drawer, and it does
			//   NOT fire when the panel merely changes PLACE (docked <-> floating). That gap is the
			//   whole reason the Win32 event hook in KCMPanelAlpha.cpp exists - so this AddIn must
			//   not be read as covering the docking transitions.
			// The toggles write their alpha to the target's current top-level window (an OWL.Dock, or
			// an OWL.FrameDrawer while it is a drawer), and that window is thrown away and rebuilt by
			// the very actions this message reports - so without this observer the translucency would
			// be silently lost. THREE targets share it: this panel, InDesign's own Pages panel
			// (2026-08-06) and this plug-in's book comparison dialog (2026-08-13).
			// Lives on the same active-context boss for the same proven reason as the two observers
			// above.
			IID_IKCMPANELVISIBILITYOBSERVER, kKCMPanelVisibilityObserverImpl,
		}
	},

	// Subclass of the system rollover icon button, adding IID_ITIP so hovering it shows a tooltip
	// (same pattern as kLinksUIButtonBoss in open/components/linksui).
	// ★THREE widgets share this boss, and the tip is NOT the same on all three: the two halves of
	// the panel illustration (kKCMIconOnWidgetID/kKCMIconOffWidgetID) show the repo URL, while
	// the tool button (kKCMToolButtonWidgetID) shows the tool's name. KCMIconTip.cpp tells them
	// apart by WidgetID - see the head of that file.
	// (⚠this comment named only the illustration until 2026-08-18, bug recheck B-U3: the tool
	//  button was given the same boss on 2026-08-07 and nobody came back to widen the sentence.)
	Class
	{
		kKCMIconWidgetBoss,
		kRollOverIconButtonBoss,
		{
			IID_ITIP, kKCMIconTipImpl,
		}
	},

	// Toggle button for the "Story Edits" section at the bottom of the panel: the same rollover
	// icon button with an observer attached, which is exactly how the product's Links panel builds
	// its Link Info toggle (kToggleLinkInfoButtonBoss in open/components/linksui). The observer
	// watches IID_ITRISTATECONTROLDATA and opens or closes the lower pane.
	Class
	{
		kKCMStorySectionToggleBoss,
		kRollOverIconButtonBoss,
		{
			IID_IOBSERVER, kKCMStorySectionToggleObserverImpl,
		}
	},

	// The splitter that divides the panel into the fixed block of controls above and the "Story
	// Edits" section below. Identical to the stock kSplitterPanelWidgetBoss except for one thing:
	// the interface that receives the mouse is replaced by an implementation that does nothing, so
	// ★THE DIVIDER CANNOT BE DRAGGED (user's call, 2026-08-12).
	//
	// ★Why "make it not move" needs an implementation at all: there is no way to REMOVE an interface
	//   from an inherited boss, so the way to switch a behaviour off is to name a different
	//   implementation for it. KCMNoTip.cpp silences a tooltip the same way, for the same reason.
	//
	// ★What was actually lost: dragging UP was already stopped by the top snap (this file gives it the
	//   designed height of the upper pane, and Widgets.fh:418 says the slider does not move beyond a
	//   snap position). Only dragging DOWN was left, and that grew the upper pane past the block of
	//   fixed-coordinate controls it holds - leaving a dead strip with nothing in it. The section is
	//   sized by dragging the edge of the PANEL instead, which is what KCMPanelView already assumes.
	//
	// ★The drag would very likely have stopped anyway, without the event handler: the splitter drag is
	//   run by a tracker, and trackers are looked up by the widget's CLASS ID (ITrackerFactory.h:44-50),
	//   so a boss of our own is not the class the stock tracker was installed for. That is an untested
	//   inference about someone else's registration though, and this one is not - the mouse cannot get
	//   in at all. Both work in the same direction; neither is relied on alone.
	Class
	{
		kKCMSplitterPanelBoss,
		kSplitterPanelWidgetBoss,
		{
			IID_IEVENTHANDLER, kKCMSplitterEHImpl,
		}
	},

	// The "Story Edits" section itself - a plain panel plus one number: how tall the section was
	// when it was last closed, so the next open restores that height instead of a fixed default.
	// The interface is declared as ours but implemented by the SDK's stock kPersistIntDataImpl and
	// read through IIntData, exactly as the Links panel holds IID_ISAVEDINFOPANESIZE on its info
	// pane (LinksUIClass.fr:91). Persistent, so the height also survives quitting InDesign.
	// ★The height lives on the widget rather than in a static: the panel rebuilds its widgets every
	//   time it is re-shown, and state kept outside them is state that goes stale.
	Class
	{
		kKCMStorySectionPanelBoss,
		kGenericPanelWidgetBoss,
		{
			IID_IKCMSAVEDSECTIONHEIGHT, kPersistIntDataImpl,	// treat as IIntData
		}
	},

	// The "Story Edits" list. The tree's controller and most of its event handling already come with
	// kTreeViewWidgetBoss, so a flat list only has to say what the rows ARE (the hierarchy adapter)
	// and how they are DRAWN (the widget manager) - that pair is the whole shape of the samples that
	// use a plain list (linkwatcher's kLnkWtchTreeViewWidgetBoss, basicselectabledialog's).
	// ★The third, IID_IEVENTHANDLER, is this panel's own (2026-08-11): the stock up / down arrows
	//   move the selection, and KCMStoryTreeEH makes the row they land on SHOW ITSELF, so the list
	//   can be walked with the keyboard. ⚠It is only ever constructed because KCMStoryRowEH asks
	//   the tree for it - naming it here is not enough (implementations are lazy).
	Class
	{
		kKCMStoryTreeWidgetBoss,
		kTreeViewWidgetBoss,
		{
			IID_ITREEVIEWHIERARCHYADAPTER, kKCMStoryTreeAdapterImpl,
			IID_ITREEVIEWWIDGETMGR, kKCMStoryTreeWidgetMgrImpl,
			IID_IEVENTHANDLER, kKCMStoryTreeEHImpl,
		}
	},

	// One row of that list. The stock tree node already handles what a row IS (selection, keyboard);
	// the one interface added says where a click on it GOES - single click scrolls the story into
	// view, double click selects the whole story (KCMStoryRowEH.cpp).
	// ★The three cells inside the row are static text and do not consume clicks, so a press anywhere
	//   along the row reaches this handler.
	// ★★THE LINE BETWEEN ROWS IS THE FRAMEWORK'S, AND IT STAYS. DVTreeNodeControlView draws a
	//   separator under every row taller than 14px on its own (DVTreeNodeControlView.h:55), which is
	//   every row here. ⚠2026-08-11: it was turned off for a few minutes - a KCMStoryRowView
	//   (TreeNodeControlView subclass calling the protected SetDrawNodeSeparatorOnOff(kFalse), the
	//   way the product's TimingPanelTreeNodeView.cpp does it) was written, built and then removed,
	//   because seeing it without the lines settled the question: **the user finds the list easier to
	//   read WITH them**. Kept here so that nobody re-derives the same removal from the same premise.
	Class
	{
		kKCMStoryRowWidgetBoss,
		kTreeNodeWidgetBoss,
		{
			IID_IEVENTHANDLER, kKCMStoryRowEHImpl,
		}
	},

	// The THREE cells inside that row - UID, story text, kind (the UID column was added 2026-08-10;
	// this comment said "two" until 2026-08-18, bug recheck B-U1, while the row boss 18 lines above
	// already said three). ★The ONLY thing this boss changes is the tooltip, and it
	// changes it to nothing. A stock static text pops its full string up whenever the cell had to
	// shorten it (kStaticTextWidgetBoss carries IID_ITIP = kTextWidgetTipImpl - read off the live
	// boss dump), which is a kindness on a dialog label and a nuisance on a list the pointer only
	// crosses on its way somewhere (user's call, 2026-08-10). An inherited interface cannot be
	// removed, so it is answered differently instead: ITip.h:37-41 defines an empty string as
	// "no tip". Implementation: KCMNoTip.cpp.
	Class
	{
		kKCMStoryRowCellBoss,
		kInfoStaticTextWidgetBoss,
		{
			IID_ITIP, kKCMNoTipImpl,
		}
	},

	// ★★★2026-08-23: THE JUMP MARKER AND ITS TIMER MOVED TO THE MODEL PLUG-IN (see KCM.fr).
	//   They were kKCMStoryMarkerBoss (kKCMUIPrefix + 30) and kKCMStoryMarkerExpiryBoss (+ 31),
	//   with implementations at + 41 and + 42.
	//   The reason is one measured fact: **the UI's File > Export > PDF runs in the background, and
	//   a kUIPlugIn is never handed the drawing there** (2026-08-12, no warning - the plug-in simply
	//   "behaves as if it were not there"). ⇒ Marks drawn from this side could never appear in an
	//   exported PDF, whatever their print guard said. A global text adornment is declared as a
	//   SERVICE and the registry resolves services in every execution context, background threads
	//   included, so moving it was the whole fix.
	//   ⚠THE FOUR IDS STAY VACANT. They are not reused and the numbering is not closed up - only
	//     the values have to be unique ([[id-prefix-256-slot-budget]]).

	// The text cell of a CHANGE row (2026-08-20): a generic panel widget whose IControlView is our
	// own, plus the three text pieces it paints. ★It exists because a stock static text draws its
	// whole string in ONE colour, and this cell has to draw the changed characters at the theme's
	// text colour with the words around them faded toward the background (user's request: "follow
	// KBS"). Same construction as KBS's kKBSColorTextWidgetBoss, which highlights a search hit
	// the same way, and as the scroll-map strip below - kGenericPanelWidgetBoss plus one view.
	// ★No IID_ITIP here, unlike the cell above: a generic panel has no tooltip to silence, so the
	//   silence these rows were given in 2026-08-10 comes free.
	Class
	{
		kKCMStoryChangeCellBoss,
		kGenericPanelWidgetBoss,
		{
			IID_ICONTROLVIEW, kKCMStoryCellViewImpl,
			IID_IKCMSTORYCELLDATA, kKCMStoryCellDataImpl,
		}
	},

	// The panel's MESSAGE AREA (2026-08-20), built the same way as the cell above and for the same
	// reason: it shows the OTHER side of the edit whose row was clicked, and "which characters
	// differ" is a question one colour cannot answer. ★It replaces a StaticMultiLineTextWidget, and
	// what that gave for free was the WRAPPING - which is written out in KCMStatusTextView.cpp
	// rather than lost, because several messages in this box are full save paths.
	// ★★It keeps the same WidgetID and the same Frame, so nothing around it moves.
	Class
	{
		kKCMStatusTextWidgetBoss,
		kGenericPanelWidgetBoss,
		{
			IID_ICONTROLVIEW, kKCMStatusTextViewImpl,
			IID_IKCMSTATUSTEXTDATA, kKCMStatusTextDataImpl,
		}
	},

	// Scroll-map strip: a thin custom-drawn widget injected at runtime next to the document
	// window's vertical scrollbar (KCMScrollMap.cpp). Same pattern as customdatalinkui's
	// kCusDtLnkUITreeCViewPanelWidgetBoss: kGenericPanelWidgetBoss + own IControlView.
	Class
	{
		kKCMScrollMapWidgetBoss,
		kGenericPanelWidgetBoss,
		{
			IID_ICONTROLVIEW, kKCMScrollMapViewImpl,
		}
	},

	// Toolbox tool for ALL KCM pointer gestures (2026-07-13: the middle-button watcher and every
	// middle-button gesture were removed; this tool is now the only pointer input). Left-hold with
	// the tool active dispatches by the modifier keys held at press time: no modifier = reveal
	// marks while held / Shift = peek the old version 100% / Shift+Alt = peek 50% / Alt = CMYK
	// readout cursor. All input goes through the capturing tracker registered below
	// (kKCMTrackerBoss, installed by kKCMTrackerRegisterBoss) - BeginTracking dispatches the
	// gesture and mouse-up ends it (KCMTracker.cpp / KCMPeekGesture.cpp). Note: an earlier design
	// note here claimed a capturing tracker froze InDesign; the real culprit was the
	// kMouseTrackerBoss timer's continuous redraws, which this tracker avoids with
	// WantTimer=kFalse. Inherits kGenericToolBoss (the standard tool base that provides the
	// toolbox button view); IID_IPMPERSIST persists the selected state.
	Class
	{
		kKCMToolBoss,
		kGenericToolBoss,
		{
			IID_ITOOL,      kKCMToolImpl,
			IID_IPMPERSIST, kPMPersistImpl,
			// The check-mark cursor, shown for as long as the tool is active (CToolCursorProvider
			// subclass; KCMCursorProvider.cpp).
			IID_ICURSORPROVIDER, kKCMCursorProviderImpl,
		}
	},

	// The KCM tool's capturing tracker. IID_ITRACKER is the tracker (reveals marks while the
	// left button is held); IID_IEVENTHANDLER (a CTrackerEventHandler subclass) forwards the
	// button-up during capture to EndTracking. Same shape as the SDK's real capturing tracker
	// (dynamicdocumentsui AnimationUIButtonTriggerTrackerBoss) - and "same shape" now means
	// exactly these two interfaces, nothing else. Why, and what used to be here:
	//
	// ★★★NO SPRITE ON THIS BOSS -- established by re-counting the whole SDK.
	//   IID_ISPRITE (kNoHandleSpriteImpl) and IID_IPATHGEOMETRY (kPathGeometryImpl) used to sit
	//   here, justified as "wavetool's kSawWaveTrackerBoss has them, so **an SDK tracker boss
	//   always has them**". **That universal was false:**
	//     * ISprite is queried by **CLayoutTracker** (AbortTracking and others) and by
	//       **CPathCreationTracker** (four places). **CTracker never touches it.**
	//     * CPathCreationTracker.h states it from the other end: if you use grid creation with that
	//       base, put IID_ISPRITE, kNoHandleSpriteImpl on the boss -- a condition **of the base**.
	//   ∴ the set to count was never "tracker bosses" but "the base class each one derives from".
	//   Of the SDK's four tracker bosses, the two that carry a sprite are wavetool's (kSawWave /
	//   kSineWave) and **both derive from CPathCreationTracker**; the two that derive from CTracker
	//   directly -- snapshot's kSnapTrackerBoss and dynamicdocumentsui's named above -- carry none.
	//   KCMTracker derives from CTracker directly, so **not having one is the shape that matches**.
	//   The old comment said keeping them stayed inside the official shape; keeping them was what
	//   departed from it -- of the four, this was the only CTracker-derived boss with a sprite.
	//   ⇒ If this is ever rebuilt as a shape-creating tracker (CPathCreationTracker), put back the
	//     set **that base's header asks for**. Never "because it is a tracker".
	Class
	{
		kKCMTrackerBoss,
		kInvalidClass,
		{
			IID_ITRACKER,      kKCMTrackerImpl,
			IID_IEVENTHANDLER, kKCMTrackerEHImpl,
		}
	},

	// Registers the tracker with the app: (layout widget, KCM tool) -> KCM tracker.
	// IID_IK2SERVICEPROVIDER (kCTrackerRegisterProviderImpl, provided by the API) lets the
	// application discover this registrar at startup.
	Class
	{
		kKCMTrackerRegisterBoss,
		kInvalidClass,
		{
			IID_ITRACKERREGISTER,   kKCMTrackerRegisterImpl,
			IID_IK2SERVICEPROVIDER, kCTrackerRegisterProviderImpl,
		}
	},

	// The cat-paw stamp tool (2026-09-04). ★A SUBTOOL of the tool above: the ToolDef further
	// down names kKCMToolBoss as its parent, which puts it in that tool's press-and-hold flyout
	// and spends no toolbox slot. The boss itself is the ordinary four-piece tool shape --
	// kGenericToolBoss supplies the button view and IID_IPMPERSIST persists the selected state,
	// exactly as for kKCMToolBoss.
	Class
	{
		kKCMPawToolBoss,
		kGenericToolBoss,
		{
			IID_ITOOL,      kKCMPawToolImpl,
			IID_IPMPERSIST, kPMPersistImpl,
			// The pink paw shown while this tool is active, with its hot spot at the paw's centre
			// so the pointer sits where the paw will land (KCMPawCursorProvider.cpp).
			IID_ICURSORPROVIDER, kKCMPawCursorProviderImpl,
		}
	},

	// That tool's tracker. IID_ITRACKER reads the press; IID_IEVENTHANDLER is the stock
	// CTrackerEventHandler shape its neighbour uses. ★Nothing is captured -- BeginTracking
	// answers kFalse -- so the event handler never carries a button-up here; it is on the boss
	// because a tracker boss is asked for one.
	// ★NO SPRITE, for the reason written out at kKCMTrackerBoss above: a sprite is a condition
	//   of CLayoutTracker / CPathCreationTracker, and this derives from CTracker directly.
	Class
	{
		kKCMPawTrackerBoss,
		kInvalidClass,
		{
			IID_ITRACKER,      kKCMPawTrackerImpl,
			IID_IEVENTHANDLER, kKCMPawTrackerEHImpl,
		}
	},

	/*
	 * The book comparison dialog (2026-08-11). Stock kDialogBoss plus our controller - the same
	 * shape as KESCL's Jump Offset dialog and the basicdialog sample.
	 *
	 * ***** It is opened MODELESS. ***** That is what lets the user keep working with the
	 * document while the results are on screen, and it is what keeps the door open for "click a
	 * row to open that chapter" (a modal dialog could never offer that). The dialog type is not
	 * declared here - it is an argument to CreateNewDialog (KCMBookDialog.cpp).
	 */
	Class
	{
		kKCMBookDialogBoss,
		kDialogBoss,
		{
			IID_IDIALOGCONTROLLER, kKCMBookDialogControllerImpl,
			// ★★2026-08-12: IID_IOBSERVER IS GONE, AND THAT IS THE FIX RATHER THAN A LOSS. It named
			//   kKCMBookDialogObserverImpl, whose whole job was the Compare button - and that
			//   button no longer exists (the comparison is confirmed in an alert and run from the
			//   menu now, KCMBookRun.cpp). What is left is a dialog with no controls at all.
			//   ⚠Naming an observer here REPLACES the stock one, and the stock one is what makes the
			//     close box work (CDialogObserver attaches to the dialog window). Removing the line
			//     hands that back to kDialogBoss, which carries IID_IOBSERVER =
			//     kCDialogObserverImpl of its own (verified in the live boss dump, Boss.txt:4902).
			//     The alternative - keeping a subclass that only forwards to its base - would have
			//     been a file, an ImplementationID and a registration that all say nothing.
		}
	},

	// The chapter list inside that dialog. Same two interfaces as the Story Edits list, for the
	// same reason: kTreeViewWidgetBoss already brings the controller and the event handling, so a
	// flat list only has to say what the rows ARE and how they are DRAWN.
	// ★No IID_IEVENTHANDLER here. The panel's list has one because its rows can be walked with the
	//   arrow keys; this list is not walked - there is nowhere to go yet. It arrives with the row
	//   click, not before.
	Class
	{
		kKCMBookTreeWidgetBoss,
		kTreeViewWidgetBoss,
		{
			IID_ITREEVIEWHIERARCHYADAPTER, kKCMBookTreeAdapterImpl,
			IID_ITREEVIEWWIDGETMGR, kKCMBookTreeWidgetMgrImpl,
		}
	},

	// One row of that list. The stock tree node handles what a row IS - selection, highlight,
	// keyboard - and this adds the one thing it cannot know: what a CHAPTER row means when it is
	// clicked. ★That is the single line this boss was created empty for (2026-08-11), and it went
	// in on 2026-08-12 exactly as planned - no change of type in the resource, which is the part
	// that is easy to get wrong. The Story Edits row went through the same two steps.
	//   double click -> open that chapter        right click -> the row menu ("Start Change Marker")
	// Implementation: KCMBookRowEH.cpp (which click is which) / KCMBookOpen.cpp (what it does).
	Class
	{
		kKCMBookRowWidgetBoss,
		kTreeNodeWidgetBoss,
		{
			IID_IEVENTHANDLER, kKCMBookRowEHImpl,
		}
	},

	// The two cells inside that row. As on the panel's list, the only thing this boss changes is
	// the tooltip, and it changes it to nothing: a stock static text pops its full string up
	// whenever the cell had to shorten it, which is a kindness on a dialog label and a nuisance on
	// a list the pointer only crosses on its way somewhere (user's call, 2026-08-10, about the
	// panel's list - the same list, in a different window). ITip.h:37-41 defines an empty string as
	// "no tip"; implementation KCMNoTip.cpp, shared with the panel.
	Class
	{
		kKCMBookRowCellBoss,
		kInfoStaticTextWidgetBoss,
		{
			IID_ITIP, kKCMNoTipImpl,
		}
	},

	// ***** A STATIC TEXT THAT DOES NOT GROW TO FIT ITS TEXT. ***** (2026-08-15) The dialog's
	// Target:/Source: lines carry a full path, and that made the whole window as wide as the path:
	// 593px measured, against the 400 its frames ask for.
	//
	// ★WHY THE FRAMES DID NOT HOLD IT. The guide is explicit - "we treat the width in the .fr file
	//   as a MINIMUM width" (Using EVE, Example 2), and EVE "automatically resizes static text,
	//   buttons, check boxes, radio buttons and drop-down lists" to fit their labels. So 364 in the
	//   frame is a floor, never a ceiling.
	// ⚠ kEVEAlignFill does not stop it either, and the older comments that said it did were wrong:
	//   Fill means "take the PARENT's width", and the parent is itself grown by the child that asks
	//   for more. Fill decides how the space is shared, not how much there is.
	//
	// ★THE HANDLE IS IID_IEVEINFO: EVE asks a widget's own EveInfo implementation for its size, so a
	//   widget that must not be measured names an implementation that answers "the size the resource
	//   wrote" - kFixedSizeEVEInfoImpl. That is also what the guide means when it says the few
	//   widgets that cannot measure themselves "still need appropriate bottom (height) and right
	//   (width) values in the FRAME directive": with this implementation the frame IS the answer.
	//   Same handle KBS uses for its glyph frame (KBS.fr:289-293).
	// ⇒ The widget's own kEllipsizeBeginning finally has something to do, so the path is shortened
	//   BY THE WIDGET - which is how the panel's Target:/Source: lines have always done it, and the
	//   point of the change (user, 2026-08-15: "make the paths match the way the panel puts them out").
	Class
	{
		kKCMBookPathTextWidgetBoss,
		kStaticTextWidgetBoss,
		{
			IID_IEVEINFO, kFixedSizeEVEInfoImpl,
		}
	},
}}};

/*  
 * Implementation definition.
 */
resource FactoryList (kSDKDefFactoryListResourceID)
{
	kImplementationIDSpace,
	{
		#include "KCMUIFactoryList.h"
	}
};


/*
 * Menu definition: the About Plug-ins entry (main menu) and the "About this plug-in" entry on
 * the panel's flyout (popup) menu. The panel itself appears under the Window menu automatically
 * (registered via the PanelList resource below), so no menu entry is needed for showing it.
 */
resource MenuDef (kSDKDefMenuResourceID)
{
	{
		// About Plug-ins sub-menu item.
		kKCMAboutActionID,
		kKCMAboutMenuPath,
		kSDKDefAlphabeticPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// ("Split Target on Start" was removed 2026-07-04; mechanism preserved in
		//  docs/ai-notes/kescm-split-target-mechanism.md and git history 69c4b07.)

		// "Start / Stop" at the top of the panel flyout (popup) menu. Starts a comparison
		// (idle) or stops/clears it (armed). This replaces the former Start/Stop panel button
		// (2026-07-10). The label switches between "Start" and "Stop" via UpdateActionStates
		// (kCustomEnabling + SetNthActionName) based on the shared armed state.
		kKCMPopupStartStopActionID,
		kKCMPopupMenuPath,
		kKCMStartStopMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Set as Target" / "Set as Source" on the panel flyout (popup) menu, directly below
		// Start. Each makes the ACTIVE document the comparison's Target / Source, so that which
		// two documents are compared is stated rather than inferred from what is in front. Live
		// only while nothing is being compared (UpdateActionStates, kCustomEnabling). Whichever
		// is not set still falls to the old automatic rule at the Start.
		kKCMPopupSetTargetActionID,
		kKCMPopupMenuPath,
		kKCMSetTargetMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKCMPopupSetSourceActionID,
		kKCMPopupMenuPath,
		kKCMSetSourceMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Separator below Start (path ending in ":-" renders a menu separator; no ActionDef needed).
		kKCMPopupSep1ActionID,
		kKCMPopupMenuPath kSDKDefDelimiterAndSeparatorPath,
		kKCMSep1MenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Print comparison marks" on the panel flyout (popup) menu. Check-mark toggle:
		// while ON, the comparison marks are printed (and stay visible on screen); OFF is
		// screen-only. This replaces the former panel checkbox (2026-07-10). The check mark
		// comes from UpdateActionStates (kCustomEnabling). Opacity still follows the 25%/75% radios.
		kKCMPopupPrintMarksActionID,
		kKCMPopupMenuPath,
		kKCMPrintMarksMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// ("Hold to Hide Marks" stood here until 2026-08-22. It meant "keep the marks up, and hide
		//  them while the button is held" — and once "Always Show Marks on Target" existed, the first half
		//  of that was the same switch twice over. The second half is now what BOTH "Show Marks on"
		//  toggles do while the button is held, so the rule is one line: **while the button is held,
		//  that window is the other way round**. Menu position 9.20 is free; ActionID +19 is not to
		//  be reused.)

		// "Marks opacity" submenu containing "25%" and "75%". The two children act as a radio pair
		// (mutually exclusive): UpdateActionStates (kCustomEnabling) puts the check mark on whichever
		// opacity is currently selected. Replaces the former panel opacity radios (2026-07-10). The
		// opacity applies to the middle-button display, the always-on screen display while printing is
		// ON, and the print output.
		// Submenu parent node: actionID 0 + path ending in a delimiter creates the "Marks opacity"
		// submenu at this position in the flyout (Adobe idiom, see buttonui/incopyexportui .fr).
		0,
		kKCMOpacitySubmenuPath kSDKDefDelimitMenuPath,
		kKCMOpacitySubmenuMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKCMPopupOpacity25ActionID,
		kKCMOpacitySubmenuPath,
		kKCMOpacity25SubMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKCMPopupOpacity75ActionID,
		kKCMOpacitySubmenuPath,
		kKCMOpacity75SubMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Mark colour" (2026-08-24). Two children, exclusive, check on whichever is in force -
		// exactly the shape of "Marks opacity" above. ★It replaces an AUTOMATIC choice: the rings
		// used to switch to cyan by themselves over reddish grounds, decided per pixel off the
		// comparison raster. The Story mode's wash cannot read the ground at all, so leaving the
		// automatic rule in place would have made the two modes disagree about colour.
		0,
		kKCMColorSubmenuPath kSDKDefDelimitMenuPath,
		kKCMColorSubmenuMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKCMPopupColorRedActionID,
		kKCMColorSubmenuPath,
		kKCMColorRedSubMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKCMPopupColorCyanActionID,
		kKCMColorSubmenuPath,
		kKCMColorCyanSubMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Compare mode" on the panel flyout (popup) menu (2026-08-20). Two children, exclusive,
		// with a check on whichever one is in force - the same shape as "Marks opacity" above.
		// Pixel Changes rasterises pages and compares them; Story Changes compares the text of the
		// stories and lists what differs, and draws no rings at all.
		// Submenu parent node: actionID 0 + path ending in a delimiter, as above.
		0,
		kKCMCompareModeSubmenuPath kSDKDefDelimitMenuPath,
		kKCMCompareModeSubmenuMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKCMPopupModePixelActionID,
		kKCMCompareModeSubmenuPath,
		kKCMModePixelSubMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKCMPopupModeStoryActionID,
		kKCMCompareModeSubmenuPath,
		kKCMModeStorySubMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Always Show Marks on Source" on the panel flyout (popup) menu. Check-mark toggle:
		// while ON, the same comparison rings are also drawn on the corresponding pages of the
		// Source document — always visible (independent of the middle button), shown in
		// overprint preview, and always printed. Opacity follows the panel's 25%/75% radio.
		// Remembered in Save Panel Settings and restored at startup; Start does not touch it.
		kKCMPopupShowSrcMarksActionID,
		kKCMPopupMenuPath,
		kKCMShowSrcMarksMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Always Show Marks on Target" on the panel flyout (popup) menu. Check-mark toggle:
		// while ON, the Target document keeps its marks WITHOUT the tool's button being held —
		// the Pixel mode's comparison rings and the Story mode's washed characters alike.
		// Opacity follows the panel's 25%/75% radio.
		// On screen only: what the Target document PRINTS is decided by "Print comparison marks"
		// on its own, which is the one asymmetry with the Source toggle above (that one prints).
		// Remembered in Save Panel Settings and restored at startup; Start does not touch it.
		kKCMPopupShowTgtMarksActionID,
		kKCMPopupMenuPath,
		kKCMShowTgtMarksMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Hide Unchanged Spreads" on the panel flyout (popup) menu. Check-mark toggle:
		// turning it ON asks for confirmation (this DOES modify/dirty the documents), then hides
		// every spread that has no comparison marks via kHideSpreadCmdBoss — in the Target and,
		// by flat-page-index mapping, in the Source document too. Turning it OFF re-shows only
		// the spreads this plug-in hid (in both documents).
		kKCMPopupHideUnchangedActionID,
		kKCMPopupMenuPath,
		kKCMHideUnchangedMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Show Original Page Numbers" on the panel flyout (popup) menu. Check-mark toggle:
		// while ON, pages whose live page-number markers shifted because of hidden spreads get a
		// badge with the original (pre-hide) page number at the bottom center, whenever the
		// comparison marks are visible (middle button held, or "Print comparison marks" ON —
		// the latter also prints the badge).
		kKCMPopupShowOldNumsActionID,
		kKCMPopupMenuPath,
		kKCMShowOldNumsMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Sync Layout Views" on the panel flyout (popup) menu. Check-mark toggle: while ON,
		// scrolling/zooming any layout view mirrors its viewport (position + zoom) to all layout
		// views of the other documents, live. Works without Start.
		kKCMPopupSyncViewsActionID,
		kKCMPopupMenuPath,
		kKCMSyncViewsMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Translucent Panel" on the panel flyout (popup) menu. Check-mark toggle (default OFF):
		// while ON, this panel itself is drawn translucent (alpha = kKCMPanelAlphaValue, 77 out of 255;
		// it was 128 until 2026-07-29) whenever it is FLOATING or pulled out as an icon DRAWER - those
		// are the two states that get their own top-level window. Moving the pointer over the panel
		// (including its tab strip and title bar) turns it opaque again.
		// Windows only. Choosing it while the panel is docked is allowed but has no visible effect
		// (only the flag is stored; it takes hold as soon as the panel floats again), because a
		// docked panel is a child of the main frame and cannot be made transparent on its own.
		// Implementation: KCMPanelAlpha.cpp.
		kKCMPopupTranslucentPanelActionID,
		kKCMPopupMenuPath,
		kKCMTranslucentPanelMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Translucent Pages Panel" on the panel flyout (popup) menu. Check-mark toggle (default OFF).
		// Exactly the toggle above, but the target is InDesign's OWN Pages panel instead of this one
		// (user request, 2026-08-06). Same alpha, same "opaque again while the pointer is over it"
		// behaviour, same "floating or drawer only" limitation.
		// ★Why this became possible: the panel's window is now found from its WidgetID
		// (kPagesPanelWidgetID, a NUMBER) through IPanelMgr -> PaletteRef::GetOWLControl, instead of by
		// matching the window title. Titles are translated - the Pages panel reads "Pages" on an English
		// UI and "ページ" on a Japanese one (both measured on this machine, 2026-08-06) - so the old
		// title-matching lookup could never have worked for a built-in panel.
		// Implementation: KCMPanelAlpha.cpp (shared with the toggle above; only the target differs).
		kKCMPopupTranslucentPagesActionID,
		kKCMPopupMenuPath,
		kKCMTranslucentPagesPanelMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Translucent Dialog" on the flyout - the same toggle again, pointed at THIS plug-in's book
		// comparison dialog (user request, 2026-08-13: "make it so the dialog can be translucent too").
		// ⚠The ID and this file's identifiers say "BookDialog", but the LABEL the user reads is
		//  "Translucent Dialog" (KCMUI_enUS.fr:50) - it was shortened and the names were not. Do not
		//  quote the identifier as the menu text (checked 2026-08-16, audit B-U1).
		// ★What is shared: the alpha value, the "opaque again while the pointer is over it" behaviour,
		//   the delayed re-apply and the Win32 hook. All of it, unchanged.
		// ★What is different, and it is only this: WHERE THE WINDOW COMES FROM. The two toggles above
		//   ask the panel manager by WidgetID; a dialog is not a panel and is not in there, so the
		//   dialog hands its window over as it opens (KCMBookDialog.cpp -> KCMSetBookDialogWindow).
		// ★A consequence worth knowing: a dialog is always floating, so unlike the two above this one
		//   has no "you can tick it but it does nothing while docked" state.
		kKCMPopupTranslucentBookDialogActionID,
		kKCMPopupMenuPath,
		kKCMTranslucentBookDialogMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// ("Translucent Toolbox" was added on 2026-08-07 and taken out again the same day: a KCM
		// toggle is not the place to change how InDesign's OWN toolbox looks. It needed only one more
		// target to work, which is itself evidence that this mechanism does not care WHICH palette it
		// is pointed at; the measured window structure is kept in memory/translucent-toolbox-idea.md.
		// Its ActionID (+38) stays retired - see KCMUIID.h.)

		// "Align Other Views to Active" on the panel flyout (popup) menu. Plain command (not a toggle):
		// sets every OTHER document's layout views to the active (frontmost) view's position + zoom, once.
		// Independent of the Sync Layout Views toggle (works even when it is OFF). While Started, the page
		// Add/Remove correction is applied so the compared pages line up. Shortcut-assignable (its ActionDef
		// uses kKCMPanelMenuActionArea + kSDKDefVisibleInKBSCEditorFlag).
		kKCMPopupAlignViewsActionID,
		kKCMPopupMenuPath,
		kKCMAlignViewsMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Show Scrollbar Map" on the panel flyout (popup) menu. Check-mark toggle (default ON):
		// while ON, a thin strip beside each document window's vertical scrollbar maps the positions
		// of changed / registered pages. Turn it OFF to remove the strip from all windows.
		kKCMPopupScrollMapActionID,
		kKCMPopupMenuPath,
		kKCMScrollMapMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// ("Show HUD" was removed together with the on-press HUD itself on 2026-08-06.)

		// "Ignore Page Number Marker" on the panel flyout (popup) menu. Check-mark toggle (default OFF,
		// see sIgnorePageNumberMarker in KCMPageNumberMarker.cpp): while ON, frames containing an
		// automatic "Current Page Number" marker are excluded from the pixel comparison, so pages whose
		// only difference is a shifted running folio (caused by registered added/removed pages
		// elsewhere) aren't falsely flagged as changed.
		kKCMPopupIgnorePageNumActionID,
		kKCMPopupMenuPath,
		kKCMIgnorePageNumMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Separator below "Refresh Overset" (path ending in ":-" renders a menu separator; no ActionDef
		// needed). Its place in the flyout is kKCMSep3MenuItemPosition in KCMUIID.h.
		kKCMPopupSep3ActionID,
		kKCMPopupMenuPath kSDKDefDelimiterAndSeparatorPath,
		kKCMSep3MenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Save Panel Settings" on the panel flyout (popup) menu. Not a check toggle: a plain command
		// that writes the current "settings" toggles to a private JSON file in the user's roaming
		// preferences folder (KCM\KCMPanelState.json) and shows the saved path. The file is read
		// back the first time the panel is opened (KCMPanelState.cpp). Nothing is written into
		// InDesign's own data (workspace SavedData / documents).
		kKCMPopupSavePanelStateActionID,
		kKCMPopupMenuPath,
		kKCMSavePanelStateMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Save Check & Register" on the panel flyout (popup) menu. Plain command that writes the current
		// per-page checks (Check) and registered Added/Removed pages of the started Target/Source
		// documents to a private JSON file (KCM\KCMPageChecks.json, v2), merged with any previously saved
		// documents. Shows the saved path.
		kKCMPopupSaveChecksActionID,
		kKCMPopupMenuPath,
		kKCMSaveChecksMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Load Check & Register" on the panel flyout (popup) menu. Plain command; only meaningful while started.
		// Applies the saved registered pages to both documents, recompares once, then restores the saved checks
		// whose pages are still marked (frame/"/").
		kKCMPopupLoadChecksActionID,
		kKCMPopupMenuPath,
		kKCMLoadChecksMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Export Changed Pages..." on the panel flyout (popup) menu. Plain command (not a toggle):
		// writes the current comparison's changed-page list to a tab-separated UTF-8 text file
		// (2 columns: Page / Type, where Type = Changed / Inserted / Deleted) for pasting into
		// Excel. Overset is never included. Enabled only while a comparison is active (sDB != nil);
		// UpdateActionStates supplies the enable state (kCustomEnabling). Work in KCMChangedPagesTSV.cpp.
		kKCMPopupExportChangedPagesActionID,
		kKCMPopupMenuPath,
		kKCMExportChangedPagesMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Compare Books" on the panel flyout. Plain command. Compares TWO OPEN BOOKS chapter by
		// chapter and reports, per chapter, whether anything changed - it does not draw rings and
		// does not arm anything, so it can be run while a document comparison is active.
		// Target is the book whose tab is in FRONT in the Book panel; source is the first other
		// open book. Enabled only when both can be resolved (kCustomEnabling; UpdateActionStates
		// runs the same resolver the action itself uses). Work in KCMBookCompare.cpp.
		kKCMPopupCompareBooksActionID,
		kKCMPopupMenuPath,
		kKCMCompareBooksMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Separator above the Find Overset group (independent single-doc overset check).
		kKCMPopupOversetSepActionID,
		kKCMPopupMenuPath kSDKDefDelimiterAndSeparatorPath,
		kKCMOversetSepMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Find Overset" on the panel flyout (popup) menu. Check-mark toggle (independent of the
		// new/old comparison): while ON, the ACTIVE document is scanned and a large red cross ("+")
		// is drawn on every page that contains overset (overflowing) text. The check mark comes from
		// UpdateActionStates (kCustomEnabling). Screen-only. The work is in KCMOversetScan.cpp.
		kKCMPopupFindOversetActionID,
		kKCMPopupMenuPath,
		kKCMFindOversetMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Refresh Overset" on the panel flyout (popup) menu. Plain command that re-scans the active
		// document and refreshes the crosses. Enabled only while "Find Overset" is ON (greyed out
		// otherwise) - UpdateActionStates supplies the enable state (kCustomEnabling).
		kKCMPopupRefreshOversetActionID,
		kKCMPopupMenuPath,
		kKCMRefreshOversetMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Separator above How to Use (path ending in ":-" renders a menu separator; no ActionDef needed).
		kKCMPopupSep2ActionID,
		kKCMPopupMenuPath kSDKDefDelimiterAndSeparatorPath,
		kKCMSep2MenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "How to Use" on the panel flyout (popup) menu.
		kKCMPopupUsageActionID,
		kKCMPopupMenuPath,
		kKCMUsageMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// (The "About scripting" flyout item was removed: the scripting API it announced was already
		//  gone, so the item did nothing but say "No scripts are currently available."
		//  Its kKCMPopupAboutScriptActionID (**kKCMUIPrefix + 3** -- this is the UI half) stays
		//  reserved.)

		// "About this plug-in" on the panel flyout (popup) menu (shown last).
		kKCMPopupAboutThisActionID,
		kKCMPopupMenuPath,
		kKCMAboutThisMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Separator above the KCM-added items on the Pages panel page context menu (path ending
		// in ":-" renders a menu separator; no ActionDef needed). It groups KCM's own items
		// (Register / Check) apart from the built-in Pages panel menu items so they read clearly as
		// "KCM's". Positioned just above Register (2999.0 < 3000.0), i.e. between the native items
		// and the KCM block.
		kKCMPageMapSepActionID,
		"RtMenuPagesPanel" kSDKDefDelimiterAndSeparatorPath,
		kKCMPageMapSepMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Register as Added/Removed Pages" on the Pages panel page context menu.
		// Check-mark toggle: registers/unregisters the selected pages as "pages with no
		// comparison counterpart" (added pages in the Target, removed pages in the Source —
		// same concept either way). The check mark, enable state and the dynamic label
		// (Added vs Removed, per the document's role) come from UpdateActionStates
		// (kCustomEnabling); the actual work is in KCMPageMap.cpp.
		// "RtMenuPagesPanel" is the untranslated internal menu name of the right-click menu on
		// page icons in the Pages panel (verified live 2026-07-05 via app.menus + FindKeyStrings;
		// same style as the csxsdemo sample's "RtMouseLayout"). Untranslated keys are
		// locale-independent, so this works on English/Japanese/any-language InDesign.
		kKCMPageMapToggleActionID,
		"RtMenuPagesPanel",
		kKCMPageMapToggleMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Check" on the Pages panel page context menu. Check-mark toggle: marks/unmarks the
		// selected pages with a blue check (✓) drawn on their Pages-panel thumbnails. Independent of
		// the Added/Removed registration. Only available while Started (armed) with the selected doc
		// being Target/Source; cleared on Stop. Check state / enabling come from UpdateActionStates
		// (kCustomEnabling); the work is in KCMPageCheck.cpp and the ✓ drawing in KCMDrawEventHandler.
		kKCMPageCheckToggleActionID,
		"RtMenuPagesPanel",
		kKCMPageCheckMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Refresh Page Comparison" on the Pages panel page context menu. Plain command
		// (not a toggle): re-runs the comparison for the selected page(s) and updates the marks /
		// thumbnails (formerly the Ctrl+middle spread recompare, moved to this menu 2026-07-13).
		// Only available while Started (armed) with the front document being Target/Source; enabling
		// comes from UpdateActionStates (kCustomEnabling). The work is in KCMPeek.cpp.
		kKCMPageRefreshCompareActionID,
		"RtMenuPagesPanel",
		kKCMPageRefreshCompareMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// ----- The book comparison dialog's chapter rows: right-click menu (2026-08-12) -----
		// A menu of its own - neither the panel flyout nor a built-in InDesign menu - so its path is
		// a name nobody else uses and it is written last, after the menus above have been laid out.
		// It is popped at the cursor by the row's event handler
		// (KCMBookRowEH::RButtonDn -> IMenuManager::HandlePopupMenu with this subtree's name),
		// which is the machinery the real Links / Layers panel row menus use, and the one KBS's
		// result rows and KESCL's report rows are built on.
		//
		// "Start Change Marker": open BOTH sides of that chapter and run the document comparison on
		// them, stopping whatever comparison was running first. It is the step that turns a verdict
		// in this list ("ch05 Changed") into the marks that say WHERE - and it belongs on the row
		// rather than on the flyout for the same reason KBS moved Check All here: a flyout has no
		// row to ask about. ★Enabled ONLY on a row whose verdict is Changed and which names both of
		// its files (kCustomEnabling -> KCMBookRowCanStart) - so NoChange, Failed, NotCompared and
		// the one-sided chapters are all greyed too. ⚠Being the only item in this menu, greyed means
		// the menu does not appear at all, which is the intended behaviour.
		kKCMBookRowStartActionID,
		kKCMBookRowMenuName,
		kKCMBookRowStartMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// ----- The Story Edits rows: right-click menu (2026-08-21) -----
		// A second menu of its own, on the same machinery as the chapter rows above
		// (KCMStoryRowEH::RButtonDn -> IMenuManager::HandlePopupMenu with this subtree's name).
		//
		// "Refresh Story Comparison": compare THAT ROW'S story against the older document again and
		// replace what hangs under it. The reader edits the newer document with the panel open, and
		// the row goes on showing what differed when the comparison ran - this brings one row up to
		// date without re-running the comparison over the whole document.
		// ★A row whose text has been brought back into agreement keeps its row and loses its
		// children: the question is "what differs now", not "does this row still belong here"
		// (user's call, 2026-08-21 - and see KCMStoryDiffRun.h for why the change counters could
		// not answer the second question anyway).
		// ★Enabled ONLY in the Story mode, while armed, on a row that has a partner to compare
		// against (kCustomEnabling -> KCMStoryRowCanRefresh). ⚠Being the only item in this menu,
		// greyed means the menu does not appear at all - which is exactly what "only in the Story
		// mode" asks for.
		kKCMStoryRowRefreshActionID,
		kKCMStoryRowMenuName,
		kKCMStoryRowRefreshMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,
	}
};

/*
 * Action definition for the menu items above.
 */
