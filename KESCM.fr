#include "VCPlugInHeaders.h"

// General includes:
#include "MenuDef.fh"
#include "ActionDef.fh"
#include "ActionDefs.h"
#include "AdobeMenuPositions.h"
#include "LocaleIndex.h"
#include "PMLocaleIds.h"
#include "StringTable.fh"
#include "ObjectModelTypes.fh"
#include "ShuksanID.h"
#include "ActionID.h"
#include "CommandID.h"
#include "WorkspaceID.h"
#include "WidgetID.h"
#include "BuildNumber.h"
#include "PlugInModel_UIAttributes.h"

// Panel / widget resources:
#include "PanelList.fh"
#include "Widgets.fh"				// PalettePanelWidget and the standard control widgets
// Splitter constants (kFirstWidgetIsTop / kHorizontalSplitter / kDontSnapSlider / ...). Reached by a
// relative path on purpose: this header lives under source/open, and the ODFRC response file that
// feeds this build lists ONLY source/public directories - it is generated, sits outside the repo,
// and has no counterpart in _buildproj, so a -i added there would not survive. The path is relative
// to this .fr, which is how the preprocessor resolves quoted includes.
#include "../../open/includes/ui/SplitterPanelDefs.h"
#include "InterfaceColorDefines.h"
#include "IControlViewDefs.h"
#include "SysControlIds.h"

// (SpreadID.h / DocFrameworkID.h were only here for the old scripting API, which is gone -
//  removed 2026-08-05. Everything below resolves from ShuksanID.h / widgetid.h / GraphicsID.h
//  and the tool headers.)
// AppFrameworkID.h came back on 2026-08-06 with app.kcmStatus: it defines
// kApplicationObjectScriptElement, the object the property is put on. The official scripting
// sample credits this header with exactly that (BPI.fr:55).
#include "AppFrameworkID.h"
// ScriptInfoTypes.fh came back on 2026-08-06: a toolbox tool has to register its ScriptID in
// kToolBoxEnumScriptElement (ITool.h:192-223) - that is the tool's identity, not a scripting API.
// This single header is enough for the resource at the end of this file: it also pulls in
// ScriptingID.h (kCoreScriptManagerBoss) and defines kCS5ScriptVersion.
#include "ScriptInfoTypes.fh"	// VersionedScriptElementInfo / Enumerator
// DocumentID.h came back on 2026-08-06 for a different reason than the old scripting API: the
// close-document responder boss names the API's OWN service provider implementation instead of
// carrying a hand-written one (see that Class below).
#include "DocumentID.h"	// kAfterCloseDocSignalRespServiceImpl
#include "GraphicsID.h"	// for IID_IDRWEVTHANDLER / IID_ISPRITE / IID_IPATHGEOMETRY / kPathGeometryImpl
#include "TipsID.h"		// for IID_ITIP

// Toolbox tool:
#include "Tool.fh"			// ToolDef resource type
#include "ToolBoxDefs.h"	// tool group / tool number constants (kSixthAdobeToolsGroup, kFirstAdobeTool, kDoesNotApply)
#include "ToolboxID.h"		// kGenericToolBoss
#include "LayoutUIID.h"		// kPointerToolBoss (ToolDef tool type)
#include "CursorID.h"		// IID_ICURSORPROVIDER (tool cursor provider)
#include "Cursor.fh"		// PNGC / SVGC / HOTC resource types (cursor image and hotspot)
#include "CursorDefs.h"	// kHIDPICrsrOffset / kHIDPI150CrsrOffset(2x / Win 1.5x のカーソルID)
#include "IconPNGDefs.h"	// kHIDPIIconOffset/kHIDPIIconOffset150(ツール専用アイコンの2x/Win1.5x)

// Project includes:
#include "KESCMID.h"
#include "KESCMScriptingDefs.h"	// en_KESCMTool (the toolbox tool's ScriptID)
// (GenericID.h / TextID.h and a duplicate ShuksanID.h were scripting-era leftovers with no
//  remaining reference in this file - removed 2026-08-05.)


#ifdef __ODFRC__

/*  
 * Plugin version definition.
 */
resource PluginVersion (kSDKDefPluginVersionResourceID)
{
	kTargetVersion,
	kKESCMPluginID,
	kSDKDefPlugInMajorVersionNumber, kSDKDefPlugInMinorVersionNumber,
	kSDKDefHostMajorVersionNumber, kSDKDefHostMinorVersionNumber,
	kKESCMCurrentMajorFormatNumber, kKESCMCurrentMinorFormatNumber,
	{ kInDesignProduct },
	{ kWildFS },
	kUIPlugIn,
	kKESCMVersion
};

/*  
 * The ExtraPluginInfo resource adds extra information to the Missing Plug-in dialog
 * that is popped when a document containing this plug-in's data is opened when
 * this plug-in is not present. These strings are not translatable strings
 * since they must be available when the plug-in isn't around. They get stored
 * in any document that this plug-in contributes data to.
 */
resource ExtraPluginInfo(1)
{
	kKESCMCompanyValue,			// Company name
	kKESCMMissingPluginURLValue,	// URL 
	kKESCMMissingPluginAlertValue,	// Missing plug-in alert text
};

/* 
 * Boss class definitions.
 */
resource ClassDescriptionTable(kSDKDefClassDescriptionTableResourceID)
{{{
	Class
	{
		kKESCMDrawEventServiceBoss,
		kInvalidClass,
		{
			IID_IK2SERVICEPROVIDER, kKESCMDrawEventSrvcImpl,
			IID_IDRWEVTHANDLER,     kKESCMDrawEventHandlerImpl,
		}
	},

	// Startup/shutdown service. The middle-button watcher was removed (2026-07-13); this now only
	// tears down held resources at app shutdown (see KESCMPeekStartup in KESCMPeek.cpp).
	Class
	{
		kKESCMPeekStartupBoss,
		kInvalidClass,
		{
			IID_ISTARTUPSHUTDOWN,   kKESCMPeekStartupImpl,
			IID_IK2SERVICEPROVIDER, kLazyStartupShutdownProviderImpl,
		}
	},

	// Action component: handles the About menu items (main menu + panel flyout).
	Class
	{
		kKESCMActionComponentBoss,
		kBaseActionComponentBoss,
		{
			IID_IACTIONCOMPONENT, kKESCMActionComponentImpl,
		}
	},

	// The ChangeMarker control panel (palette). The observer drives the Prev/Next buttons and the
	// status text/icon (the Start/print/opacity controls moved to the flyout menu, 2026-07-10);
	// the popup (flyout) menu data hosts the flyout menu itself.
	Class
	{
		kKESCMPanelWidgetBoss,
		kPalettePanelWidgetBoss,
		{
			IID_IPANELMENUDATA, kCPanelMenuDataImpl,
			IID_IOBSERVER, kKESCMPanelObserverImpl,
			// Roll-over: undim the panel while the pointer is over it (verified on the whole
			// panel area, 2026-07-29). Note that IMouseRollOver has no usage example anywhere
			// in the SDK; besides this AddIn it needs CREATE_PMINTERFACE *and* an entry in
			// KESCMFactoryList.h - a missing factory entry fails completely silently.
			// Implementation: KESCMPanelAlpha.cpp.
			IID_IMOUSEROLLOVER, kKESCMPanelRollOverImpl,
		}
	},

	// Document-close responder. IResponder cleans up any of KESCM's tracked, now-closed documents.
	//
	// A boss that answers ONE signal does not need a ServiceProvider of its own: naming the API's
	// kAfterCloseDocSignalRespServiceImpl (DocumentID.h) registers this responder for that signal.
	// CServiceProvider + HasMultipleIDs is only for a boss that answers several signals at once,
	// the shape linksui/ClosingDocumentsResponder.cpp needs for its three.
	// Same shape as spellpanel/SpellPanelClass.fr:830, transparencyeffect/TranFx.fr:280
	// ("Provided by API.") and KBS.fr:384. KESCM carried a hand-written KESCMDocServiceProvider
	// until 2026-08-06 - it did exactly what the API's implementation does.
	Class
	{
		kKESCMDocResponderServiceBoss,
		kInvalidClass,
		{
			IID_IK2SERVICEPROVIDER, kAfterCloseDocSignalRespServiceImpl,
			IID_IRESPONDER,         kKESCMDocResponderImpl,
		}
	},

	// Deferred Pages-panel thumbnail refresh. After a document close, refreshing the survivor's
	// thumbnails synchronously fails while the panel is mid-switch to the newly-active document,
	// so the close clean-up schedules this one-shot idle task (~150ms) which purges + redraws
	// once the switch has settled.
	// It takes itself off the queue by calling UninstallTask() at the end of RunTask - NOT by
	// returning kEndOfTime: CIdleTask.h:33-38 says derived tasks must not, because the task manager
	// then drops the task without going through UninstallTask, leaving fCurrentlyInstalled set and
	// making every later InstallTask a silent no-op.
	Class
	{
		kKESCMThumbIdleTaskBoss,
		kInvalidClass,
		{
			IID_IIDLETASK, kKESCMThumbIdleTaskImpl,
		}
	},

	// Layout view sync observer, added onto the system active-context boss (same proven pattern as
	// the user's original KESLayoutScrollObserver plug-in, which is confirmed working: an observer
	// living on kActiveContextBoss under a custom IID receives the layout views' IID_IPANORAMA
	// notifications; a free-floating observer boss did NOT receive them in practice).
	// While the flyout "Sync Layout Views" toggle is ON, this observer subscribes to the IPanorama
	// subject of every open layout view (and to the active context for document switches). Whenever
	// any view scrolls or zooms, the change is mirrored to all layout views of the OTHER documents
	// (position + zoom; same engine as Alt+middle). A re-entrancy guard suppresses the
	// notifications caused by the mirroring itself.
	AddIn
	{
		kActiveContextBoss,
		kInvalidClass,
		{
			IID_IKESCMLAYOUTSYNCOBSERVER, kKESCMLayoutSyncObserverImpl,
			// Batch-close observer (2026-07-27). Subscribes to the application subject and waits for
			// kPendingDocumentsClosedMsg, which the built-in Links UI plug-in broadcasts once every
			// document of a multi-document close has finished closing. Closing N documents used to run
			// KESCM's full close cleanup (strip detach, InvalidateViews, thumbnail refresh, panel
			// refresh) N times; now the UI half is deferred and flushed once. Lives on the same
			// active-context boss for the same proven reason as the sync observer above.
			IID_IKESCMDOCSCLOSEDOBSERVER, kKESCMDocsClosedObserverImpl,
			// Panel visibility observer (2026-07-29). Subscribes to the panel manager's subject and
			// waits for kPaletteVisibilityChangedMessage, which fires whenever a panel is opened,
			// closed or moved between docked and floating. The "Translucent Panel" toggle applies its
			// alpha to the panel's current top-level window (an OWL.Dock), and that window is thrown
			// away and recreated by those very actions - so without this the translucency would be
			// silently lost. Lives on the same active-context boss for the same proven reason as the
			// two observers above. Implementation: KESCMPanelAlpha.cpp.
			IID_IKESCMPANELVISIBILITYOBSERVER, kKESCMPanelVisibilityObserverImpl,
		}
	},

	// Subclass of the system rollover icon button used for the panel illustration
	// (kKESCMIconOnWidgetID/kKESCMIconOffWidgetID), adding IID_ITIP so hovering it shows a tooltip
	// with the repo URL (same pattern as kLinksUIButtonBoss in open/components/linksui).
	Class
	{
		kKESCMIconWidgetBoss,
		kRollOverIconButtonBoss,
		{
			IID_ITIP, kKESCMIconTipImpl,
		}
	},

	// Toggle button for the "Story Edits" section at the bottom of the panel: the same rollover
	// icon button with an observer attached, which is exactly how the product's Links panel builds
	// its Link Info toggle (kToggleLinkInfoButtonBoss in open/components/linksui). The observer
	// watches IID_ITRISTATECONTROLDATA and opens or closes the lower pane.
	Class
	{
		kKESCMStorySectionToggleBoss,
		kRollOverIconButtonBoss,
		{
			IID_IOBSERVER, kKESCMStorySectionToggleObserverImpl,
		}
	},

	// The "Story Edits" section itself - a plain panel plus one number: how tall the section was
	// when it was last closed, so the next open restores that height instead of a fixed default.
	// The interface is declared as ours but implemented by the SDK's stock kPersistIntDataImpl and
	// read through IIntData, exactly as the Links panel holds IID_ISAVEDINFOPANESIZE on its info
	// pane (LinksUIClass.fr:91). Persistent, so the height also survives quitting InDesign.
	// ★The height lives on the widget rather than in a static: the panel rebuilds its widgets every
	//   time it is re-shown, and state kept outside them is state that goes stale.
	Class
	{
		kKESCMStorySectionPanelBoss,
		kGenericPanelWidgetBoss,
		{
			IID_IKESCMSAVEDSECTIONHEIGHT, kPersistIntDataImpl,	// treat as IIntData
		}
	},

	// Scroll-map strip: a thin custom-drawn widget injected at runtime next to the document
	// window's vertical scrollbar (KESCMScrollMap.cpp). Same pattern as customdatalinkui's
	// kCusDtLnkUITreeCViewPanelWidgetBoss: kGenericPanelWidgetBoss + own IControlView.
	Class
	{
		kKESCMScrollMapWidgetBoss,
		kGenericPanelWidgetBoss,
		{
			IID_ICONTROLVIEW, kKESCMScrollMapViewImpl,
		}
	},

	// Toolbox tool for ALL KESCM pointer gestures (2026-07-13: the middle-button watcher and every
	// middle-button gesture were removed; this tool is now the only pointer input). Left-hold with
	// the tool active dispatches by the modifier keys held at press time: no modifier = reveal
	// marks while held / Shift = peek the old version 100% / Shift+Alt = peek 50% / Alt = CMYK
	// readout cursor. All input goes through the capturing tracker registered below
	// (kKESCMTrackerBoss, installed by kKESCMTrackerRegisterBoss) - BeginTracking dispatches the
	// gesture and mouse-up ends it (KESCMTracker.cpp / KESCMPeek.cpp). Note: an earlier design
	// note here claimed a capturing tracker froze InDesign; the real culprit was the
	// kMouseTrackerBoss timer's continuous redraws, which this tracker avoids with
	// WantTimer=kFalse. Inherits kGenericToolBoss (the standard tool base that provides the
	// toolbox button view); IID_IPMPERSIST persists the selected state.
	Class
	{
		kKESCMToolBoss,
		kGenericToolBoss,
		{
			IID_ITOOL,      kKESCMToolImpl,
			IID_IPMPERSIST, kPMPersistImpl,
			// ツール選択中は常時✓カーソル(CToolCursorProvider 派生)。KESCMCursorProvider.cpp。
			IID_ICURSORPROVIDER, kKESCMCursorProviderImpl,
		}
	},

	// The KESCM tool's capturing tracker. IID_ITRACKER is the tracker (reveals marks while the
	// left button is held); IID_IEVENTHANDLER (a CTrackerEventHandler subclass) forwards the
	// button-up during capture to EndTracking. Same shape as the SDK's real capturing tracker
	// (dynamicdocumentsui AnimationUIButtonTriggerTrackerBoss).
	Class
	{
		kKESCMTrackerBoss,
		kInvalidClass,
		{
			IID_ITRACKER,      kKESCMTrackerImpl,
			IID_IEVENTHANDLER, kKESCMTrackerEHImpl,
			// トラッキング中の画面更新機構。手本は sdksamples/wavetool の kSawWaveTrackerBoss
			// (WavTl.fr:151,155 / :193,197)＝**SDK のトラッカー boss はこの2つを必ず持つ**ので、
			// KESCM も同じ形に揃えてある(2つとも API 既製の実装)。
			// ★2026-08-06: 押下中 HUD を全廃したのに伴い、IID_ISPRITE の実装を自前の kKESCMSpriteImpl
			//   (CreateTrackerPaths に HUD の描画を載せていた NoHandleSprite 派生)から、SDK 標準の
			//   kNoHandleSpriteImpl へ戻した。KESCM のトラッカーは図形を作らないので sprite を自分から
			//   使うことはもう無いが、公式の boss 構成から外れないようここは残す(誰も Query しなければ
			//   実体は作られない=コストは無い)。
			IID_ISPRITE,       kNoHandleSpriteImpl,
			IID_IPATHGEOMETRY, kPathGeometryImpl,
		}
	},

	// Registers the tracker with the app: (layout widget, KESCM tool) -> KESCM tracker.
	// IID_IK2SERVICEPROVIDER (kCTrackerRegisterProviderImpl, provided by the API) lets the
	// application discover this registrar at startup.
	Class
	{
		kKESCMTrackerRegisterBoss,
		kInvalidClass,
		{
			IID_ITRACKERREGISTER,   kKESCMTrackerRegisterImpl,
			IID_IK2SERVICEPROVIDER, kCTrackerRegisterProviderImpl,
		}
	},

	/*
	 * Scripting provider: serves app.kcmStatus and nothing else. Derives from
	 * kBaseScriptProviderBoss, which brings the machinery that dispatches script requests; all this
	 * boss adds is our own handler. The property itself is declared in the
	 * VersionedScriptElementInfo resource at the end of this file. Same shape as KBS
	 * (KBS.fr:406-413), which follows the official scripting sample BPI.fr.
	 */
	Class
	{
		kKESCMScriptProviderBoss,
		kBaseScriptProviderBoss,
		{
			IID_ISCRIPTPROVIDER, kKESCMScriptProviderImpl,
		}
	},
}}};

/*  
 * Implementation definition.
 */
resource FactoryList (kSDKDefFactoryListResourceID)
{
	kImplementationIDSpace,
	{
		#include "KESCMFactoryList.h"
	}
};


/*
 * Menu definition: the About Plug-ins entry (main menu) and the "About this plug-in" entry on
 * the panel's flyout (popup) menu. The panel itself appears under the Window menu automatically
 * (registered via the PanelList resource below), so no menu entry is needed for showing it.
 */
resource MenuDef (kSDKDefMenuResourceID)
{
	{
		// About Plug-ins sub-menu item.
		kKESCMAboutActionID,
		kKESCMAboutMenuPath,
		kSDKDefAlphabeticPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// ("Split Target on Start" was removed 2026-07-04; mechanism preserved in
		//  docs/ai-notes/kescm-split-target-mechanism.md and git history 69c4b07.)

		// "Start / Stop" at the top of the panel flyout (popup) menu. Starts a comparison
		// (idle) or stops/clears it (armed). This replaces the former Start/Stop panel button
		// (2026-07-10). The label switches between "Start" and "Stop" via UpdateActionStates
		// (kCustomEnabling + SetNthActionName) based on the shared armed state.
		kKESCMPopupStartStopActionID,
		kKESCMPopupMenuPath,
		kKESCMStartStopMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Separator below Start (path ending in ":-" renders a menu separator; no ActionDef needed).
		kKESCMPopupSep1ActionID,
		kKESCMPopupMenuPath kSDKDefDelimiterAndSeparatorPath,
		kKESCMSep1MenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Print comparison marks" on the panel flyout (popup) menu. Check-mark toggle:
		// while ON, the comparison marks are printed (and stay visible on screen); OFF is
		// screen-only. This replaces the former panel checkbox (2026-07-10). The check mark
		// comes from UpdateActionStates (kCustomEnabling). Opacity still follows the 25%/75% radios.
		kKESCMPopupPrintMarksActionID,
		kKESCMPopupMenuPath,
		kKESCMPrintMarksMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Hold to Hide Marks" on the panel flyout (popup) menu. Check-mark toggle that inverts the
		// polarity of the marks display: while ON, the comparison marks are kept visible on screen at
		// all times, and holding the tool's left button (any reveal/peek gesture) temporarily HIDES
		// them — releasing shows them again (the default is the opposite: marks are hidden and the
		// left-hold reveals them while held). Screen-only: printing is still governed independently by
		// "Print comparison marks". The check mark comes from UpdateActionStates (kCustomEnabling).
		kKESCMPopupHoldToHideMarksActionID,
		kKESCMPopupMenuPath,
		kKESCMHoldToHideMarksMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Marks opacity" submenu containing "25%" and "75%". The two children act as a radio pair
		// (mutually exclusive): UpdateActionStates (kCustomEnabling) puts the check mark on whichever
		// opacity is currently selected. Replaces the former panel opacity radios (2026-07-10). The
		// opacity applies to the middle-button display, the always-on screen display while printing is
		// ON, and the print output.
		// Submenu parent node: actionID 0 + path ending in a delimiter creates the "Marks opacity"
		// submenu at this position in the flyout (Adobe idiom, see buttonui/incopyexportui .fr).
		0,
		kKESCMOpacitySubmenuPath kSDKDefDelimitMenuPath,
		kKESCMOpacitySubmenuMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKESCMPopupOpacity25ActionID,
		kKESCMOpacitySubmenuPath,
		kKESCMOpacity25SubMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKESCMPopupOpacity75ActionID,
		kKESCMOpacitySubmenuPath,
		kKESCMOpacity75SubMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Show Marks on Source" on the panel flyout (popup) menu. Check-mark toggle:
		// while ON, the same comparison rings are also drawn on the corresponding pages of the
		// Source document — always visible (independent of the middle button), shown in
		// overprint preview, and always printed. Opacity follows the panel's 25%/75% radio.
		// Turned ON by default every time Start runs.
		kKESCMPopupShowSrcMarksActionID,
		kKESCMPopupMenuPath,
		kKESCMShowSrcMarksMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Hide Unchanged Spreads" on the panel flyout (popup) menu. Check-mark toggle:
		// turning it ON asks for confirmation (this DOES modify/dirty the documents), then hides
		// every spread that has no comparison marks via kHideSpreadCmdBoss — in the Target and,
		// by flat-page-index mapping, in the Source document too. Turning it OFF re-shows only
		// the spreads this plug-in hid (in both documents).
		kKESCMPopupHideUnchangedActionID,
		kKESCMPopupMenuPath,
		kKESCMHideUnchangedMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Show Original Page Numbers" on the panel flyout (popup) menu. Check-mark toggle:
		// while ON, pages whose live page-number markers shifted because of hidden spreads get a
		// badge with the original (pre-hide) page number at the bottom center, whenever the
		// comparison marks are visible (middle button held, or "Print comparison marks" ON —
		// the latter also prints the badge).
		kKESCMPopupShowOldNumsActionID,
		kKESCMPopupMenuPath,
		kKESCMShowOldNumsMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Sync Layout Views" on the panel flyout (popup) menu. Check-mark toggle: while ON,
		// scrolling/zooming any layout view mirrors its viewport (position + zoom) to all layout
		// views of the other documents, live. Works without Start.
		kKESCMPopupSyncViewsActionID,
		kKESCMPopupMenuPath,
		kKESCMSyncViewsMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Translucent Panel" on the panel flyout (popup) menu. Check-mark toggle (default OFF):
		// while ON, this panel itself is drawn translucent (alpha = kKESCMPanelAlphaValue, 77 out of 255;
		// it was 128 until 2026-07-29) whenever it is FLOATING or pulled out as an icon DRAWER - those
		// are the two states that get their own top-level window. Moving the pointer over the panel
		// (including its tab strip and title bar) turns it opaque again.
		// Windows only. Choosing it while the panel is docked is allowed but has no visible effect
		// (only the flag is stored; it takes hold as soon as the panel floats again), because a
		// docked panel is a child of the main frame and cannot be made transparent on its own.
		// Implementation: KESCMPanelAlpha.cpp.
		kKESCMPopupTranslucentPanelActionID,
		kKESCMPopupMenuPath,
		kKESCMTranslucentPanelMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Translucent Pages Panel" on the panel flyout (popup) menu. Check-mark toggle (default OFF).
		// Exactly the toggle above, but the target is InDesign's OWN Pages panel instead of this one
		// (user request, 2026-08-06). Same alpha, same "opaque again while the pointer is over it"
		// behaviour, same "floating or drawer only" limitation.
		// ★Why this became possible: the panel's window is now found from its WidgetID
		// (kPagesPanelWidgetID, a NUMBER) through IPanelMgr -> PaletteRef::GetOWLControl, instead of by
		// matching the window title. Titles are translated - the Pages panel reads "Pages" on an English
		// UI and "ページ" on a Japanese one (both measured on this machine, 2026-08-06) - so the old
		// title-matching lookup could never have worked for a built-in panel.
		// Implementation: KESCMPanelAlpha.cpp (shared with the toggle above; only the target differs).
		kKESCMPopupTranslucentPagesActionID,
		kKESCMPopupMenuPath,
		kKESCMTranslucentPagesPanelMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// ("Translucent Toolbox" was added on 2026-08-07 and taken out again the same day: a KESCM
		// toggle is not the place to change how InDesign's OWN toolbox looks. It needed only one more
		// target to work, which is itself evidence that this mechanism does not care WHICH palette it
		// is pointed at; the measured window structure is kept in memory/translucent-toolbox-idea.md.
		// Its ActionID (+38) stays retired - see KESCMID.h.)

		// "Align Other Views to Active" on the panel flyout (popup) menu. Plain command (not a toggle):
		// sets every OTHER document's layout views to the active (frontmost) view's position + zoom, once.
		// Independent of the Sync Layout Views toggle (works even when it is OFF). While Started, the page
		// Add/Remove correction is applied so the compared pages line up. Shortcut-assignable (its ActionDef
		// uses kKESCMPanelMenuActionArea + kSDKDefVisibleInKBSCEditorFlag).
		kKESCMPopupAlignViewsActionID,
		kKESCMPopupMenuPath,
		kKESCMAlignViewsMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Show Scrollbar Map" on the panel flyout (popup) menu. Check-mark toggle (default ON):
		// while ON, a thin strip beside each document window's vertical scrollbar maps the positions
		// of changed / registered pages. Turn it OFF to remove the strip from all windows.
		kKESCMPopupScrollMapActionID,
		kKESCMPopupMenuPath,
		kKESCMScrollMapMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// ("Show HUD" was removed together with the on-press HUD itself on 2026-08-06.)

		// "Ignore Page Number Marker" on the panel flyout (popup) menu. Check-mark toggle (default OFF,
		// see sIgnorePageNumberMarker in KESCMPageNumberMarker.cpp): while ON, frames containing an
		// automatic "Current Page Number" marker are excluded from the pixel comparison, so pages whose
		// only difference is a shifted running folio (caused by registered added/removed pages
		// elsewhere) aren't falsely flagged as changed.
		kKESCMPopupIgnorePageNumActionID,
		kKESCMPopupMenuPath,
		kKESCMIgnorePageNumMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Separator below "Refresh Overset" (path ending in ":-" renders a menu separator; no ActionDef
		// needed). Position table: KESCMID.h の ActionID 位置一覧(9.50)。(2026-07-25 コメント現行化。
		// 旧記述の "Invoke Panel Shortcut" は 2026-07-13 廃止済み)
		kKESCMPopupSep3ActionID,
		kKESCMPopupMenuPath kSDKDefDelimiterAndSeparatorPath,
		kKESCMSep3MenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Save Panel Settings" on the panel flyout (popup) menu. Not a check toggle: a plain command
		// that writes the current "settings" toggles to a private JSON file in the user's roaming
		// preferences folder (KESCM\KESCMPanelState.json) and shows the saved path. The file is read
		// back the first time the panel is opened (KESCMPanelState.cpp). Nothing is written into
		// InDesign's own data (workspace SavedData / documents).
		kKESCMPopupSavePanelStateActionID,
		kKESCMPopupMenuPath,
		kKESCMSavePanelStateMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Save Check & Register" on the panel flyout (popup) menu. Plain command that writes the current
		// per-page checks (KCM: Check) and registered Added/Removed pages of the started Target/Source
		// documents to a private JSON file (KESCM\KESCMPageChecks.json, v2), merged with any previously saved
		// documents. Shows the saved path.
		kKESCMPopupSaveChecksActionID,
		kKESCMPopupMenuPath,
		kKESCMSaveChecksMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Load Check & Register" on the panel flyout (popup) menu. Plain command; only meaningful while started.
		// Applies the saved registered pages to both documents, recompares once, then restores the saved checks
		// whose pages are still marked (frame/"/").
		kKESCMPopupLoadChecksActionID,
		kKESCMPopupMenuPath,
		kKESCMLoadChecksMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Export Changed Pages..." on the panel flyout (popup) menu. Plain command (not a toggle):
		// writes the current comparison's changed-page list to a tab-separated UTF-8 text file
		// (2 columns: Page / Type, where Type = Changed / Inserted / Deleted) for pasting into
		// Excel. Overset is never included. Enabled only while a comparison is active (sDB != nil);
		// UpdateActionStates supplies the enable state (kCustomEnabling). Work in KESCMChangedPagesTSV.cpp.
		kKESCMPopupExportChangedPagesActionID,
		kKESCMPopupMenuPath,
		kKESCMExportChangedPagesMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Separator above the Find Overset group (independent single-doc overset check).
		kKESCMPopupOversetSepActionID,
		kKESCMPopupMenuPath kSDKDefDelimiterAndSeparatorPath,
		kKESCMOversetSepMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Find Overset" on the panel flyout (popup) menu. Check-mark toggle (independent of the
		// new/old comparison): while ON, the ACTIVE document is scanned and a large red cross ("+")
		// is drawn on every page that contains overset (overflowing) text. The check mark comes from
		// UpdateActionStates (kCustomEnabling). Screen-only. The work is in KESCMOversetScan.cpp.
		kKESCMPopupFindOversetActionID,
		kKESCMPopupMenuPath,
		kKESCMFindOversetMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Refresh Overset" on the panel flyout (popup) menu. Plain command that re-scans the active
		// document and refreshes the crosses. Enabled only while "Find Overset" is ON (greyed out
		// otherwise) - UpdateActionStates supplies the enable state (kCustomEnabling).
		kKESCMPopupRefreshOversetActionID,
		kKESCMPopupMenuPath,
		kKESCMRefreshOversetMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Separator above How to Use (path ending in ":-" renders a menu separator; no ActionDef needed).
		kKESCMPopupSep2ActionID,
		kKESCMPopupMenuPath kSDKDefDelimiterAndSeparatorPath,
		kKESCMSep2MenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "How to Use" on the panel flyout (popup) menu.
		kKESCMPopupUsageActionID,
		kKESCMPopupMenuPath,
		kKESCMUsageMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// ("About scripting" フライアウト項目は 2026-07-25 に撤去(ユーザー指定)。スクリプトAPIは
		//  既に無く、"No scripts are currently available." を出すだけの項目だったため。ActionID
		//  kKESCMPopupAboutScriptActionID(kKESCMPrefix+3)は予約のまま。)

		// "About this plug-in" on the panel flyout (popup) menu (shown last).
		kKESCMPopupAboutThisActionID,
		kKESCMPopupMenuPath,
		kKESCMAboutThisMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Separator above the KESCM-added items on the Pages panel page context menu (path ending
		// in ":-" renders a menu separator; no ActionDef needed). It groups KESCM's own items
		// (Register / Check) apart from the built-in Pages panel menu items so they read clearly as
		// "KESCM's". Positioned just above Register (2999.0 < 3000.0), i.e. between the native items
		// and the KESCM block.
		kKESCMPageMapSepActionID,
		"RtMenuPagesPanel" kSDKDefDelimiterAndSeparatorPath,
		kKESCMPageMapSepMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "KCM: Register as Added/Removed Pages" on the Pages panel page context menu.
		// Check-mark toggle: registers/unregisters the selected pages as "pages with no
		// comparison counterpart" (added pages in the Target, removed pages in the Source —
		// same concept either way). The check mark, enable state and the dynamic label
		// (Added vs Removed, per the document's role) come from UpdateActionStates
		// (kCustomEnabling); the actual work is in KESCMPageMap.cpp.
		// "RtMenuPagesPanel" is the untranslated internal menu name of the right-click menu on
		// page icons in the Pages panel (verified live 2026-07-05 via app.menus + FindKeyStrings;
		// same style as the csxsdemo sample's "RtMouseLayout"). Untranslated keys are
		// locale-independent, so this works on English/Japanese/any-language InDesign.
		kKESCMPageMapToggleActionID,
		"RtMenuPagesPanel",
		kKESCMPageMapToggleMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "KCM: Check" on the Pages panel page context menu. Check-mark toggle: marks/unmarks the
		// selected pages with a blue check (✓) drawn on their Pages-panel thumbnails. Independent of
		// the Added/Removed registration. Only available while Started (armed) with the selected doc
		// being Target/Source; cleared on Stop. Check state / enabling come from UpdateActionStates
		// (kCustomEnabling); the work is in KESCMPageCheck.cpp and the ✓ drawing in KESCMDrawEventHandler.
		kKESCMPageCheckToggleActionID,
		"RtMenuPagesPanel",
		kKESCMPageCheckMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "KCM: Refresh Page Comparison" on the Pages panel page context menu. Plain command
		// (not a toggle): re-runs the comparison for the selected page(s) and updates the marks /
		// thumbnails (formerly the Ctrl+middle spread recompare, moved to this menu 2026-07-13).
		// Only available while Started (armed) with the front document being Target/Source; enabling
		// comes from UpdateActionStates (kCustomEnabling). The work is in KESCMPeek.cpp.
		kKESCMPageRefreshCompareActionID,
		"RtMenuPagesPanel",
		kKESCMPageRefreshCompareMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,
	}
};

/*
 * Action definition for the menu items above.
 */
