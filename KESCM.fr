		kCustomEnabling|kDisableIfLowMem,	// UpdateActionStates supplies the check mark (kSelectedAction)
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		// "Align Other Views to Active": shortcut-assignable one-shot. kKESCMPanelMenuActionArea +
		// kSDKDefVisibleInKBSCEditorFlag file it in the Keyboard Shortcuts editor under Product Area
