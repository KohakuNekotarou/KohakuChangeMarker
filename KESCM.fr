	kImplementationIDSpace,
	{
		#include "KESCMFactoryList.h"
	}
};


/*
 * Menu definition: the About Plug-ins entry (main menu) and the "About this plug-in" entry on
 * the panel's flyout (popup) menu. The panel itself appears under the Window menu automatically
 * (registered via the PanelList resource below), so no menu entry is needed for showing it.
 */
resource MenuDef (kSDKDefMenuResourceID)
{
	{
		// About Plug-ins sub-menu item.
		kKESCMAboutActionID,
		kKESCMAboutMenuPath,
		kSDKDefAlphabeticPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// ("Split Target on Start" was removed 2026-07-04; mechanism preserved in
		//  docs/ai-notes/kescm-split-target-mechanism.md and git history 69c4b07.)

		// "Start / Stop" at the top of the panel flyout (popup) menu. Starts a comparison
		// (idle) or stops/clears it (armed). This replaces the former Start/Stop panel button
		// (2026-07-10). The label switches between "Start" and "Stop" via UpdateActionStates
		// (kCustomEnabling + SetNthActionName) based on the shared armed state.
		kKESCMPopupStartStopActionID,
		kKESCMPopupMenuPath,
		kKESCMStartStopMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Separator below Start (path ending in ":-" renders a menu separator; no ActionDef needed).
		kKESCMPopupSep1ActionID,
		kKESCMPopupMenuPath ":-",
		kKESCMSep1MenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Print comparison marks" on the panel flyout (popup) menu. Check-mark toggle:
		// while ON, the comparison marks are printed (and stay visible on screen); OFF is
		// screen-only. This replaces the former panel checkbox (2026-07-10). The check mark
		// comes from UpdateActionStates (kCustomEnabling). Opacity still follows the 25%/75% radios.
		kKESCMPopupPrintMarksActionID,
		kKESCMPopupMenuPath,
		kKESCMPrintMarksMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Hold to Hide Marks" on the panel flyout (popup) menu. Check-mark toggle that inverts the
		// polarity of the marks display: while ON, the comparison marks are kept visible on screen at
		// all times, and holding the middle button (any reveal/peek gesture) temporarily HIDES them —
		// releasing shows them again (the default is the opposite: marks are hidden and the middle
		// button reveals them while held). Screen-only: printing is still governed independently by
		// "Print comparison marks". The check mark comes from UpdateActionStates (kCustomEnabling).
		kKESCMPopupHoldToHideMarksActionID,
		kKESCMPopupMenuPath,
		kKESCMHoldToHideMarksMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Marks opacity" submenu containing "25%" and "75%". The two children act as a radio pair
		// (mutually exclusive): UpdateActionStates (kCustomEnabling) puts the check mark on whichever
		// opacity is currently selected. Replaces the former panel opacity radios (2026-07-10). The
		// opacity applies to the middle-button display, the always-on screen display while printing is
		// ON, and the print output.
		// Submenu parent node: actionID 0 + path ending in a delimiter creates the "Marks opacity"
		// submenu at this position in the flyout (Adobe idiom, see buttonui/incopyexportui .fr).
		0,
		kKESCMOpacitySubmenuPath ":",
		kKESCMOpacitySubmenuMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKESCMPopupOpacity25ActionID,
		kKESCMOpacitySubmenuPath,
		kKESCMOpacity25SubMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		kKESCMPopupOpacity75ActionID,
		kKESCMOpacitySubmenuPath,
		kKESCMOpacity75SubMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Show Marks on Source" on the panel flyout (popup) menu. Check-mark toggle:
		// while ON, the same comparison rings are also drawn on the corresponding pages of the
		// Source document — always visible (independent of the middle button), shown in
		// overprint preview, and always printed. Opacity follows the panel's 25%/75% radio.
		// Turned ON by default every time Start runs.
		kKESCMPopupShowSrcMarksActionID,
		kKESCMPopupMenuPath,
		kKESCMShowSrcMarksMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Hide Unchanged Spreads" on the panel flyout (popup) menu. Check-mark toggle:
		// turning it ON asks for confirmation (this DOES modify/dirty the documents), then hides
		// every spread that has no comparison marks via kHideSpreadCmdBoss — in the Target and,
		// by flat-page-index mapping, in the Source document too. Turning it OFF re-shows only
		// the spreads this plug-in hid (in both documents).
		kKESCMPopupHideUnchangedActionID,
		kKESCMPopupMenuPath,
		kKESCMHideUnchangedMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Show Original Page Numbers" on the panel flyout (popup) menu. Check-mark toggle:
		// while ON, pages whose live page-number markers shifted because of hidden spreads get a
		// badge with the original (pre-hide) page number at the bottom center, whenever the
		// comparison marks are visible (middle button held, or "Print comparison marks" ON —
		// the latter also prints the badge).
		kKESCMPopupShowOldNumsActionID,
		kKESCMPopupMenuPath,
		kKESCMShowOldNumsMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Sync Layout Views" on the panel flyout (popup) menu. Check-mark toggle: while ON,
		// scrolling/zooming any layout view mirrors its viewport (position + zoom) to all layout
		// views of the other documents, live. Works without Start.
		kKESCMPopupSyncViewsActionID,
		kKESCMPopupMenuPath,
		kKESCMSyncViewsMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Show Scrollbar Map" on the panel flyout (popup) menu. Check-mark toggle (default ON):
		// while ON, a thin strip beside each document window's vertical scrollbar maps the positions
		// of changed / registered pages. Turn it OFF to remove the strip from all windows.
		kKESCMPopupScrollMapActionID,
		kKESCMPopupMenuPath,
		kKESCMScrollMapMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Invoke Panel Shortcut" on the panel flyout (popup) menu. Check-mark toggle (default ON):
		// while ON, Shift+Ctrl+middle-click toggles this panel's visibility (pops at the cursor when
		// floating). Turn it OFF to disable that gesture so the plain middle-click is left untouched.
		kKESCMPopupPanelShortcutActionID,
		kKESCMPopupMenuPath,
		kKESCMPanelShortcutMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Ignore Page Number Marker" on the panel flyout (popup) menu. Check-mark toggle: while ON
		// (default), frames containing an automatic "Current Page Number" marker are excluded from
		// the pixel comparison, so pages whose only difference is a shifted running folio (caused by
		// registered added/removed pages elsewhere) aren't falsely flagged as changed.
		kKESCMPopupIgnorePageNumActionID,
		kKESCMPopupMenuPath,
		kKESCMIgnorePageNumMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Separator below "Invoke Panel Shortcut" (path ending in ":-" renders a menu separator;
		// no ActionDef needed). "Hide Unchanged Spreads" was moved to just below this line (2026-07-11).
		kKESCMPopupSep3ActionID,
		kKESCMPopupMenuPath ":-",
		kKESCMSep3MenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "Save Panel Settings" on the panel flyout (popup) menu. Not a check toggle: a plain command
		// that writes the current "settings" toggles to a private JSON file in the user's roaming
		// preferences folder (KESCM\KESCMPanelState.json) and shows the saved path. The file is read
		// back the first time the panel is opened (KESCMPanelState.cpp). Nothing is written into
		// InDesign's own data (workspace SavedData / documents).
		kKESCMPopupSavePanelStateActionID,
		kKESCMPopupMenuPath,
		kKESCMSavePanelStateMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// Separator above How to Use (path ending in ":-" renders a menu separator; no ActionDef needed).
		kKESCMPopupSep2ActionID,
		kKESCMPopupMenuPath ":-",
		kKESCMSep2MenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "How to Use" on the panel flyout (popup) menu.
		kKESCMPopupUsageActionID,
		kKESCMPopupMenuPath,
		kKESCMUsageMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "About scripting" on the panel flyout (popup) menu.
		kKESCMPopupAboutScriptActionID,
		kKESCMPopupMenuPath,
		kKESCMAboutScriptMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "About this plug-in" on the panel flyout (popup) menu (shown last).
		kKESCMPopupAboutThisActionID,
		kKESCMPopupMenuPath,
		kKESCMAboutThisMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "KESCM: Register as Added/Removed Pages" on the Pages panel page context menu.
		// Check-mark toggle: registers/unregisters the selected pages as "pages with no
		// comparison counterpart" (added pages in the Target, removed pages in the Source —
		// same concept either way). The check mark, enable state and the dynamic label
		// (Added vs Removed, per the document's role) come from UpdateActionStates
		// (kCustomEnabling); the actual work is in KESCMPageMap.cpp.
		// "RtMenuPagesPanel" is the untranslated internal menu name of the right-click menu on
		// page icons in the Pages panel (verified live 2026-07-05 via app.menus + FindKeyStrings;
		// same style as the csxsdemo sample's "RtMouseLayout"). Untranslated keys are
		// locale-independent, so this works on English/Japanese/any-language InDesign.
		kKESCMPageMapToggleActionID,
		"RtMenuPagesPanel",
		kKESCMPageMapToggleMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,

		// "KESCM: Check" on the Pages panel page context menu. Check-mark toggle: marks/unmarks the
		// selected pages with a blue check (✓) drawn on their Pages-panel thumbnails. Independent of
		// the Added/Removed registration. Only available while Started (armed) with the selected doc
		// being Target/Source; cleared on Stop. Check state / enabling come from UpdateActionStates
		// (kCustomEnabling); the work is in KESCMPageCheck.cpp and the ✓ drawing in KESCMDrawEventHandler.
		kKESCMPageCheckToggleActionID,
		"RtMenuPagesPanel",
		kKESCMPageCheckMenuItemPosition,
		kSDKDefIsNotDynamicMenuFlag,
	}
};

/*
 * Action definition for the menu items above.
 */
resource ActionDef (kSDKDefActionResourceID)
{
	{
		kKESCMActionComponentBoss,			// boss that implements the action
		kKESCMAboutActionID,				// ActionID
		kKESCMAboutMenuKey,					// sub-menu string
		kHelpMenuActionArea,				// area name
		kNormalAction,						// action type
		kDisableIfLowMem,					// enabling type
		kInvalidInterfaceID,				// selection interface this action cares about
		kSDKDefInvisibleInKBSCEditorFlag,	// KBSC editor visibility

		kKESCMActionComponentBoss,
		kKESCMPopupStartStopActionID,
		kKESCMStartButtonKey,				// default menu name ("Start"); UpdateActionStates swaps to "Stop" when armed
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,	// UpdateActionStates supplies the dynamic Start/Stop label
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		kKESCMActionComponentBoss,
		kKESCMPopupPrintMarksActionID,
		kKESCMPrintCheckKey,				// "Print comparison marks" (same label as the former panel checkbox)
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,	// UpdateActionStates supplies the check mark (kSelectedAction)
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		kKESCMActionComponentBoss,
		kKESCMPopupHoldToHideMarksActionID,
		kKESCMHoldToHideMarksMenuKey,
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,	// UpdateActionStates supplies the check mark (kSelectedAction)
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		kKESCMActionComponentBoss,
		kKESCMPopupOpacity25ActionID,
		kKESCMOpacity25Key,					// "Marks opacity 25%" (same label as the former panel radio)
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,	// UpdateActionStates checks whichever opacity is selected (radio-style)
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		kKESCMActionComponentBoss,
		kKESCMPopupOpacity75ActionID,
		kKESCMOpacity75Key,					// "Marks opacity 75%"
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,	// UpdateActionStates checks whichever opacity is selected (radio-style)
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		kKESCMActionComponentBoss,
		kKESCMPopupShowSrcMarksActionID,
		kKESCMShowSrcMarksMenuKey,
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,	// UpdateActionStates supplies the check mark (kSelectedAction)
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		kKESCMActionComponentBoss,
		kKESCMPopupHideUnchangedActionID,
		kKESCMHideUnchangedMenuKey,
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,	// UpdateActionStates supplies the check mark (kSelectedAction)
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		kKESCMActionComponentBoss,
		kKESCMPopupShowOldNumsActionID,
		kKESCMShowOldNumsMenuKey,
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,	// UpdateActionStates supplies the check mark (kSelectedAction)
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		kKESCMActionComponentBoss,
		kKESCMPopupSyncViewsActionID,
		kKESCMSyncViewsMenuKey,
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,	// UpdateActionStates supplies the check mark (kSelectedAction)
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		kKESCMActionComponentBoss,
		kKESCMPopupScrollMapActionID,
		kKESCMScrollMapMenuKey,
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,	// UpdateActionStates supplies the check mark (kSelectedAction)
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		kKESCMActionComponentBoss,
		kKESCMPopupPanelShortcutActionID,
		kKESCMPanelShortcutMenuKey,
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,	// UpdateActionStates supplies the check mark (kSelectedAction)
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		kKESCMActionComponentBoss,
		kKESCMPopupIgnorePageNumActionID,
		kKESCMIgnorePageNumMenuKey,
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,	// UpdateActionStates supplies the check mark (kSelectedAction)
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		kKESCMActionComponentBoss,
		kKESCMPopupSavePanelStateActionID,
		kKESCMSavePanelStateMenuKey,
		kOtherActionArea,
		kNormalAction,
		kDisableIfLowMem,					// plain command; always enabled (no UpdateActionStates needed)
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		kKESCMActionComponentBoss,
		kKESCMPopupUsageActionID,
		kKESCMUsageMenuKey,
		kOtherActionArea,
		kNormalAction,
		kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		kKESCMActionComponentBoss,
		kKESCMPopupAboutScriptActionID,
		kKESCMAboutScriptMenuKey,
		kOtherActionArea,
		kNormalAction,
		kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		kKESCMActionComponentBoss,
		kKESCMPopupAboutThisActionID,
		kSDKDefAboutThisPlugInMenuKey,
		kOtherActionArea,
		kNormalAction,
		kDisableIfLowMem,
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		kKESCMActionComponentBoss,
		kKESCMPageMapToggleActionID,
		kKESCMPageMapToggleMenuKey,
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,	// UpdateActionStates supplies check mark, enabling and the dynamic Added/Removed label
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,

		kKESCMActionComponentBoss,
		kKESCMPageCheckToggleActionID,
		kKESCMPageCheckMenuKey,
		kOtherActionArea,
		kNormalAction,
		kCustomEnabling|kDisableIfLowMem,	// UpdateActionStates supplies check mark and enabling
		kInvalidInterfaceID,
		kSDKDefInvisibleInKBSCEditorFlag,
	}
};


/*  
 * Locale Indicies.
 * The LocaleIndex should have indicies that point at your
 * localizations for each language system that you are localized for.
 */

/*  
 * String LocaleIndex.
 */
resource LocaleIndex ( kSDKDefStringsResourceID)
{
	kStringTableRsrcType,
	{
		kWildFS, k_enUS, kSDKDefStringsResourceID + index_enUS
		kWildFS, k_enGB, kSDKDefStringsResourceID + index_enUS
		kWildFS, k_deDE, kSDKDefStringsResourceID + index_enUS
		kWildFS, k_frFR, kSDKDefStringsResourceID + index_enUS
		kWildFS, k_esES, kSDKDefStringsResourceID + index_enUS
		kWildFS, k_ptBR, kSDKDefStringsResourceID + index_enUS
		kWildFS, k_svSE, kSDKDefStringsResourceID + index_enUS
		kWildFS, k_daDK, kSDKDefStringsResourceID + index_enUS
		kWildFS, k_nlNL, kSDKDefStringsResourceID + index_enUS
		kWildFS, k_itIT, kSDKDefStringsResourceID + index_enUS
		kWildFS, k_nbNO, kSDKDefStringsResourceID + index_enUS
		kWildFS, k_fiFI, kSDKDefStringsResourceID + index_enUS
		kInDesignJapaneseFS, k_jaJP, kSDKDefStringsResourceID + index_jaJP
	}
};

resource LocaleIndex (kSDKDefStringsNoTransResourceID)
{
	kStringTableRsrcType,
	{
		kWildFS, k_Wild, kSDKDefStringsNoTransResourceID + index_enUS
	}
};

// Strings not being localized
resource StringTable (kSDKDefStringsNoTransResourceID + index_enUS)
{
	k_enUS,									// Locale Id
	kEuropeanMacToWinEncodingConverter,		// Character encoding converter
	{
		// Internal popup (flyout) menu name - not translated.
		kKESCMInternalPopupMenuNameKey,	kKESCMInternalPopupMenuNameKey,
	}
};
//========================================================================================
// (Scripting API removed: KESCM no longer exposes any script methods. See panel flyout
// "About scripting" for the user-facing note.)
//========================================================================================


//========================================================================================
// ChangeMarker control panel (palette)
//========================================================================================

// PNG icons (compiled into the plug-in; ON = armed/comparing, OFF = idle). Same art is used for
// the normal and rollover states since this is a non-interactive status icon.
resource PNGA(kKESCMIconOnResID)  "KESCM_On32.png"
resource PNGR(kKESCMIconOnResID)  "KESCM_On32.png"
resource PNGA(kKESCMIconOffResID) "KESCM_Off32.png"
resource PNGR(kKESCMIconOffResID) "KESCM_Off32.png"

// Small dock-tab icon shown when the panel is collapsed to its smallest. Replace
// KohakuChangeMarkerTab.png with your own artwork (a small, e.g. ~20x20, transparent PNG).
resource PNGA(kKESCMPaletteIconResID) "KohakuChangeMarkerTab.png"

// Panel LocaleIndex - a single (string-key driven) view is used for every locale; the labels
// themselves are localized through the string tables (KESCM_enUS.fr / KESCM_jaJP.fr).
resource LocaleIndex (kSDKDefPanelResourceID)
{
	kViewRsrcType,
	{
		kWildFS, k_Wild, kSDKDefPanelResourceID + index_enUS
	}
};

// Type definition for the panel widget boss.
type KESCMPanelWidget(kViewRsrcType) : PalettePanelWidget(ClassID = kKESCMPanelWidgetBoss)
{
	CPanelMenuData;
};

// Panel illustration (ON/OFF icon) widget type: same as RollOverIconButtonWidget, but backed by
// kKESCMIconWidgetBoss so it carries IID_ITIP (tooltip showing the repo URL on hover).
type KESCMIconWidget(kViewRsrcType) : RollOverIconButtonWidget(ClassID = kKESCMIconWidgetBoss) { };

// Scroll-map strip widget type (custom-drawn; injected at runtime by KESCMScrollMap.cpp).
type KESCMScrollMapWidget(kViewRsrcType) : GenericPanelWidget(ClassID = kKESCMScrollMapWidgetBoss) { };

// Scroll-map strip view resource: instantiated with ::CreateObject(db, RsrcSpec(...,
// kViewRsrcType, kKESCMScrollMapRsrcID), IID_ICONTROLVIEW) — same runtime-creation pattern as
// linksui's dynamic info widgets. The Frame here is a placeholder; the real frame/binding are
// assigned right after AddWidget from the live scrollbar geometry.
resource LocaleIndex (kKESCMScrollMapRsrcID)
{
	kViewRsrcType,
	{
		kWildFS, k_Wild, kKESCMScrollMapRsrcID + index_enUS
	}
};

resource KESCMScrollMapWidget(kKESCMScrollMapRsrcID + index_enUS)
{
	kKESCMScrollMapWidgetID,		// WidgetId
	kPMRsrcID_None,					// RsrcId
	kBindNone,						// Frame binding (placeholder; set at runtime)
	Frame(0, 0, 5, 100)				// Frame (placeholder; set at runtime)
	kTrue, kTrue,					// Visible, Enabled
	"",								// Panel name (none)
	{
	}
};

// PanelList - registers the panel and makes it appear under the Window menu.
resource PanelList (kSDKDefPanelResourceID)
{
	{
		kSDKDefPanelResourceID,		// Resource ID for this panel
		kKESCMPluginID,				// owning plug-in
		kNotResizable,				// fixed-size panel
		kKESCMPanelWidgetActionID,	// Action ID to show/hide the panel
		"",							// panelName empty: place via altMenu below for explicit menu placement
		kKESCMPanelPluginsMenuPath,	// Plug-Ins > KohakuNekotarou > KohakuChangeMarker
		kKESCMPanelPluginsMenuPosition,	// lower part of the menu
		kKESCMPaletteIconResID, kKESCMPluginID,	// PNG icon for the collapsed dock tab
		c_Panel
	}
};

// PanelView - widget layout. Labels reference string keys so they localize automatically.
resource KESCMPanelWidget(kSDKDefPanelResourceID + index_enUS)
{
	__FILE__, __LINE__,
	kKESCMPanelWidgetID,			// WidgetID
	kPMRsrcID_None,					// RsrcID
	kBindNone,						// Binding
	0, 0, 192, 136,					// Frame: left, top, right, bottom (イラストをステータステキスト横=右へ移した分、縦を40px詰めた)
	kTrue, kTrue,					// Visible, Enabled
	kFalse,							// Erase background
	kInterfacePaletteFill,			// Erase to color
	kFalse,							// Draw dropshadow
	kKESCMPanelTitleKey,			// Panel name
	{
		// Target / Source status (label stays English; the document name is filled in by the observer).
		StaticTextWidget
		(
			kKESCMTargetTextWidgetID,
			kSysStaticTextPMRsrcId,
			kBindLeft | kBindRight | kBindTop,
			Frame(8, 8, 184, 24)
			kTrue, kTrue,
			kAlignLeft, kEllipsizeEnd, kTrue,
			kKESCMTargetLabelKey,
			kInvalidWidgetID,
		),
		StaticTextWidget
		(
			kKESCMSourceTextWidgetID,
			kSysStaticTextPMRsrcId,
			kBindLeft | kBindRight | kBindTop,
			Frame(8, 26, 184, 42)
			kTrue, kTrue,
			kAlignLeft, kEllipsizeEnd, kTrue,
			kKESCMSourceLabelKey,
			kInvalidWidgetID,
		),

		// (Target/Source 下の区切り線は 2026-07-10 に撤去。以下を 8px 上へ詰めた。)

		// (Start / Stop・Print comparison marks・Marks opacity 25%/75% は 2026-07-10 にパネルから
		//  フライアウトメニュー項目へ移行(kKESCMPopupStartStopActionID / kKESCMPopupPrintMarksActionID /
		//  kKESCMPopupOpacity25ActionID / kKESCMPopupOpacity75ActionID)。ボタン/チェック/ラジオは撤去し、
		//  以下を上へ詰めた。パネルに残るのは Target/Source・セパレータ・Prev/Next・ステータス+アイコン。)

		// Change navigation: jump the Target layout view to the previous / next page that carries a
		// KESCM mark (changed ring, Added border, or overflow "/"). Handled by KESCMChangeNav.cpp.
		ButtonWidget
		(
			kKESCMPrevChangeButtonWidgetID,
			kSysButtonPMRsrcId,
			kBindLeft | kBindTop,
			Frame(12, 48, 94, 70)
			kTrue, kTrue,
			kKESCMPrevChangeKey,
		),
		ButtonWidget
		(
			kKESCMNextChangeButtonWidgetID,
			kSysButtonPMRsrcId,
			kBindLeft | kBindTop,
			Frame(98, 48, 180, 70)
			kTrue, kTrue,
			kKESCMNextChangeKey,
		),

		// Status icon (OFF visible by default; the observer swaps ON/OFF based on the armed state).
		// KESCMIconWidget (not the plain RollOverIconButtonWidget) so it carries IID_ITIP (tooltip).
		KESCMIconWidget
		(
			kKESCMIconOffWidgetID,
			kKESCMIconOffResID, kKESCMPluginID,
			kBindTop,
			Frame(152, 96, 184, 128)	// 32×32・右寄せ・ステータステキスト帯(76-128)の下端に揃える。ON側と同座標
			kTrue, kTrue,
			kADBEIconSuiteButtonType,
		),
		KESCMIconWidget
		(
			kKESCMIconOnWidgetID,
			kKESCMIconOnResID, kKESCMPluginID,
			kBindTop,
			Frame(152, 96, 184, 128)	// 32×32・右寄せ・ステータステキスト帯(76-128)の下端に揃える。OFF側と同座標
			kFalse, kTrue,
			kADBEIconSuiteButtonType,
		),

		// Status text (filled in by the observer with the result of each action).
		StaticMultiLineTextWidget
		(
			kKESCMStatusTextWidgetID,
			kPMRsrcID_None,
			kBindLeft | kBindRight | kBindTop,
			Frame(8, 76, 148, 128)		// 右148まで=イラスト(152-184)と横並び(4px間隔)
			kTrue, kTrue,
			kAlignLeft, kDontEllipsize, kTrue,
			kInvalidWidgetID,
			kPaletteWindowFontId,
			3,
			2, 0,
			"",
		),
	}

	kKESCMInternalPopupMenuNameKey		// Popup (flyout) menu name (internal)
};

#endif // __ODFRC__

#include "KESCM_enUS.fr"
