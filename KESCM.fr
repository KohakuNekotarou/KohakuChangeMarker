//========================================================================================
// (Scripting API removed: KESCM no longer exposes any script methods. The flyout item
// "About Scripting" that used to say so was also removed on 2026-07-25.)
//========================================================================================


//========================================================================================
// ChangeMarker control panel (palette)
//========================================================================================

// PNG icons (compiled into the plug-in; ON = armed/comparing, OFF = idle). Same art is used for
// the normal and rollover states since this is a non-interactive status icon.
resource PNGA(kKESCMIconOnResID)  "KESCM_On32.png"
resource PNGR(kKESCMIconOnResID)  "KESCM_On32.png"
resource PNGA(kKESCMIconOffResID) "KESCM_Off32.png"
resource PNGR(kKESCMIconOffResID) "KESCM_Off32.png"

// Small dock-tab icon shown when the panel is collapsed to its smallest. Replace
// KohakuChangeMarkerTab.png with your own artwork (a small, e.g. ~20x20, transparent PNG).
resource PNGA(kKESCMPaletteIconResID) "KohakuChangeMarkerTab.png"

// KESCM ツールボックスアイコン(ユーザー提供 2026-07-14)。通常=32x32、HiDPI(2x)=64x64。ダーク版は
// 用意していないため PNGAD にも同じライト版画像を指定して流用する(ユーザー指定)。Windows の 1.5x は
// 別画像を作らず通常(32x32)を再利用する(wavetool サンプルと同じ作法)。
resource PNGA(kKESCMToolIconResID)  "KESCM_Tool_32.png"
resource PNGAD(kKESCMToolIconResID) "KESCM_Tool_32.png"	// ダーク版なし=ライトを流用
resource PNGA(kKESCMToolIconResID + kHIDPIIconOffset)  "KESCM_Tool_64.png"
resource PNGAD(kKESCMToolIconResID + kHIDPIIconOffset) "KESCM_Tool_64.png"	// ダーク版なし=ライトを流用
#ifdef WINDOWS
resource PNGA(kKESCMToolIconResID + kHIDPIIconOffset150)  "KESCM_Tool_32.png"
resource PNGAD(kKESCMToolIconResID + kHIDPIIconOffset150) "KESCM_Tool_32.png"
#endif

// ✓ tool cursor. {X, Y} = the checkmark's vertex (folding point) in 1x logical pixels, which must
// match the vertex (10,18) drawn by KESCMDrawCheckGlyph so the click point sits on the vertex.
// ★2026-07-25: コールバック描画(KESCMCheckCursorBitmapProc)から **PNG リソース**へ変更した。理由=押下時に
//   間欠的に出る「ゴミ」の発生源が、基底 CTracker::BeginTracking の中の✓再設置(モーダルカーソル取得)で
//   コールバックが呼び直されることだったため(切り分け 2026-07-25)。リソースなら再設置でバッファ描画が
//   起きない=発生源そのものが消える。画像は KESCMCheckGlyph.h と同じ幾何で生成(work/ のスクリプト参照)。
//   1x=32x32 / 2x=+kHIDPICrsrOffset(3000) / Win 1.5x=+kHIDPI150CrsrOffset(4000)。手本=sdksamples/snapshot。
resource PNGC(kKESCMCheckCursorResID) "KESCM_Check_10_18.png"
resource PNGC(kKESCMCheckCursorResID + kHIDPICrsrOffset) "KESCM_Check_10_18@2x.png"
#ifdef WINDOWS
resource PNGC(kKESCMCheckCursorResID + kHIDPI150CrsrOffset) "KESCM_Check_10_18@3to2x.png"
#endif
resource HOTC(kKESCMCheckCursorResID) {10, 18};

// Alt+左「色比較」の CMYK 情報カーソルのホットスポット。✓と同じ折れ点(10,18)=クリック点に一致させる。
// CursorID は ✓ と分けてある(キャッシュ取り違えによる初回フレームのゴミ対策。KESCMID.h 参照)。
resource HOTC(kKESCMCmykCursorResID) {10, 18};

// 同・交互切替用の第2ID。ドラッグ中の数値更新は kFalse カーソルの入れ直しで行い、同一スペック再設定の
// no-op を避けるため 1021/1022 を交互に使う(KESCMTracker.cpp の InstallCmykCursor)。ホットスポットは同じ。
resource HOTC(kKESCMCmykCursor2ResID) {10, 18};

// ✓カーソルの非アクティブ版(白抜き=黒フチ+白本体)。ホットスポットは黒✓と同じ折れ点 (10,18)=切替で
// カーソル位置は動かない。「Start 中かつマウス下が Target 文書」以外で出す(KESCMCursorProvider.cpp)。
// こちらも PNG リソース(上の黒✓と同じ理由。2026-07-25)。
resource PNGC(kKESCMCheckCursorInactiveResID) "KESCM_CheckOff_10_18.png"
resource PNGC(kKESCMCheckCursorInactiveResID + kHIDPICrsrOffset) "KESCM_CheckOff_10_18@2x.png"
#ifdef WINDOWS
resource PNGC(kKESCMCheckCursorInactiveResID + kHIDPI150CrsrOffset) "KESCM_CheckOff_10_18@3to2x.png"
#endif
resource HOTC(kKESCMCheckCursorInactiveResID) {10, 18};

// Panel LocaleIndex - a single (string-key driven) view is used for every locale; the labels
// themselves are localized through the string tables (KESCM_enUS.fr / KESCM_jaJP.fr).
resource LocaleIndex (kSDKDefPanelResourceID)
{
	kViewRsrcType,
	{
		kWildFS, k_Wild, kSDKDefPanelResourceID + index_enUS
	}
};

// Type definition for the panel widget boss.
type KESCMPanelWidget(kViewRsrcType) : PalettePanelWidget(ClassID = kKESCMPanelWidgetBoss)
{
	CPanelMenuData;
};

// Panel illustration (ON/OFF icon) widget type: same as RollOverIconButtonWidget, but backed by
// kKESCMIconWidgetBoss so it carries IID_ITIP (tooltip showing the repo URL on hover).
type KESCMIconWidget(kViewRsrcType) : RollOverIconButtonWidget(ClassID = kKESCMIconWidgetBoss) { };

// Scroll-map strip widget type (custom-drawn; injected at runtime by KESCMScrollMap.cpp).
type KESCMScrollMapWidget(kViewRsrcType) : GenericPanelWidget(ClassID = kKESCMScrollMapWidgetBoss) { };

// Scroll-map strip view resource: instantiated with ::CreateObject(db, RsrcSpec(...,
// kViewRsrcType, kKESCMScrollMapRsrcID), IID_ICONTROLVIEW) — same runtime-creation pattern as
// linksui's dynamic info widgets. The Frame here is a placeholder; the real frame/binding are
// assigned right after AddWidget from the live scrollbar geometry.
resource LocaleIndex (kKESCMScrollMapRsrcID)
{
	kViewRsrcType,
	{
		kWildFS, k_Wild, kKESCMScrollMapRsrcID + index_enUS
	}
};

resource KESCMScrollMapWidget(kKESCMScrollMapRsrcID + index_enUS)
{
	kKESCMScrollMapWidgetID,		// WidgetId
	kPMRsrcID_None,					// RsrcId
	kBindNone,						// Frame binding (placeholder; set at runtime)
	Frame(0, 0, 5, 100)				// Frame (placeholder; set at runtime)
	kTrue, kTrue,					// Visible, Enabled
	"",								// Panel name (none)
	{
	}
};

// PanelList - registers the panel and makes it appear under the Window menu.
resource PanelList (kSDKDefPanelResourceID)
{
	{
		kSDKDefPanelResourceID,		// Resource ID for this panel
		kKESCMPluginID,				// owning plug-in
		kNotResizable,				// fixed-size panel
		kKESCMPanelWidgetActionID,	// Action ID to show/hide the panel
		"",							// panelName empty: place via altMenu below for explicit menu placement
		kKESCMPanelPluginsMenuPath,	// Plug-Ins > Kohaku Plug-Ins > Kohaku Change Marker(束ね名は kKESCMCompanyKey の解決値)
		kKESCMPanelPluginsMenuPosition,	// lower part of the menu
		kKESCMPaletteIconResID, kKESCMPluginID,	// PNG icon for the collapsed dock tab
		c_Panel
	}
};

// PanelView - widget layout. Labels reference string keys so they localize automatically.
resource KESCMPanelWidget(kSDKDefPanelResourceID + index_enUS)
{
	__FILE__, __LINE__,
	kKESCMPanelWidgetID,			// WidgetID
	kPMRsrcID_None,					// RsrcID
	kBindNone,						// Binding
	0, 0, 214, 153,					// Frame: left, top, right, bottom (ステータス欄を3→4行に拡張した分、下端を +17px。イラストも下端145へ下寄せ。ステータス欄を+12px広げた分、右端 192→204。さらに 2026-07-15 にメッセージ欄を+10px広げ 204→214)
	kTrue, kTrue,					// Visible, Enabled
	kFalse,							// Erase background
	kInterfacePaletteFill,			// Erase to color
	kFalse,							// Draw dropshadow
	kKESCMPanelTitleKey,			// Panel name
	{
		// Target / Source status (label stays English; the document name is filled in by the observer).
		StaticTextWidget
		(
			kKESCMTargetTextWidgetID,
			kSysStaticTextPMRsrcId,
			kBindLeft | kBindRight | kBindTop,
			Frame(8, 8, 206, 24)		// 右端 196→206(パネル+10px 拡張, 2026-07-15)
			kTrue, kTrue,
			kAlignLeft, kEllipsizeEnd, kTrue,
			kKESCMTargetLabelKey,
			kInvalidWidgetID,
		),
		StaticTextWidget
		(
			kKESCMSourceTextWidgetID,
			kSysStaticTextPMRsrcId,
			kBindLeft | kBindRight | kBindTop,
			Frame(8, 26, 206, 42)		// 右端 196→206(パネル+10px 拡張, 2026-07-15)
			kTrue, kTrue,
			kAlignLeft, kEllipsizeEnd, kTrue,
			kKESCMSourceLabelKey,
			kInvalidWidgetID,
		),

		// (Target/Source 下の区切り線は 2026-07-10 に撤去。以下を 8px 上へ詰めた。)

		// (Start / Stop・Print comparison marks・Marks opacity 25%/75% は 2026-07-10 にパネルから
		//  フライアウトメニュー項目へ移行(kKESCMPopupStartStopActionID / kKESCMPopupPrintMarksActionID /
		//  kKESCMPopupOpacity25ActionID / kKESCMPopupOpacity75ActionID)。ボタン/チェック/ラジオは撤去し、
		//  以下を上へ詰めた。パネルに残るのは Target/Source・セパレータ・Prev/Next・ステータス+アイコン。)

		// Change navigation: jump the Target layout view to the previous / next page that carries a
		// KESCM mark (changed ring, Added border, or overflow "/"). Handled by KESCMChangeNav.cpp.
		// レイアウトは KESCL パネルにならい「[Prev]  3/12  [Next]」。ボタンは文字幅相当(幅48)まで詰め、
		// 中央に現在位置(kKESCMNavPosTextWidgetID)を置く(2026-07-15 ユーザー指定)。左右マージンは12pxで対称。
		ButtonWidget
		(
			kKESCMPrevChangeButtonWidgetID,
			kSysButtonPMRsrcId,
			kBindLeft | kBindTop,
			Frame(23, 48, 81, 70)		// 幅58維持。クラスタは中央寄せのまま Prev/Next 間を +8px 広げた(左右マージン27→23px対称, 2026-07-25)
			kTrue, kTrue,
			kKESCMPrevChangeKey,
		),
		// Prev/Next の間の現在位置表示「3/12」(中央揃え)。値は KESCMChangeNav.cpp が KESCMSetNavPosition で
		// 実行時に埋める(初期は空)。旧来はステータス行に出していたが、KESCL 風にボタン間へ移設(2026-07-15)。
		StaticTextWidget
		(
			kKESCMNavPosTextWidgetID,
			kSysStaticTextPMRsrcId,
			kBindLeft | kBindTop,
			Frame(81, 51, 133, 70)		// Prev(〜81)と Next(133〜)の間(幅44→52=隙間を少し広げた, 2026-07-25)。縦位置合わせで top を +3px
			kTrue, kTrue,
			kAlignCenter, kEllipsizeEnd, kTrue,
			"",							// 初期テキストは空(実行時に位置を設定)
			kInvalidWidgetID,
		),
		ButtonWidget
		(
			kKESCMNextChangeButtonWidgetID,
			kSysButtonPMRsrcId,
			kBindLeft | kBindTop,
			Frame(133, 48, 191, 70)		// 幅58維持・右マージン23pxで Prev と対称(クラスタ中央寄せ, 2026-07-25)
			kTrue, kTrue,
			kKESCMNextChangeKey,
		),

		// Status icon (OFF visible by default; the observer swaps ON/OFF based on the armed state).
		// KESCMIconWidget (not the plain RollOverIconButtonWidget) so it carries IID_ITIP (tooltip).
		KESCMIconWidget
		(
			kKESCMIconOffWidgetID,
			kKESCMIconOffResID, kKESCMPluginID,
			kBindTop,
			Frame(174, 113, 206, 145)	// 32×32・右寄せ。ステータス欄(4行・下端145)に合わせて下寄せ(top113/bottom145、パネル下端153まで8pxマージン)。ステータス欄+12px広げた分、右へ152→164。パネル+10px 拡張で 164→174(2026-07-15)。ON側と同座標
			kTrue, kTrue,
			kADBEIconSuiteButtonType,
		),
		KESCMIconWidget
		(
			kKESCMIconOnWidgetID,
			kKESCMIconOnResID, kKESCMPluginID,
			kBindTop,
			Frame(174, 113, 206, 145)	// 32×32・右寄せ。ステータス欄(4行・下端145)に合わせて下寄せ(top113/bottom145、パネル下端153まで8pxマージン)。ステータス欄+12px広げた分、右へ152→164。パネル+10px 拡張で 164→174(2026-07-15)。OFF側と同座標
			kFalse, kTrue,
			kADBEIconSuiteButtonType,
		),

		// Status text (filled in by the observer with the result of each action).
		StaticMultiLineTextWidget
		(
			kKESCMStatusTextWidgetID,
			kPMRsrcID_None,
			kBindLeft | kBindRight | kBindTop,
			Frame(8, 76, 170, 145)		// 右170まで=イラスト(174-206)と横並び(4px間隔)。下端を 128→145 に拡張(3→4行)。メッセージ部分を+12px広げるためパネル全体も192→204に拡張(2026-07-14)。さらに+10px拡張で右 160→170・パネル204→214(2026-07-15)
			kTrue, kTrue,
			kAlignLeft, kDontEllipsize, kTrue,
			kInvalidWidgetID,
			kPaletteWindowFontId,
			4,
			2, 0,
			"",
		),
	}

	kKESCMInternalPopupMenuNameKey		// Popup (flyout) menu name (internal)
};

