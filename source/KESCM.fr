// (SpreadID.h / DocFrameworkID.h were only here for the old scripting API, which is gone -
//  removed 2026-08-05. Everything below resolves from ShuksanID.h / widgetid.h / GraphicsID.h
//  and the tool headers.)
// AppFrameworkID.h came back on 2026-08-06 with app.kcmStatus: it defines
// kApplicationObjectScriptElement, the object the property is put on. The official scripting
// sample credits this header with exactly that (BPI.fr:55).
#include "AppFrameworkID.h"
// ScriptInfoTypes.fh came back on 2026-08-06. This single header is enough for the resource at
// the end of this file: it also pulls in ScriptingID.h (kCoreScriptManagerBoss) and defines
// kCS5ScriptVersion.
// ★2026-08-15 (Task 6B-2): the reason it was added has MOVED. It came in for the toolbox tool's
//   ScriptID registration (kToolBoxEnumScriptElement, ITool.h:192-223) - and the tool is a UI boss,
//   so that Enumerator now lives in KCMUI.fr. What keeps this header here is the OTHER half of the
//   same resource: app.kcmStatus and app.kcmBookResult, served by kKESCMScriptProviderBoss.
#include "ScriptInfoTypes.fh"	// VersionedScriptElementInfo / Property / Provider
// DocumentID.h came back on 2026-08-06 for a different reason than the old scripting API: the
// close-document responder boss names the API's OWN service provider implementation instead of
// carrying a hand-written one (see that Class below).
#include "DocumentID.h"	// kAfterCloseDocSignalRespServiceImpl
#include "GraphicsID.h"	// IID_IDRWEVTHANDLER (the comparison marks' draw service - the whole point of the model half)
						// ★2026-08-15 (Task 10): IID_ISPRITE / IID_IPATHGEOMETRY / kPathGeometryImpl left with the
						//   tracker in Task 6B-2. Only the draw-event handler is still declared on this side.

// Project includes:
#include "KESCMID.h"
#include "KESCMScriptingDefs.h"	// p_KESCMStatus / p_KESCMBookResult (this half's two read-only properties)
								// ★2026-08-15 (Task 6B-2): en_KESCMTool (the toolbox tool's ScriptID) moved to
								//   the UI half's copy of this header, with the tool.
// (GenericID.h / TextID.h and a duplicate ShuksanID.h were scripting-era leftovers with no
//  remaining reference in this file - removed 2026-08-05.)


#ifdef __ODFRC__

/*  
 * Plugin version definition.
 */
resource PluginVersion (kSDKDefPluginVersionResourceID)
{
	kTargetVersion,
	kKESCMPluginID,
	kSDKDefPlugInMajorVersionNumber, kSDKDefPlugInMinorVersionNumber,
	kSDKDefHostMajorVersionNumber, kSDKDefHostMinorVersionNumber,
	kKESCMCurrentMajorFormatNumber, kKESCMCurrentMinorFormatNumber,
	{ kInDesignProduct },
	{ kWildFS },
	kUIPlugIn,
	kKESCMVersion
};

/*  
 * The ExtraPluginInfo resource adds extra information to the Missing Plug-in dialog
 * that is popped when a document containing this plug-in's data is opened when
 * this plug-in is not present. These strings are not translatable strings
 * since they must be available when the plug-in isn't around. They get stored
 * in any document that this plug-in contributes data to.
 */
resource ExtraPluginInfo(1)
{
	kKESCMCompanyValue,			// Company name
	kKESCMMissingPluginURLValue,	// URL 
	kKESCMMissingPluginAlertValue,	// Missing plug-in alert text
};

/* 
 * Boss class definitions.
 */
resource ClassDescriptionTable(kSDKDefClassDescriptionTableResourceID)
{{{
	Class
	{
		kKESCMDrawEventServiceBoss,
		kInvalidClass,
		{
			IID_IK2SERVICEPROVIDER, kKESCMDrawEventSrvcImpl,
			IID_IDRWEVTHANDLER,     kKESCMDrawEventHandlerImpl,
		}
	},

	// Startup/shutdown service. The middle-button watcher was removed (2026-07-13); this now only
	// tears down held resources at app shutdown (see KESCMPeekStartup in KESCMPeek.cpp).
	//
	// !!! 2026-08-14 - BEFORE switching this plug-in to kModelPlugIn (split stage 2), settle the
	// threading policy of this service. Guide vol1-07 "Threading and startup/shutdown services" states
	// that a startup/shutdown boss living in a MODEL plug-in is called on background thread startup and
	// shutdown too. KESCMPeekStartup::Shutdown() wipes the entire comparison state (DropAll, DropOverset,
	// page map / check / hide-unchanged, story list), so being called per background thread would erase
	// the marks on every PDF export - which is exactly what stage 2 is trying to make work.
	// Note kLazyStartupShutdownProviderImpl is NOT one of the three implementations the guide documents
	// (kCMainThreadStartupShutdownProviderImpl / kCMTStartupShutdownProviderImpl /
	// kCStartupShutdownProviderImpl), and IStartupShutdownService.h:44-47 says nothing about threading,
	// so the behaviour has to be measured - see Task 11B in the stage 2 plan. If it does get called on
	// background threads, switch to kCMainThreadStartupShutdownProviderImpl HERE (fix it in the resource,
	// not by adding an "am I on a background thread" guard inside Shutdown(); such a guard risks skipping
	// the real shutdown as well).
	Class
	{
		kKESCMPeekStartupBoss,
		kInvalidClass,
		{
			IID_ISTARTUPSHUTDOWN,   kKESCMPeekStartupImpl,
			IID_IK2SERVICEPROVIDER, kLazyStartupShutdownProviderImpl,
		}
	},

	// Document-close responder. IResponder cleans up any of KESCM's tracked, now-closed documents.
	//
	// A boss that answers ONE signal does not need a ServiceProvider of its own: naming the API's
	// kAfterCloseDocSignalRespServiceImpl (DocumentID.h) registers this responder for that signal.
	// CServiceProvider + HasMultipleIDs is only for a boss that answers several signals at once,
	// the shape linksui/ClosingDocumentsResponder.cpp needs for its three.
	// Same shape as spellpanel/SpellPanelClass.fr:830, transparencyeffect/TranFx.fr:280
	// ("Provided by API.") and KBS.fr:384. KESCM carried a hand-written KESCMDocServiceProvider
	// until 2026-08-06 - it did exactly what the API's implementation does.
	Class
	{
		kKESCMDocResponderServiceBoss,
		kInvalidClass,
		{
			IID_IK2SERVICEPROVIDER, kAfterCloseDocSignalRespServiceImpl,
			IID_IRESPONDER,         kKESCMDocResponderImpl,
		}
	},

	// The boundary the UI goes through to reach the comparison engine (2026-08-13, Stage 1 Task 11).
	//
	// Once the model and the UI are separate plug-ins, a free function declared in a shared header
	// cannot be linked - its body lives in the other .pln - so every call that crosses the boundary
	// has to go through an interface on a boss. Putting it on kUtilsBoss is what the SDK's own
	// model/UI pair does: customconditionaltext publishes ICusCondTxtFacade here (CusCondTxt.fr:159-169,
	// "Puts our command facade onto the Utils boss to let client code use it") and its UI half calls
	// Utils<ICusCondTxtFacade>() and nothing else.
	//
	// WARNING: the implementation named here must be OUR OWN. Adding somebody else's stock
	// implementation to an existing boss is how you collide with another vendor's plug-in and fail to
	// load, and the unit of collision is the ImplementationID, not the IID.
	//
	// Tasks 12-15 add their four interfaces to THIS block - they do not open a second AddIn.
	AddIn
	{
		kUtilsBoss,
		kInvalidClass,
		{
			// Implementation: KESCMFacades.cpp
			IID_IKESCMCOMPAREFACADE, kKESCMCompareFacadeImpl,
			IID_IKESCMMARKDATA, kKESCMMarkDataImpl,
			IID_IKESCMPAGEFLAGSFACADE, kKESCMPageFlagsFacadeImpl,
			IID_IKESCMSTORYEDITSFACADE, kKESCMStoryEditsFacadeImpl,
			IID_IKESCMBOOKFACADE, kKESCMBookFacadeImpl,
		}
	},

	/*
	 * Scripting provider: serves app.kcmStatus and nothing else. Derives from
	 * kBaseScriptProviderBoss, which brings the machinery that dispatches script requests; all this
	 * boss adds is our own handler. The property itself is declared in the
	 * VersionedScriptElementInfo resource at the end of this file. Same shape as KBS
	 * (KBS.fr:406-413), which follows the official scripting sample BPI.fr.
	 */
	Class
	{
		kKESCMScriptProviderBoss,
		kBaseScriptProviderBoss,
		{
			IID_ISCRIPTPROVIDER, kKESCMScriptProviderImpl,
		}
	},
}}};

/*  
 * Implementation definition.
 */
resource FactoryList (kSDKDefFactoryListResourceID)
{
	kImplementationIDSpace,
	{
		#include "KESCMFactoryList.h"
	}
};

/*
 * String LocaleIndex (2026-08-15, split stage 2 task 6B-2).
 *
 * ★The model half owns exactly ONE string: kKESCMHideConfirmKey, the alert shown before
 * "Hide Unchanged Spreads" changes the document. Everything else - menus, the panel, the
 * dialog, How to Use - moved to KCMUI with the widgets that show it.
 *
 * Only k_Wild is listed, and that is not a shortcut. The thirteen locales KESCM used to
 * enumerate ALL pointed at index_enUS anyway (the jaJP table was retired 2026-08-05; Japanese
 * is switched at run time in KESCMLoc.h), so with one table the wildcard row says the same
 * thing in one line. ⚠Without a k_Wild row, locales outside the list get no table at all and
 * the raw key is displayed - measured 2026-08-05.
 */
resource LocaleIndex ( kSDKDefStringsResourceID)
{
	kStringTableRsrcType,
	{
		kWildFS, k_Wild, kSDKDefStringsResourceID + index_enUS
	}
};

/*
 * What KESCM adds to the object model: one read-only property (two, counting the book result).
 *
 * ⚠2026-08-15 (split stage 2 task 6B-2): THE TOOL'S ENUMERATOR ENTRY LEFT THIS RESOURCE.
 * It registers the toolbox tool's ScriptID, and the tool is a UI boss, so it now lives in
 * KCMUI.fr's own VersionedScriptElementInfo. What stays here is what the model half answers:
 * app.kcmStatus and app.kcmBookResult, served by kKESCMScriptProviderBoss.
 * ★The paragraph below is kept because it is the record of WHY the tool has a ScriptID at all;
 * the same text is in KCMUI.fr next to the entry itself.
 *
 * The tool entry is what ITool.h:192-223 spells out (its worked example is "the pumpkin tool"):
 * define a ScriptID (KESCMScriptingDefs.h), add it to kToolBoxEnumScriptElement here, and return
 * it from ITool::GetScriptID (KESCMTool.cpp). The second string is the name scripts see:
 * "kohaku change marker tool" surfaces as UITools.KOHAKU_CHANGE_MARKER_TOOL, so a script can both
 * read app.toolBoxTools.currentTool and assign to it to select this tool - neither was possible
 * while GetScriptID returned en_None (measured 2026-08-06, audit block 7).
 * Same shape as the official samples: snapshot (Snap.fr:2085-2101) / wavetool (WavTl.fr:319-336).
 *
 * app.kcmStatus (added 2026-08-06 at the user's request) is the panel's status line, read-only.
 * It is the same idea as KBS's app.kfcStatus (KBS.fr:1273-1313) and exists for the same reason:
 * the status line is the plug-in's account of what it just did, and until now reading it meant
 * looking at the screen, which cannot be automated. KESCM still publishes NO methods.
 */
resource VersionedScriptElementInfo(10)
{
	//Contexts
	{
		// ★★feature set が kInDesignAllLanguagesFS(=InDesign 全言語。InCopy と InDesign Server を除く)
		//   なのは**正しい**。手本 = snapshot/Snap.fr:2089 —— **SnapTool の ScriptID を
		//   kToolBoxEnumScriptElement へ登録しているリソースが、まさに同じ kInDesignAllLanguagesFS 単独**。
		//   理由もはっきりしている: **ツールボックスは InDesign デスクトップにしか無い**(InCopy にも
		//   Server にも無い)ので、ツールの列挙子を登録する context は InDesign に絞るのが筋。
		//   ★同じ snapshot が **Snap.fr:1795 では kWildFS を使っている**(あちらはツールを含まない
		//     スクリプト API のリソース) ＝ **公式は1つのプラグイン内で内容によって使い分けている。**
		//   ⚠**KBS(KBS.fr:1282)が kWildFS なのは割れではない**。KBS のリソースは Property だけで
		//     ツールを含まないため。**内容が違うので正しく違う。**
		// ⚠2026-08-07 に一度 kWildFS へ変えたが**同日中に撤回した**。「kInDesignAllLanguagesFS 単独の
		//   公式実例はゼロ」と判定したのが誤りで、走査結果の件数上限で Snap.fr:2089 を見落としていた
		//   (経緯 = docs/ai-notes/kescm-api-audit-block14-2026-08-07.md の A-1)。
		// ★script version は kCS5。公式サンプルは CS2〜CS5〜Firedrake と幅があり、新しい版を選ぶこと
		//   自体が公式の範囲内(CustSE / XDocBk / **Snap.fr:2089 のツール登録も kCS5**)。
		kCS5ScriptVersion, kCoreScriptManagerBoss, kInDesignAllLanguagesFS, k_Wild,
	}
	//Elements
	{

		Property
		{
			kKESCMStatusPropertyScriptElement,	// this property's script element ID
			p_KESCMStatus,						// ScriptID (KESCMScriptingDefs.h)
			"kcm status",						// name -> app.kcmStatus
			"The last message the Kohaku Change Marker panel put on its status line.",
			StringType,							// type
			{}									// alternate types
			kNoAttributeClass,					// attribute class ID
		}

		// app.kcmBookResult (2026-08-11) - the last book comparison, one line per chapter,
		// "name<TAB>state". Same shape and same purpose as the property above: the status line
		// holds one line, so the per-chapter answers need their own way out to be checkable
		// without looking at the screen.
		Property
		{
			kKESCMBookResultPropertyScriptElement,
			p_KESCMBookResult,
			"kcm book result",					// name -> app.kcmBookResult
			"The last book comparison, one line per chapter: name, tab, state.",
			StringType,
			{}
			kNoAttributeClass,
		}

		// Puts the property ON the application object.
		//
		// Object{}, not Parent{}: Object names an EXISTING scripting object to add members to,
		// while Parent hangs a NEW object underneath one. BPI.fr:603-612 is the form followed here
		// (and KBS.fr:1305-1313, which learned it the hard way - with Parent the property never
		// appeared on app at all).
		Provider
		{
			kKESCMScriptProviderBoss,
			{
				Object{ kApplicationObjectScriptElement },
				Property{ kKESCMStatusPropertyScriptElement, kReadOnly },
				Property{ kKESCMBookResultPropertyScriptElement, kReadOnly },
			}
		}
	}
};

#endif // __ODFRC__

#include "KESCM_enUS.fr"
