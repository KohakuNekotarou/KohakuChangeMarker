#include "VCPlugInHeaders.h"

// General includes:
#include "LocaleIndex.h"
#include "PMLocaleIds.h"
#include "StringTable.fh"
#include "ObjectModelTypes.fh"
#include "ShuksanID.h"
#include "BuildNumber.h"
#include "PlugInModel_UIAttributes.h"

// (SpreadID.h / DocFrameworkID.h were only here for the old scripting API, which is gone -
//  removed 2026-08-05. Everything below resolves from ShuksanID.h / widgetid.h / GraphicsID.h
//  and the tool headers.)
// AppFrameworkID.h came back on 2026-08-06 with app.kcmStatus: it defines
// kApplicationObjectScriptElement, the object the property is put on. The official scripting
// sample credits this header with exactly that (BPI.fr:55).
#include "AppFrameworkID.h"
// ScriptInfoTypes.fh came back on 2026-08-06. This single header is enough for the resource at
// the end of this file: it also pulls in ScriptingID.h (kCoreScriptManagerBoss) and defines
// kCS5ScriptVersion.
// ★2026-08-15 (Task 6B-2): the reason it was added has MOVED. It came in for the toolbox tool's
//   ScriptID registration (kToolBoxEnumScriptElement, ITool.h:192-223) - and the tool is a UI boss,
//   so that Enumerator now lives in KCMUI.fr. What keeps this header here is the OTHER half of the
//   same resource: app.kcmStatus and app.kcmBookResult, served by kKESCMScriptProviderBoss.
#include "ScriptInfoTypes.fh"	// VersionedScriptElementInfo / Property / Provider
// DocumentID.h came back on 2026-08-06 for a different reason than the old scripting API: the
// close-document responder boss names the API's OWN service provider implementation instead of
// carrying a hand-written one (see that Class below).
#include "DocumentID.h"	// kAfterCloseDocSignalRespServiceImpl
#include "DocFrameworkID.h"	// kDocumentObjectScriptElement (document.kcmTransparencyItemCount の対象オブジェクト)
#include "PDFID.h"	// kPDFExportSetupServiceImpl / IID_IPDFEXPORTSETUPPROVIDER (PDF 書き出しのあいだだけ
					// 透明を申告する - 下の boss)。⚠これが無いと ODFRC が
					// "R32725: Identifier 'kPDFExportSetupServiceImpl' does not name a numeric value." で落ちる
#include "GraphicsID.h"	// IID_IDRWEVTHANDLER (the comparison marks' draw service - the whole point of the model half)
#include "GenericID.h"	// IID_IADORNMENTSHAPE (GenericID.h:279) - the adornment route for the same marks
#include "XPID.h"	// IID_IADORNMENTFLATTENERUSAGE (XPID.h:513) - how the adornment declares its transparency
#include "TextID.h"	// kGlobalTextAdornmentServiceImpl / IID_IGLOBALTEXTADORNMENT - the Story mode's marks
					// (★moved here from the UI half on 2026-08-23; IID_IIDLETASK for their timer is
					//  already in ShuksanID.h above)
					// to the flattener. This is the whole reason the adornment route exists: without it,
					// a translucent ring goes solid in PDF 1.3. Declaring is necessary but NOT sufficient -
					// nobody asks unless the document is on IXPManager's item-has-transparency list, which
					// is what KESCMRingAdornmentRefreshItemXPState() pokes (found and fixed 2026-08-20).
						// ★2026-08-15 (Task 10): IID_ISPRITE / IID_IPATHGEOMETRY / kPathGeometryImpl left with the
						//   tracker in Task 6B-2. ★2026-08-19 (bug recheck B-U6): the tracker does not declare
						//   them either any more - CTracker never queries ISprite, so only CPathCreationTracker /
						//   CLayoutTracker descendants need them (see KCMUI.fr's kKESCMTrackerBoss Class).
						//   Only the draw-event handler is still declared on this side.

#include "INXCoreID.h"	// kINXScriptManagerBoss (INXCoreID.h:58) - the Contexts of the INX-only
						// resource at the end of this file, which keeps the story counters out of IDML
#include "TextScriptID.h"	// kStoryObjectScriptElement (TextScriptID.h:49) - the story object the
							// four change-counter properties are added to (2026-08-15)

// Project includes:
#include "KESCMID.h"
#include "KESCMScriptingDefs.h"	// p_KESCMStatus / p_KESCMBookResult (this half's two read-only properties)
								// + the four story counters: p_KESCMChangeCount and friends (2026-08-15)
								// ★2026-08-15 (Task 6B-2): en_KESCMTool (the toolbox tool's ScriptID) moved to
								//   the UI half's copy of this header, with the tool.
// (GenericID.h / TextID.h and a duplicate ShuksanID.h were scripting-era leftovers with no
//  remaining reference in this file - removed 2026-08-05.)


#ifdef __ODFRC__

/*  
 * Plugin version definition.
 */
resource PluginVersion (kSDKDefPluginVersionResourceID)
{
	kTargetVersion,
	kKESCMPluginID,
	kSDKDefPlugInMajorVersionNumber, kSDKDefPlugInMinorVersionNumber,
	kSDKDefHostMajorVersionNumber, kSDKDefHostMinorVersionNumber,
	kKESCMCurrentMajorFormatNumber, kKESCMCurrentMinorFormatNumber,
	{ kInDesignProduct },
	{ kWildFS },
	// ★★★2026-08-15 (Stage 2, Task 11): kUIPlugIn -> kModelPlugIn. THIS IS THE LINE THE WHOLE
	//   SPLIT WAS FOR. PlugInModel_UIAttributes.h:31-32 - a plug-in declares one or the other,
	//   never both, and this field is what decides whether the plug-in is available to work that
	//   runs on BACKGROUND THREADS (gs-03:50 "Only model plug-ins are available for operations
	//   that occur on background threads").
	//   ⇒ From here on, the comparison marks' draw handler can be reached by the PDF export.
	//   ⚠What this also means: every boss declared in THIS file must be reachable without the UI.
	//     The three object-model rules are checked at startup (guide vol1-07); breaking rule 3 is
	//     the dangerous one because it only warns and then IGNORES the override.
	kModelPlugIn,
	kKESCMVersion
};

/*  
 * The ExtraPluginInfo resource adds extra information to the Missing Plug-in dialog
 * that is popped when a document containing this plug-in's data is opened when
 * this plug-in is not present. These strings are not translatable strings
 * since they must be available when the plug-in isn't around. They get stored
 * in any document that this plug-in contributes data to.
 */
resource ExtraPluginInfo(1)
{
	kKESCMCompanyValue,			// Company name
	kKESCMMissingPluginURLValue,	// URL 
	kKESCMMissingPluginAlertValue,	// Missing plug-in alert text
};

/* 
 * Boss class definitions.
 */
resource ClassDescriptionTable(kSDKDefClassDescriptionTableResourceID)
{{{
	// (★2026-08-20: kKESCMDrawEventServiceBoss（kDrawEventService + IID_IDRWEVTHANDLER）はここにあったが
	//  撤去した。マークの描画は下のグローバルページアイテムアドーンメントに**一本化**した
	//  ＝ユーザー判断「登録に失敗していたら枠が出なくてよい」。残していたのはフォールバックのためだけで、
	//  削除した HandleDrawEvent の中身は「アドーンメントが生きていれば return / さもなくば
	//  DrawSpreadMarks を呼ぶ」の2行しかなかった＝**絵は1つも失われていない**。)

	/** The comparison marks, painted as a GLOBAL page item adornment. Registered once on the
		session's global adornment list at startup
		(KESCMRingAdornment.cpp), so it is never attached to anything in the document - the
		.indd is not touched at all. Only one of the two routes paints; the draw event handler
		stands down while this one is registered.

		WHY IT EXISTS: the translucent ring is drawn with an alpha server, and in PDF 1.3 the
		mask only gets resolved if the flattener runs - otherwise the ring comes out solid.
		Japanese print-submission presets are almost all 1.3 (PDF/X-1a, X-3, magazine ad
		delivery - all Acrobat 4). The fix is to make the transparency manager notice us, and
		the only place it asks is IID_IADORNMENTFLATTENERUSAGE - which lives on adornment
		bosses, never on a draw event service boss. Hence this boss.

		⚠ Being asked is a second, separate condition, and it took until 2026-08-20 to find:
		the flattener only runs at all when the document is on IXPManager's list of page items
		that have transparency, and a session-global adornment is on no item, so it can never
		join that list by itself. transparencyeffect gets this for free because it attaches its
		adornment to real items with a command and notifies right after (TranFxUtils.cpp:451).
		KESCM says the same thing by hand, without touching the document, in
		KESCMRingAdornmentRefreshItemXPState().

		The two-interface shape (adornment + flattener usage) is exactly what
		sdksamples/transparencyeffect does (TranFx.fr:150-156). */
	Class
	{
		kKESCMRingAdornmentBoss,
		kInvalidClass,
		{
			IID_IADORNMENTSHAPE,          kKESCMRingAdornmentImpl,
			IID_IADORNMENTFLATTENERUSAGE, kKESCMRingFlattenerUsageImpl,
		}
	},

	/** Registers the adornment above on the session's global list - ONCE PER EXECUTION CONTEXT.
		It exists as a boss of its own for one reason, and the reason is not tidiness:

		A global TEXT adornment needs none of this. It is declared as a service
		(IID_IK2SERVICEPROVIDER, kGlobalTextAdornmentServiceImpl - spellpanel's dynamic spelling
		squiggle is exactly that, SpellPanelClass.fr:773-774) and the service registry resolves it
		separately in every execution context, background threads included. There is no equivalent
		for page item adornments: the only thing the API ships on that side is
		kGlobalPageItemAdornmentListImpl, the list itself, not a service provider. So the
		per-context registration that a service would do for free has to be done by hand, here.

		WHY NOT FOLD IT INTO kKESCMPeekStartupBoss: that one is deliberately pinned to the main
		thread (kCMainThreadStartupShutdownProviderImpl) because its Shutdown() throws away the
		entire comparison state - run it on every background thread teardown and the marks vanish
		on every PDF export, which is a bug that was found and fixed in 2026-08-15. This service
		only adds and removes a registration, so it is safe - and useless - unless it runs on
		every thread. Hence a separate boss with the plain (not main-thread-only) provider.

		★ kCStartupShutdownProviderImpl, NOT kLazyStartupShutdownProviderImpl - and this is a
		deliberate departure from the documented preference. IStartupShutdownService.h:44-47 says
		to prefer Lazy ("you should use kLazyStartupShutdownProviderImpl to avoid slowing down
		launch time"), and the SDK follows it 6 files to 4. It does not work here, and the
		difference was measured rather than reasoned about (2026-08-19, PDF 1.3, same document):

		    provider                              main thread     background thread
		    kCStartupShutdownProviderImpl         74,503 px       74,503 px      (translucent)
		    kLazyStartupShutdownProviderImpl      74,503 px       852,047 px     (SOLID - not registered)

		Lazy runs from an idle task after startup completes, and a background export thread never
		gets there - so the registration this service exists to perform never happens on the very
		thread that needs it. The launch-time cost being avoided is two Query calls. */
	Class
	{
		kKESCMRingAdornmentStartupBoss,
		kInvalidClass,
		{
			IID_IK2SERVICEPROVIDER, kCStartupShutdownProviderImpl,
			IID_ISTARTUPSHUTDOWN,   kKESCMRingAdornmentStartupImpl,
		}
	},

	// Startup/shutdown service. The middle-button watcher was removed (2026-07-13); this now only
	// tears down held resources at app shutdown (see KESCMPeekStartup in KESCMPeek.cpp).
	//
	// ***** SETTLED 2026-08-15 (Stage 2, Task 11B). The TODO that stood here is answered. *****
	//
	// THE DANGER: guide vol1-07 "Threading and startup/shutdown services" says a startup/shutdown boss
	// living in a MODEL plug-in is called on background thread startup and shutdown TOO. And
	// KESCMPeekStartup::Shutdown() wipes the entire comparison state - DropAll, DropAllOrig,
	// DropOverset, the page map, the checks, hide-unchanged, the story list, the peek arming. Called
	// once per background thread, it would erase the marks on every PDF export, which is the exact
	// thing this stage exists to make work.
	//
	// THE FIX IS HERE, IN THE RESOURCE, NOT IN Shutdown(). An "am I on a background thread" guard
	// inside Shutdown() would risk skipping the REAL shutdown as well; the threading policy is what
	// the guide gives us to say this properly.
	//
	// ★kCMainThreadStartupShutdownProviderImpl - and this is not a guess. Adobe's own DiagnosticLog
	//   is a kModelPlugIn (DiagLogClass.fr:59) that names exactly this implementation for exactly this
	//   reason, and says so (DiagLogClass.fr:93-100):
	//       "This is a model plug-in, but we only want the startup shutdown service to run in main thread."
	//   SDK-wide there are 2 users of it; the other (xmlcataloghandler) is boilerplate with no comment.
	//   ⇒ The threading question needed no measurement once the precedent was found.
	//
	// ⚠WHAT DID CHANGE IS THE TIMING, and the guide does not discuss it. kLazyStartupShutdownProviderImpl
	//   runs through kAppLazyStartupShutdownService - an idle task AFTER startup completes (gs-06) -
	//   while this one does not, so Startup() now runs EARLIER. That is safe here for a plain reason:
	//   ★KESCMPeekStartup::Startup() IS EMPTY. Stage 1 Task 8 moved all three startup jobs to the UI
	//   half (panel state restore / batch-close subscription / translucency subscription), so there is
	//   nothing left that could depend on "after startup". If work ever comes back to Startup(), check
	//   this assumption again before adding it.
	Class
	{
		kKESCMPeekStartupBoss,
		kInvalidClass,
		{
			IID_ISTARTUPSHUTDOWN,   kKESCMPeekStartupImpl,
			// This is a model plug-in, but we only want the startup shutdown service to run in
			// main thread. (Same line, same reason, as Adobe's DiagLogClass.fr:93-100.)
			IID_IK2SERVICEPROVIDER, kCMainThreadStartupShutdownProviderImpl,
		}
	},

	// Document-close responder. IResponder cleans up any of KESCM's tracked, now-closed documents.
	//
	// A boss that answers ONE signal does not need a ServiceProvider of its own: naming the API's
	// kAfterCloseDocSignalRespServiceImpl (DocumentID.h) registers this responder for that signal.
	// CServiceProvider + HasMultipleIDs is only for a boss that answers several signals at once,
	// the shape linksui/ClosingDocumentsResponder.cpp needs for its three.
	// Same shape as spellpanel/SpellPanelClass.fr:830, transparencyeffect/TranFx.fr:280
	// ("Provided by API.") and KBS.fr:384. KESCM carried a hand-written KESCMDocServiceProvider
	// until 2026-08-06 - it did exactly what the API's implementation does.
	Class
	{
		kKESCMDocResponderServiceBoss,
		kInvalidClass,
		{
			IID_IK2SERVICEPROVIDER, kAfterCloseDocSignalRespServiceImpl,
			IID_IRESPONDER,         kKESCMDocResponderImpl,
		}
	},

	// ***** THE OTHER HALF: undo our edit to the USER'S document before it reaches the file. *****
	// The responder above answers AfterClose, which is right for DROPPING our own tracked state.
	// It is wrong for RESTORING something in the user's document, and so is BeforeClose - MEASURED,
	// not assumed (2026-08-19): a diagnostic build reported IDataBase::IsModified() == 0 on
	// kBeforeCloseDoc, i.e. THE SAVE HAS ALREADY HAPPENED by then. Restoring there put the spreads
	// back on screen and left the document dirty again, but the file on disk still had them hidden.
	//
	// So the hook has to sit on the SAVE, not on the close. kBeforeSaveDoc covers both ways a
	// document reaches the disk: File > Save, and the save that a close performs.
	// ⚠ Save As and Save a Copy raise their own signals (kBeforeSaveAsDoc /
	// kBeforeSaveACopyDoc, DocumentID.h:318,321) and are NOT covered here.
	//
	// ★Still the "one signal, one boss, no ServiceProvider of its own" shape as above - the
	// CServiceProvider + HasMultipleIDs shape is only needed by a boss answering several signals,
	// which linksui/ClosingDocumentsResponder.cpp does and this does not.
	Class
	{
		kKESCMBeforeSaveResponderServiceBoss,
		kInvalidClass,
		{
			IID_IK2SERVICEPROVIDER, kBeforeSaveDocSignalRespServiceImpl,
			IID_IRESPONDER,         kKESCMBeforeSaveResponderImpl,
		}
	},

	// ★★★2026-08-20: 透明の申告を「書き出しのあいだだけ」立てる boss。
	//
	// ⚠**なぜ要るか**＝IXPManager の「透明を持つページアイテムの一覧」は**文書側のデータで .indd に永続する**
	//   (実測＝比較して保存した文書を開き直すと1件残っており、開くだけでは再検証されない)。比較中ずっと
	//   載せておくと、ユーザーが保存した瞬間に**根拠のない記録が焼き付く**。⇒ **要る瞬間だけ載せる。**
	//   ★フラットナが要るのは書き出しのときだけで、画面描画にもサムネイルにも一覧は要らない。
	// ★手本＝customconditionaltext (PDF と印刷の両方で「前に変えて後で戻す」を実装している唯一のサンプル)。
	// ⚠**保存の前後(kBeforeSaveDoc)には置かない** ---- そこで落ちると文書を失う。書き出しならやり直せる。
	// 実装は KESCMRingAdornment.cpp の末尾(透明の申告と同じ関心事なので同居させている)。
	//
	// ★★★**印刷側の対(kPrintSetupService + IPrintSetupProvider)は置かない。**
	//   ⚠**効かないからではない。効く** ---- 印刷でも載せればフラットナが走り、マークが濃くなる
	//   (実測＝載せると色付き画素 16,076/13,635 / 載せないと 8,407/7,379＝**1.5.0 と同じ薄さ**。
	//    ★ただし**どちらもベタにはならない**＝差は濃度だけで、PDF 1.3 の全面ベタとは別の壊れ方)。
	//   ★**外した理由は「印刷にそこまでの厳密性は要らない・印刷会社へ出すのは PDF」というユーザー判断**
	//   (2026-08-20・実機で確認済み)。⇒ 濃度を揃えたくなったら bd44eec の実装ごと戻す。
	//   詳細と A/B の条件は KESCMRingAdornment.cpp の節5 のコメント。

	// ★★★PDF 書き出し: BeginExport で載せ、EndExport で降ろす。
	//   **非同期書き出しではここに「書き出し用のクローン db」が渡る**ので、
	//   **元の文書を一度も触らずに出力だけを変えられる**(2026-08-20 実測)。
	//   ⚠**旧実装(kBeforeExport/kAfterExport/kFailedExport の3シグナル)には穴があった** ----
	//     シグナルはメインスレッドで**元の db** を持って飛ぶので、書き出し中にユーザーが保存すると
	//     一覧が .indd に焼き付いた(実測＝開き直すと kcmTransparencyItemCount が 4)。
	//   ★**ServiceProvider は Adobe 提供の kPDFExportSetupServiceImpl をそのまま名指しする**ので、
	//     自作は IPDFExportSetupProvider の1本だけ＝pdfvt/PDFVT.fr:113-121 と同じ形。
	Class
	{
		kKESCMPDFExportSetupBoss,
		kInvalidClass,
		{
			IID_IK2SERVICEPROVIDER,      kPDFExportSetupServiceImpl,
			IID_IPDFEXPORTSETUPPROVIDER, kKESCMPDFExportSetupImpl,
		}
	},

	// The Story mode's marks: the changed characters themselves, inverted where they stand.
	// ★★A GLOBAL TEXT ADORNMENT - it is drawn ON the characters by the text engine, which hands it
	//   the wax run, so it follows vertical text and rotated frames for free and touches no document
	//   data at all (nothing is attached, nothing is saved, no recomposition). Implementation:
	//   KESCMStoryMarker.cpp; what it should be lighting up: KESCMStoryMarkBuild.cpp.
	// ★Two interfaces, and only one of them is ours: the API already ships the provider for this
	//   service (kGlobalTextAdornmentServiceImpl, TextID.h, service kGlobalTextAdornmentService).
	//   The same pair as the product's dynamic spelling squiggle (SpellPanelClass.fr:768-776).
	// ⚠kInvalidClass as the parent: this boss is not a widget or a page item, it exists only to be
	//   found in the service registry - same as the draw-event service boss above.
	//
	// ★★★MOVED HERE FROM THE UI PLUG-IN ON 2026-08-23 (it was kKCMUIPrefix + 30), so that the marks
	//   can be printed and exported. **The UI's File > Export > PDF runs in the background and a
	//   kUIPlugIn is never handed the drawing** (2026-08-12, measured, no warning), so no guard on
	//   the UI side could have got them into an exported PDF.
	// ★★AND IT NEEDS NO STARTUP SERVICE OF ITS OWN, unlike the page item adornment above: a service
	//   is resolved by the registry separately in every execution context, background threads
	//   included. That is exactly the contrast kKESCMRingAdornmentStartupBoss is documented against.
	Class
	{
		kKESCMStoryMarkerBoss,
		kInvalidClass,
		{
			IID_IK2SERVICEPROVIDER, kGlobalTextAdornmentServiceImpl,
			IID_IGLOBALTEXTADORNMENT, kKESCMStoryMarkerAdornmentImpl,
		}
	},

	// The one-shot timer that takes the JUMP's flash away again about a second later (the standing
	// marks have no clock - a toggle or the button takes those down).
	// ★An idle task rather than a callback timer - the reason is in KESCMStoryMarkerExpiry.h.
	// ★Moved here with the marker above (it was kKCMUIPrefix + 31): the marker starts and stops this
	//   timer, so leaving it on the UI side would have made the model depend on the UI.
	Class
	{
		kKESCMStoryMarkerExpiryBoss,
		kInvalidClass,
		{
			IID_IIDLETASK, kKESCMStoryMarkerExpiryImpl,
		}
	},

	// The boundary the UI goes through to reach the comparison engine (2026-08-13, Stage 1 Task 11).
	//
	// Once the model and the UI are separate plug-ins, a free function declared in a shared header
	// cannot be linked - its body lives in the other .pln - so every call that crosses the boundary
	// has to go through an interface on a boss. Putting it on kUtilsBoss is what the SDK's own
	// model/UI pair does: customconditionaltext publishes ICusCondTxtFacade here (CusCondTxt.fr:159-169,
	// "Puts our command facade onto the Utils boss to let client code use it") and its UI half calls
	// Utils<ICusCondTxtFacade>() and nothing else.
	//
	// WARNING: the implementation named here must be OUR OWN. Adding somebody else's stock
	// implementation to an existing boss is how you collide with another vendor's plug-in and fail to
	// load, and the unit of collision is the ImplementationID, not the IID.
	//
	// Tasks 12-15 add their four interfaces to THIS block - they do not open a second AddIn.
	AddIn
	{
		kUtilsBoss,
		kInvalidClass,
		{
			// Implementation: KESCMFacades.cpp
			IID_IKESCMCOMPAREFACADE, kKESCMCompareFacadeImpl,
			IID_IKESCMMARKDATA, kKESCMMarkDataImpl,
			IID_IKESCMPAGEFLAGSFACADE, kKESCMPageFlagsFacadeImpl,
			IID_IKESCMSTORYEDITSFACADE, kKESCMStoryEditsFacadeImpl,
			IID_IKESCMBOOKFACADE, kKESCMBookFacadeImpl,
			// ★The sixth, added 2026-08-23 when the Story mode's marks moved to this side.
			IID_IKESCMSTORYMARKFACADE, kKESCMStoryMarkFacadeImpl,
		}
	},

	/*
	 * Scripting provider: serves EVERYTHING this plug-in publishes - app.kcmStatus and
	 * app.kcmBookResult on the application object, and the four ITextModel change counters on the
	 * story object. Derives from kBaseScriptProviderBoss, which brings the machinery that dispatches
	 * script requests; all this boss adds is our own handler. The properties themselves are declared
	 * in the VersionedScriptElementInfo resource at the end of this file. Same shape as KBS
	 * (KBS.fr:406-413), which follows the official scripting sample BPI.fr.
	 *
	 * ★★★ONE boss for both objects (2026-08-15). There used to be a SECOND boss here for the story
	 * counters, on the belief that one boss could not keep two objects apart. That was wrong, and
	 * the guide says why: a Property is "added to the script object referenced by the PRECEDING
	 * Object field" (vol1-11:1302), and a provider element "can be defined (used) in multiple
	 * places" (vol1-11:1237). So properties follow the Object that stands before them, and one boss
	 * may own several Provider blocks. basicshape does exactly that with Adobe's own
	 * kPageItemScriptProviderBoss - three blocks inside one VersionedScriptElementInfo whose
	 * Contexts list has a single entry (BscShp.fr:370-404, :317).
	 *
	 * ★実機で確認済み(2026-08-15)＝`'kcmChangeCount' in app` と `'kcmStatus' in story` が**どちらも
	 * false**（互いのメンバーが生えていない）／それぞれの側では読めて値も動く。
	 * See the two Provider blocks at the end of this file and the header of KESCMScriptProvider.cpp.
	 */
	Class
	{
		kKESCMScriptProviderBoss,
		kBaseScriptProviderBoss,
		{
			IID_ISCRIPTPROVIDER, kKESCMScriptProviderImpl,
		}
	},
}}};

/*  
 * Implementation definition.
 */
resource FactoryList (kSDKDefFactoryListResourceID)
{
	kImplementationIDSpace,
	{
		#include "KESCMFactoryList.h"
	}
};

/*
 * String LocaleIndex (2026-08-15, split stage 2 task 6B-2).
 *
 * ★The model half owns exactly ONE string: kKESCMHideConfirmKey, the alert shown before
 * "Hide Unchanged Spreads" changes the document. Everything else - menus, the panel, the
 * dialog, How to Use - moved to KCMUI with the widgets that show it.
 *
 * Only k_Wild is listed, and that is not a shortcut. The thirteen locales KESCM used to
 * enumerate ALL pointed at index_enUS anyway (the jaJP table was retired 2026-08-05; Japanese
 * is switched at run time in KESCMLoc.h), so with one table the wildcard row says the same
 * thing in one line. ⚠Without a k_Wild row, locales outside the list get no table at all and
 * the raw key is displayed - measured 2026-08-05.
 */
resource LocaleIndex ( kSDKDefStringsResourceID)
{
	kStringTableRsrcType,
	{
		kWildFS, k_Wild, kSDKDefStringsResourceID + index_enUS
	}
};

/*
 * What KESCM adds to the object model: one read-only property (two, counting the book result).
 *
 * ⚠2026-08-15 (split stage 2 task 6B-2): THE TOOL'S ENUMERATOR ENTRY LEFT THIS RESOURCE.
 * It registers the toolbox tool's ScriptID, and the tool is a UI boss, so it now lives in
 * KCMUI.fr's own VersionedScriptElementInfo. What stays here is what the model half answers:
 * app.kcmStatus and app.kcmBookResult, served by kKESCMScriptProviderBoss.
 * ★The paragraph below is kept because it is the record of WHY the tool has a ScriptID at all;
 * the same text is in KCMUI.fr next to the entry itself.
 *
 * The tool entry is what ITool.h:192-223 spells out (its worked example is "the pumpkin tool"):
 * define a ScriptID (KESCMScriptingDefs.h), add it to kToolBoxEnumScriptElement here, and return
 * it from ITool::GetScriptID (KESCMTool.cpp). The second string is the name scripts see:
 * "kohaku change marker tool" surfaces as UITools.KOHAKU_CHANGE_MARKER_TOOL, so a script can both
 * read app.toolBoxTools.currentTool and assign to it to select this tool - neither was possible
 * while GetScriptID returned en_None (measured 2026-08-06, audit block 7).
 * Same shape as the official samples: snapshot (Snap.fr:2085-2101) / wavetool (WavTl.fr:319-336).
 *
 * app.kcmStatus (added 2026-08-06 at the user's request) is the panel's status line, read-only.
 * It is the same idea as KBS's app.kfcStatus (KBS.fr:1273-1313) and exists for the same reason:
 * the status line is the plug-in's account of what it just did, and until now reading it meant
 * looking at the screen, which cannot be automated. KESCM still publishes NO methods.
 */
resource VersionedScriptElementInfo(10)
{
	//Contexts
	{
		// ★★★2026-08-17(不具合再検査 B1・D-1): **下の2つを選ばせた根拠は、もうこのリソースに無い。**
		//   2026-08-15(Task 6B-2)に**ツールの列挙子が KCMUI.fr へ出て行った**(上の :282-285)ので、
		//   ここに残るのは **Property だけ**(app 2本 + story 4本)。ところが選択の理由は3つとも
		//   「ツールがある前提」のままだった——旧記述はこう言っていた:
		//     ①feature set が kInDesignAllLanguagesFS なのは、手本 Snap.fr:2089 が**ツールの ScriptID を
		//       kToolBoxEnumScriptElement へ登録するリソース**で、**ツールボックスは InDesign にしか無い**から
		//     ②KBS が kWildFS なのは「KBS は Property だけでツールを含まない＝**内容が違うので正しく違う**」から
		//     ③script version が kCS5 なのは Snap.fr:2089 のツール登録も kCS5 だから
		//   ⇒ ①③の手本は**当たらなくなり**、②の区別は**内容が同じになったので成立しない**。
		//
		// ★**それでも値は据え置く。根拠が入れ替わっただけで、動作は1ビットも変わらないから**:
		//   このプラグインの PluginVersion は対象製品が **{ kInDesignProduct } 単独**(:83)で、InCopy にも
		//   InDesign Server にもロードされない。∴ kInDesignAllLanguagesFS と kWildFS で
		//   **引ける場面が1つも違わない**。★寄せるなら feature set だけを見ないこと＝この resource ID の
		//   「10」も、ツールの手本(ITool.h:202)が選ばせた番号で**同じ日に根拠を失っている**
		//   (Property だけのリソースは 1 が主流＝KBS.fr:1326 / BPI.fr:526 / CusCondTxt.fr:271)。
		//
		// ★★★**script version(kCS5)は 2026-08-18(再検査 B11)に実測した＝これは本当に見える範囲を絞る。**
		//   `app.scriptPreferences.version` を変えながら聞いた結果:
		//       7.0(=kCS5) → 見える ／ **6.0 → 見えない** ／ **5.0 → 見えない** ／ 21.0 → 見える
		//   (`'kcmStatus' in app` も `'kcmChangeCount' in story` も 6.0/5.0 では false)
		//   ⇒ **B1 が「測ってから決める」と残した宿題への答え**＝feature set と違い、この値は動作を変える。
		//   ⚠それでも**据え置く**: 古い DOM を明示するスクリプトから読める必要が今は無く(検証ハーネスは
		//     すべて現行 DOM で走る)、下げるなら**兄弟の KBS(kCS2)と揃える**という別の判断になる。
		//     ★**据え置きの理由は「同じだから」ではなく「要らないから」に変わった**(測った結果)。
		//   ⚠**この resource(10) と、末尾の INX 専用 resource(2) は版数が違ってよい**＝後者は
		//     「IDML に出さない」という指示で、**出しうる全ての版**を覆う必要があるので kCS2 から宣言する。
		//
		// ★引用の裏取り(2026-08-17 実測): Snap.fr:2089 は実在し、記述も正確
		//   (kCS5ScriptVersion, kCoreScriptManagerBoss, kInDesignAllLanguagesFS, k_Wild)。
		//   同じ snapshot が **Snap.fr:1795 では kWildFS**(ツールを含まないリソース)＝
		//   **公式は1つのプラグイン内で内容によって使い分けている**——この観察自体は今も生きており、
		//   むしろ「内容が変わったら選び直す」という上の判断の裏付けになっている。
		//   ⚠**KBS の参照は KBS.fr:1282 ではなく KBS.fr:1326**(:1282 は widget 定義)＝旧記述の行番号は
		//     壊れていた。★**同じ 2026-08-15 の API 監査 A-2 の表は :1326 を正しく引いている**
		//     ＝正しい行番号を手元に持ちながら、こちらを直さなかった。
		// ⚠2026-08-07 に一度 kWildFS へ変えたが**同日中に撤回した**。「kInDesignAllLanguagesFS 単独の
		//   公式実例はゼロ」と判定したのが誤りで、走査結果の件数上限で Snap.fr:2089 を見落としていた
		//   (経緯 = docs/ai-notes/kescm-api-audit-block14-2026-08-07.md の A-1)。
		//   ★**その撤回は今も有効**(実例は在る)。今回変わったのは「その実例が KESCM の手本として当たるか」。
		kCS5ScriptVersion, kCoreScriptManagerBoss, kInDesignAllLanguagesFS, k_Wild,
	}
	//Elements
	{

		Property
		{
			kKESCMStatusPropertyScriptElement,	// this property's script element ID
			p_KESCMStatus,						// ScriptID (KESCMScriptingDefs.h)
			"kcm status",						// name -> app.kcmStatus
			"The last message the Kohaku Change Marker panel put on its status line.",
			StringType,							// type
			{}									// alternate types
			kNoAttributeClass,					// attribute class ID
		}

		// app.kcmBookResult (2026-08-11) - the last book comparison, one line per chapter,
		// "name<TAB>state". Same shape and same purpose as the property above: the status line
		// holds one line, so the per-chapter answers need their own way out to be checkable
		// without looking at the screen.
		Property
		{
			kKESCMBookResultPropertyScriptElement,
			p_KESCMBookResult,
			"kcm book result",					// name -> app.kcmBookResult
			"The last book comparison, one line per chapter: name, tab, state.",
			StringType,
			{}
			kNoAttributeClass,
		}

		// Puts the property ON the application object.
		//
		// Object{}, not Parent{}: Object names an EXISTING scripting object to add members to,
		// while Parent hangs a NEW object underneath one. BPI.fr:603-612 is the form followed here
		// (and KBS.fr:1364-1372, which learned it the hard way - with Parent the property never
		// appeared on app at all).
		Provider
		{
			kKESCMScriptProviderBoss,
			{
				Object{ kApplicationObjectScriptElement },
				Property{ kKESCMStatusPropertyScriptElement, kReadOnly },
				Property{ kKESCMBookResultPropertyScriptElement, kReadOnly },
			}
		}

		/*
		 * The four ITextModel change counters, on the STORY object (2026-08-15, at the user's
		 * request):  app.documents[0].stories[2].kcmChangeCount
		 *
		 * ★The aggregate is the number that DECIDES whether a story shows up in the panel's Story
		 * Edits list (KESCMStoryStamp.cpp compares the two documents' readings and skips the story
		 * when they match). Until now it could not be read from outside, and that cost a whole
		 * investigation on the day this was added: a list came back empty for two documents whose
		 * text plainly differed, and nothing short of reading the source could tell "broken" from
		 * "the two files genuinely read the same". They read the same - both had been built by the
		 * same script with the same number of edits, and a counter is a version number for the
		 * story's state rather than a count of edits.
		 *
		 * Int32Type rather than a string: a test wants to compare these with == and <, not parse.
		 */
		Property
		{
			kKESCMChangeCountPropertyScriptElement,
			p_KESCMChangeCount,
			"kcm change count",					// name -> stories[n].kcmChangeCount
			"The story's all-changes counter - the reading Story Edits compares between two documents.",
			Int32Type,
			{}
			kNoAttributeClass,
		}

		Property
		{
			kKESCMTextChangeCountPropertyScriptElement,
			p_KESCMTextChangeCount,
			"kcm text change count",			// name -> stories[n].kcmTextChangeCount
			"The story's text counter: characters inserted, removed or replaced.",
			Int32Type,
			{}
			kNoAttributeClass,
		}

		Property
		{
			kKESCMAttrChangeCountPropertyScriptElement,
			p_KESCMAttrChangeCount,
			"kcm attr change count",			// name -> stories[n].kcmAttrChangeCount
			"The story's attribute counter: formatting, applied styles and overrides.",
			Int32Type,
			{}
			kNoAttributeClass,
		}

		Property
		{
			kKESCMOtherChangeCountPropertyScriptElement,
			p_KESCMOtherChangeCount,
			"kcm other change count",			// name -> stories[n].kcmOtherChangeCount
			"The story's other counter. Nothing measured so far has ever moved it.",
			Int32Type,
			{}
			kNoAttributeClass,
		}

		// ★★2026-08-20: the document property. ⚠**A Property has to be DECLARED here before a
		//   Provider block can list it** - listing it in the Provider alone leaves it out of the DOM
		//   entirely, with no build error and no warning ('kcmTransparencyItemCount' in doc -> false).
		//   That is how this was first written, and it took comparing against hostadapter/IDHA.fr:527
		//   (the SDK's one example of Object{kDocumentObjectScriptElement}) to see the missing half.
		Property
		{
			kKESCMTransparencyItemCountPropertyScriptElement,
			p_KESCMTransparencyItemCount,
			"kcm transparency item count",		// name -> document.kcmTransparencyItemCount
			"How many page items the document's transparency manager currently lists as having transparency.",
			Int32Type,
			{}
			kNoAttributeClass,
		}

		// Puts those four ON the story object - a SECOND Provider block on the SAME boss as the
		// application properties above. What separates them is the Object field: a Property is
		// added to the object named by the PRECEDING Object (vol1-11:1302), so the four counters
		// below follow Object{kStoryObjectScriptElement} and the two strings above follow
		// Object{kApplicationObjectScriptElement}. Appending them to the block above - after that
		// block's Object{Application} and with no Object of their own - is what would have grown
		// app.kcmChangeCount. One boss serving several blocks is what basicshape does with Adobe's
		// own kPageItemScriptProviderBoss (BscShp.fr:370-404, three blocks, one Contexts entry at
		// :317), and vol1-11:1237 states it plainly: a provider "can be defined (used) in multiple
		// places".
		Provider
		{
			kKESCMScriptProviderBoss,
			{
				Object{ kStoryObjectScriptElement },
				Property{ kKESCMChangeCountPropertyScriptElement, kReadOnly },
				Property{ kKESCMTextChangeCountPropertyScriptElement, kReadOnly },
				Property{ kKESCMAttrChangeCountPropertyScriptElement, kReadOnly },
				Property{ kKESCMOtherChangeCountPropertyScriptElement, kReadOnly },
			}
		},

		// ★★2026-08-20: document に1本。app / story と同じく Object ごとに Provider ブロックを分ける
		//   (上のコメントの理由そのまま＝Object を持たない Property は直前の Object に付いてしまう)。
		//
		// document.kcmTransparencyItemCount ＝ IXPManager の「透明を持つページアイテムの一覧」の件数。
		// ★これは KESCM の内部状態ではなく**本体が文書ごとに持っている一覧**の件数で、
		//   KESCM が書き出しのあいだだけ載せる分も、本物の透明(影・不透明度<100 等)も同じく数える。
		// ★★用途＝**載せたまま保存していないかを外から確かめる**こと。一覧は .indd に永続するので、
		//   保存 → 閉じる → 開き直して読めば「書き込まれたか」がそのまま判る。
		// ⚠この Property は下の2つ目のリソースで IDML から除外している(story の4本と同じ理由)。
		Provider
		{
			kKESCMScriptProviderBoss,
			{
				Object{ kDocumentObjectScriptElement },
				Property{ kKESCMTransparencyItemCountPropertyScriptElement, kReadOnly },
			}
		}
	}
};

/*
 * ★★★KEEPS THE FOUR STORY COUNTERS OUT OF THE USER'S IDML (2026-08-18, bug recheck B11).
 *
 * THE PROBLEM. IDML is a mapping of the scripting DOM - "scripting objects become elements,
 * scripting PROPERTIES become ATTRIBUTES" (idml-01:159) - so the four properties declared above
 * were written into every IDML the user exported. Measured: every <Story> in Stories/*.xml and the
 * <XmlStory> in XML/BackingStory.xml carried them, 36 attributes in a 22-file package for a
 * four-page document, whether or not a comparison had ever run:
 *
 *     <Story Self="ufe" ... KcmChangeCount="6" KcmTextChangeCount="2"
 *                          KcmAttrChangeCount="4" KcmOtherChangeCount="0">
 *
 * ⚠Nothing broke - the importer ignores them (the file said 6/2/4/0 and the opened document read
 * 9/2/7/0, its own numbers), an attribute no plug-in defines is ignored the same way so our files
 * stay readable where KESCM is not installed, and app.generateIDMLSchema() declares all four
 * optional for this configuration. This is about not writing volatile session state into someone's
 * document interchange file, which IDML reserves for "your persistent data" (vol1-11:659).
 *
 * WHY A SECOND RESOURCE IS THE ANSWER. The Property declaration itself has no "leave me out of
 * INX" field - the only per-property control is the access right (kReadOnly / kReadWrite /
 * kReadOnlyButReadWriteForINX). What the architecture gives instead is a CLIENT-SPECIFIC resource:
 * a VersionedScriptElementInfo whose Contexts name a particular script manager (vol1-11:797), here
 * kINXScriptManagerBoss - the base class of all four INX/IDML managers (vol1-11:174-180). Naming
 * kNotSupported in place of a provider boss removes the elements from THAT DOM only.
 * BscShp.fr:425-431 calls this "the preferred approach going forward".
 *
 * ★★MEASURED, because the SDK never does this to a Property. All three uses in the SDK
 * (BscShp.fr:432, CdlChart.fr:567, CusDtLnk.fr:735) list Parent / RepresentObject / Method /
 * CollectionMethod entries. Two builds were made that differed in this resource and nothing else:
 *
 *     with this resource:      stories[0].kcmChangeCount -> 6     IDML: no Kcm attribute at all
 *     without it (control):    stories[0].kcmChangeCount -> 6     IDML: KcmChangeCount="6"
 *
 * ⇒ It works on a Property, and it does NOT take the property away from ordinary scripting.
 *
 * ⚠The two application properties are deliberately NOT listed here: the application object is not
 * part of a document's IDML at all (measured - no KcmStatus anywhere in the package), so there is
 * nothing to remove, and listing them would suggest otherwise.
 * ⚠kCS2ScriptVersion here, not kCS5: this resource has to cover every IDML version the counters
 * could appear in, and the SDK's own INX resources all declare from kCS2 (the three above).
 */
resource VersionedScriptElementInfo(2)
{
	//Contexts
	{
		kCS2ScriptVersion, kINXScriptManagerBoss, kWildFS, k_Wild,
	}
	//Elements
	{
		Provider
		{
			kNotSupported,
			{
				Object{ kStoryObjectScriptElement },
				Property{ kKESCMChangeCountPropertyScriptElement, kReadOnly },
				Property{ kKESCMTextChangeCountPropertyScriptElement, kReadOnly },
				Property{ kKESCMAttrChangeCountPropertyScriptElement, kReadOnly },
				Property{ kKESCMOtherChangeCountPropertyScriptElement, kReadOnly },
			}
		},

		// ★★2026-08-20: document のプロパティも同じ理由で IDML から外す。
		//   ⚠**こちらは story の4本より外す理由が強い** ---- 件数は「いまこの瞬間の本体の状態」で、
		//   書き出しのあいだだけ増える**揮発するセッション状態**そのものだから。文書の交換フォーマットに
		//   書けば、開いた側は「この文書には透明が n 個ある」という**古くて根拠のない数**を受け取る。
		Provider
		{
			kNotSupported,
			{
				Object{ kDocumentObjectScriptElement },
				Property{ kKESCMTransparencyItemCountPropertyScriptElement, kReadOnly },
			}
		}
	}
};

#endif // __ODFRC__

#include "KESCM_enUS.fr"
// KESCM_jaJP.fr は撤去(2026-08-05): 日本語は KESCMLoc.h の実行時切替へ。
