#ifdef __ODFRC__


// Japanese string table is defined here

resource StringTable (kSDKDefStringsResourceID + index_jaJP)
{
        k_jaJP,	// Locale Id
        kResourceUTF8Encoded,	// Character encoding converter (this file is UTF-8, no BOM)

        {
        	// ----- Menu strings
                kKESCMCompanyKey,					"Kohaku Plug-Ins",	// 日本語ロケールも英語表記で統一(会社名 kKESCMCompanyValue とは別)
                kKESCMAboutMenuKey,					kKESCMPluginName "[JP]...",

                // パネルのフライアウトのメニュー名は日本語ロケールでも英語(enUS と同一)で統一する
                // (ユーザー方針 2026-07-04)。日本語が残るのはメニューから開いた表示内容
                // (kKESCMHintKey / kKESCMAboutBoxStringKey 等)のみ。
                // kSDKDefAboutThisPlugInMenuValue_enUS は ASCII のみなので UTF-8 テーブルでもそのまま使える
                // (Shift-JIS 定義の _jaJP 版と違い衝突しない)。
                kSDKDefAboutThisPlugInMenuKey,			kSDKDefAboutThisPlugInMenuValue_enUS,
                kKESCMAboutScriptMenuKey,			"About Scripting...",
                kKESCMUsageMenuKey,				"How to Use...",
                kKESCMHideUnchangedMenuKey,			"Hide Unchanged Spreads",
                kKESCMShowOldNumsMenuKey,			"Show Original Page Numbers",
                kKESCMSyncViewsMenuKey,				"Sync Layout Views",

                // ----- Command strings

                // ----- Window strings

                // ----- Panel/dialog strings
                // パネル UI は英語表記で統一(説明文 kKESCMHintKey のみ日本語のまま)。
                kKESCMPanelTitleKey,			"KohakuChangeMarker",
                kKESCMTargetLabelKey,			"Target:",
                kKESCMSourceLabelKey,			"Source:",
                kKESCMStartButtonKey,			"Start",
                kKESCMPrintCheckKey,			"Print comparison marks",
                kKESCMOpacity25Key,				"Marks opacity 25%",
                kKESCMOpacity75Key,				"Marks opacity 75%",
                kKESCMHintKey,					"中マウスボタン=\n　比較枠(押中/透明度はパネルの25%・75%)\n中マウスボタン+Shift=\n　元(押中)\n中マウスボタン+Alt=\n　他のドキュメントのウィンドウを\n　このウィンドウと同じ表示に\n　(位置と拡大率を一致/Start前でも常に使用可)\n中マウスボタン+Ctrl=\n　スプレッド単位の比較更新\n中マウスボタン+Shift+Alt=\n　元50%(押中)\n中マウスボタン+Shift+Ctrl+Alt=\n　色情報(押中)\n\nShiftCtrlAltは離せます\n\n比較枠の印刷をONにしても、ファイル＞書き出しのPDFには出ません。PDFにしたい場合は、プリントでプリンターの選択でPDFを選んでください。",

              // ----- Error strings

                // ----- Misc strings
                kKESCMAboutBoxStringKey,			kKESCMPluginName "、version " kKESCMVersion "\n\n"
                	"Adobe InDesign C++ SDK プラグイン。\n"
                	"二つのドキュメントをページ単位でオフスクリーンにレンダリングしてピクセル比較し、変化した箇所を画面上に赤い枠で重ねて表示します。表示は非永続なので、ドキュメントには残りません。\n\n"
                	"本プラグインは KohakuNekotarou が、Anthropic の AI Claude（Claude Code）と協働して設計・実装しました。\n\n"
                	"【注意】どのような問題が起こっても責任を取れません。ご利用は自己責任でお願いします。\n\n"
                	"ソース: " kKESCMRepoURL,

                kKESCMScriptHelpStringKey,			"No scripts are currently available.",

                // 「Hide Unchanged Spreads」実行前の確認ダイアログ本文(ドキュメントに変更を加えるため)。
                // ダイアログのみ日本語ロケールで日本語表示(メニュー名は英語統一の方針のまま)。
                kKESCMHideConfirmKey,				"この機能はファイルに変更を加えます。構いませんか?",

        }

};

#endif // __ODFRC__
