#ifdef __ODFRC__


// Japanese string table is defined here

resource StringTable (kSDKDefStringsResourceID + index_jaJP)
{
        k_jaJP,	// Locale Id
        kResourceUTF8Encoded,	// Character encoding converter (this file is UTF-8, no BOM)

        {
        	// ----- Menu strings
                kKESCMCompanyKey,					"Kohaku Plug-Ins",	// 日本語ロケールも英語表記で統一(会社名 kKESCMCompanyValue とは別)
                kKESCMAboutMenuKey,					kKESCMPluginName "[JP]...",

                // パネルのフライアウトのメニュー名は日本語ロケールでも英語(enUS と同一)で統一する
                // (ユーザー方針 2026-07-04)。日本語が残るのはメニューから開いた表示内容
                // (kKESCMHintKey / kKESCMAboutBoxStringKey 等)のみ。
                // kSDKDefAboutThisPlugInMenuValue_enUS は ASCII のみなので UTF-8 テーブルでもそのまま使える
                // (Shift-JIS 定義の _jaJP 版と違い衝突しない)。
                kSDKDefAboutThisPlugInMenuKey,			kSDKDefAboutThisPlugInMenuValue_enUS,
                kKESCMAboutScriptMenuKey,			"About Scripting...",
                kKESCMUsageMenuKey,				"How to Use...",
                kKESCMShowSrcMarksMenuKey,			"Show Marks on Source",
                kKESCMPageMapToggleMenuKey,			"KESCM: Register as Added/Removed Pages",
                kKESCMPageCheckMenuKey,				"KESCM: Check",
                kKESCMHideUnchangedMenuKey,			"Hide Unchanged Spreads",
                kKESCMShowOldNumsMenuKey,			"Show Original Page Numbers",
                kKESCMSyncViewsMenuKey,				"Sync Layout Views",
                kKESCMScrollMapMenuKey,				"Show Scrollbar Map",
                kKESCMPanelShortcutMenuKey,			"Invoke Panel Shortcut",
                kKESCMPagesPanelShortcutMenuKey,	"Invoke Pages Panel Shortcut",
                kKESCMSavePanelStateMenuKey,			"Save Panel Settings",
                kKESCMSaveChecksMenuKey,			"Save Check && Register",
                kKESCMLoadChecksMenuKey,			"Load Check && Register",
                kKESCMIgnorePageNumMenuKey,			"Ignore Page Number Marker",
                kKESCMHoldToHideMarksMenuKey,			"Hold to Hide Marks",

                // ----- Command strings

                // ----- Window strings

                // ----- Panel/dialog strings
                // パネル UI は英語表記で統一(説明文 kKESCMHintKey のみ日本語のまま)。
                kKESCMPanelTitleKey,			"KohakuChangeMarker",
                kKESCMToolStringKey,			"KohakuChangeMarker Tool",	// ツール名も英語統一(メニュー名方針と同じ)
                kKESCMTargetLabelKey,			"Target:",
                kKESCMSourceLabelKey,			"Source:",
                kKESCMStartButtonKey,			"Start",
                kKESCMPrintCheckKey,			"Print comparison marks",
                kKESCMOpacity25Key,				"25%",
                kKESCMOpacity75Key,				"75%",
                kKESCMPrevChangeKey,			"< Prev",
                kKESCMNextChangeKey,			"Next >",
                kKESCMHintKey,					"中マウスボタン=\n　比較枠(押中/透明度はパネルの25%・75%)\n中マウスボタン+Shift=\n　元(押中)\n中マウスボタン+Alt（Option）=\n　他のドキュメントのウィンドウを\n　このウィンドウと同じ表示に\n　(位置と拡大率を一致/Start前でも常に使用可)\n中マウスボタン+Ctrl（Cmd）=\n　スプレッド単位の比較更新\n中マウスボタン+Shift+Alt（Option）=\n　元50%(押中)\n中マウスボタン+Shift+Ctrl（Cmd）+Alt（Option）=\n　色情報(押中)\n中マウスボタン+Shift+Ctrl（Cmd）=\n　このパネルの表示/非表示\n　(フローティング時はカーソル位置に表示/Start前でも常に使用可)\n中マウスボタン+Ctrl（Cmd）+Alt（Option）=\n　ページパネルの表示/非表示\n　(Start前でも常に使用可)\n\nShift・Ctrl（Cmd）・Alt（Option）は離せます\n\n【ページの追加・削除への対応(Add / Remove)】\nページを追加・削除すると、それ以降のページ番号がズレて本来同じページ同士が比較されなくなり、デザインが同じでも「すべて変更あり」と誤検知されることがあります。これを防ぐため、追加・削除したページを比較対象から外して登録できます。\n・使い方: ページパネルでページを選択して右クリックし、「KESCM: Register as Added/Removed Pages」を選びます\n・Target(新しい方)で登録=追加ページ / Source(古い方)で登録=削除ページ\n・もう一度同じ操作で登録を解除\n・登録したページは緑の斜線、ページ数の差で比較相手がいないページは赤の斜線で表示\n・Start済みの状態で登録・解除すると、その場で自動的に比較し直します\n\n【ページのチェック(KESCM: Check)】\n確認が済んだページにチェック印を付けられます。Start中のみ使用でき、Stopで消えます。\n・使い方: ページパネルでページを選択して右クリックし、「KESCM: Check」を選びます(もう一度で解除)\n・チェック印を付けられるのは、比較枠や斜線などのマークが付いているページだけです(マークの無いページには付きません)\n・チェック印と登録(Add / Remove)は保存・読込できます。パネルのフライアウトメニューから:\n　「Save Check & Register」= 現在のチェック印と登録を専用ファイルに保存(保存先のパスを表示)\n　「Load Check & Register」= 保存内容を読み込み、登録を適用して比較し直し、チェック印を復元(Start中のみ)\n・保存はこのプラグイン専用のファイル(環境設定フォルダー)に書くだけで、InDesignの文書やワークスペースには一切書き込みません\n・文書を別の場所へ移動したり別名保存したりして保存場所(パス)が変わると、保存したチェック印は復元できません\n\n比較枠の印刷をONにしても、ファイル＞書き出しのPDFには出ません。PDFにしたい場合は、プリントでプリンターの選択でPDFを選んでください。\n\n【注意】どのような問題が起こっても責任を取れません。ご利用は自己責任でお願いします。",

              // ----- Error strings

                // ----- Misc strings
                kKESCMAboutBoxStringKey,			kKESCMPluginName "、version " kKESCMVersion "\n\n"
                	"Adobe InDesign C++ SDK プラグイン。\n"
                	"二つのドキュメントをページ単位でオフスクリーンにレンダリングしてピクセル比較し、変化した箇所を画面上に赤い枠で重ねて表示します。表示は非永続なので、ドキュメントには残りません。\n\n"
                	"本プラグインは KohakuNekotarou が、Anthropic の AI Claude（Claude Code）と協働して設計・実装しました。\n\n"
                	"ソース: " kKESCMRepoURL,

                kKESCMScriptHelpStringKey,			"No scripts are currently available.",

                // 「Hide Unchanged Spreads」実行前の確認ダイアログ本文(ドキュメントに変更を加えるため)。
                // ダイアログのみ日本語ロケールで日本語表示(メニュー名は英語統一の方針のまま)。
                kKESCMHideConfirmKey,				"この機能はファイルに変更を加えます。構いませんか?",

        }

};

#endif // __ODFRC__
