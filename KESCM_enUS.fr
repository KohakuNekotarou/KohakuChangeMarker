#ifdef __ODFRC__

// English string table is defined here

resource StringTable (kSDKDefStringsResourceID + index_enUS)
{
        k_enUS,									// Locale Id
        kEuropeanWinToMacEncodingConverter,		// Character encoding converter (irp) I made this WinToMac as we have a bias to generate on Win...
        {
        	 // ----- Menu strings
                kKESCMCompanyKey,					"Kohaku Plug-Ins",	// メニュー束ね名(表示)。会社名 kKESCMCompanyValue とは別概念で固定
                kKESCMAboutMenuKey,					kKESCMDisplayName "...",	// "[US]" テンプレートサフィックスは撤去(2026-07-25)

                kSDKDefAboutThisPlugInMenuKey,			kSDKDefAboutThisPlugInMenuValue_enUS,
                kKESCMUsageMenuKey,				"How to Use...",
                kKESCMShowSrcMarksMenuKey,			"Show Marks on Source",
                kKESCMPageMapToggleMenuKey,			"KESCM: Register as Added/Removed Pages",
                kKESCMPageCheckMenuKey,				"KESCM: Check",
                kKESCMPageRefreshCompareMenuKey,	"KESCM: Refresh Page Comparison",
                kKESCMHideUnchangedMenuKey,			"Hide Unchanged Spreads",
                kKESCMShowOldNumsMenuKey,			"Show Original Page Numbers",
                kKESCMSyncViewsMenuKey,				"Sync Layout Views",
                kKESCMAlignViewsMenuKey,			"Align Other Views to Active",
                kKESCMScrollMapMenuKey,				"Show Scrollbar Map",
                kKESCMHudMenuKey,					"Show HUD",
                kKESCMSavePanelStateMenuKey,			"Save Panel Settings",
                kKESCMSaveChecksMenuKey,			"Save Check && Register",
                kKESCMLoadChecksMenuKey,			"Load Check && Register",
                kKESCMFindOversetMenuKey,			"Find Overset",
                kKESCMRefreshOversetMenuKey,		"Refresh Overset",
                kKESCMExportChangedPagesMenuKey,	"Export Changed Pages...",
                kKESCMIgnorePageNumMenuKey,			"Ignore Page Number Marker",
                kKESCMHoldToHideMarksMenuKey,			"Hold to Hide Marks",

                // Keyboard Shortcuts editor area for shortcut-assignable actions: the value string that
                // "KBSCE Palette Menus: Kohaku Change Marker: " (kKESCMPanelMenuActionArea) resolves to. This
                // files those actions under Product Area "Palette Menus", prefixed "Kohaku Change Marker".
                kKESCMPanelMenuActionArea,			kKESCMPanelMenuActionAreaValue,

                // ----- Command strings

                // ----- Window strings

                // ----- Panel/dialog strings
                kKESCMPanelTitleKey,			"Kohaku Change Marker",
                kKESCMToolStringKey,			"Kohaku Change Marker Tool",	// ツールボックスのツール名(ツールチップ)
                kKESCMTargetLabelKey,			"Target:",
                kKESCMSourceLabelKey,			"Source:",
                kKESCMStartButtonKey,			"Start",
                kKESCMPrintCheckKey,			"Print comparison marks",
                kKESCMOpacity25Key,				"25%",
                kKESCMOpacity75Key,				"75%",
                kKESCMPrevChangeKey,			"< Prev",
                kKESCMNextChangeKey,			"Next >",
                kKESCMHintKey,					"Select the Kohaku Change Marker tool (toolbox), then on the layout:\nHold Left button =\n  show comparison marks (while held;\n  opacity 25%/75% from panel)\nHold Left + Shift =\n  original (old version, while held)\nHold Left + Shift+" kKESCMAltKeyName "=\n  original 50% (while held)\nHold Left + " kKESCMAltKeyName "=\n  color info (CMYK) at the click point,\n  shown on the cursor and panel\n\nShift/" kKESCMAltKeyName " can be held or released\n\n[Handling added / removed pages (Add / Remove)]\nWhen pages are added or removed, the following page numbers shift, so pages that should match are no longer compared and everything can be falsely flagged as changed even when the design is identical. To avoid this, you can register added or removed pages to exclude them from comparison.\n- How to: in the Pages panel, select pages, right-click, and choose \"KESCM: Register as Added/Removed Pages\"\n- Register in Target (the newer document) = added page / register in Source (the older document) = removed page\n- Repeat the same action to unregister\n- Registered pages show a green diagonal line; pages with no counterpart due to the page-count difference show a red diagonal line\n- If you register or unregister while Start is active, the comparison is redone automatically\n\n[Checking pages (KESCM: Check)]\nYou can put a check mark on pages you have finished reviewing. Available only while Start is active; cleared on Stop.\n- How to: in the Pages panel, select pages, right-click, and choose \"KESCM: Check\" (repeat to clear)\n- A check can be placed only on pages that already carry a mark (comparison frame or diagonal line); unmarked pages cannot be checked\n- Checks and registrations (Add / Remove) can be saved and restored from the panel flyout menu:\n  - \"Save Check & Register\" = save the current checks and registrations to a private file (shows the saved path)\n  - \"Load Check & Register\" = load them, apply the registrations, recompare, then restore the checks (only while Start is active)\n- Saving only writes to this plug-in's own file in the preferences folder; nothing is written into InDesign's documents or workspace\n- Matching is by the document's full path, so if the file is moved or saved under a new name, saved checks can no longer be restored\n\n[Refresh page comparison (KESCM: Refresh Page Comparison)]\nRecompare just the pages you edited. Available only while Start is active.\n- How to: in the Pages panel, select pages, right-click, and choose \"KESCM: Refresh Page Comparison\"\n- Updates the comparison marks and thumbnails of the selected pages (works in Target or Source)\n\n[Finding overset (Find Overset)]\nSeparately from the comparison, you can find pages that contain overset (overflowing) text on their own.\n- Turn \"Find Overset\" ON/OFF from the flyout menu\n- Overset pages are shown with a red frame + red \"+\" on their Pages-panel thumbnails and a red band on the scrollbar map\n- Detects overflowing text frames as well as individual overset table cells (the red dot)\n- Use Prev/Next to step through the overset locations (while comparing, each page goes changed then overset)\n- After editing, use \"Refresh Overset\" to re-scan (only while Find Overset is ON)\n\nEven with comparison-mark printing ON, File > Export to PDF won't include them. To make a PDF, use Print and choose a PDF printer.\n\nDISCLAIMER: Provided as-is. We cannot take responsibility for any problems that may arise. Use at your own risk.",

		// ----- Misc strings
                kKESCMAboutBoxStringKey,			kKESCMDisplayName ", version " kKESCMVersion "\n\n"
                	"Adobe InDesign C++ SDK Plug-In.\n"
                	"Renders two documents page by page off-screen, compares them pixel by pixel, and overlays red frames on screen where changes are found. The overlay is non-persistent and is never saved into the document.\n\n"
                	"Designed and implemented by KohakuNekotarou in collaboration with Anthropic's AI Claude (Claude Code).\n\n"
                	"Source: " kKESCMRepoURL,

                // Confirmation shown before "Hide Unchanged Spreads" hides spreads (it modifies the document).
                kKESCMHideConfirmKey,				"This feature modifies the document file. Continue?",


        }

};

#endif // __ODFRC__
