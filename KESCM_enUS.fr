#ifdef __ODFRC__

// English string table is defined here

resource StringTable (kSDKDefStringsResourceID + index_enUS)
{
        k_enUS,									// Locale Id
        kEuropeanWinToMacEncodingConverter,		// Character encoding converter (irp) I made this WinToMac as we have a bias to generate on Win...
        {
        	 // ----- Menu strings
                kKESCMCompanyKey,					"Kohaku Plug-Ins",	// メニュー束ね名(表示)。会社名 kKESCMCompanyValue とは別概念で固定
                kKESCMAboutMenuKey,					kKESCMPluginName "[US]...",

                kSDKDefAboutThisPlugInMenuKey,			kSDKDefAboutThisPlugInMenuValue_enUS,
                kKESCMAboutScriptMenuKey,			"About Scripting...",
                kKESCMUsageMenuKey,				"How to Use...",
                kKESCMShowSrcMarksMenuKey,			"Show Marks on Source",
                kKESCMPageMapToggleMenuKey,			"KESCM: Register as Added/Removed Pages",
                kKESCMHideUnchangedMenuKey,			"Hide Unchanged Spreads",
                kKESCMShowOldNumsMenuKey,			"Show Original Page Numbers",
                kKESCMSyncViewsMenuKey,				"Sync Layout Views",
                kKESCMScrollMapMenuKey,				"Show Scrollbar Map",
                kKESCMPanelShortcutMenuKey,			"Invoke Panel Shortcut",
                kKESCMIgnorePageNumMenuKey,			"Ignore Page Number Marker",
                kKESCMHoldToHideMarksMenuKey,			"Hold to Hide Marks",

                // ----- Command strings

                // ----- Window strings

                // ----- Panel/dialog strings
                kKESCMPanelTitleKey,			"KohakuChangeMarker",
                kKESCMTargetLabelKey,			"Target:",
                kKESCMSourceLabelKey,			"Source:",
                kKESCMStartButtonKey,			"Start",
                kKESCMPrintCheckKey,			"Print comparison marks",
                kKESCMOpacity25Key,				"25%",
                kKESCMOpacity75Key,				"75%",
                kKESCMPrevChangeKey,			"< Prev",
                kKESCMNextChangeKey,			"Next >",
                kKESCMHintKey,					"Middle button =\n  marks (while held;\n  opacity 25%/75% from panel)\nMiddle + Shift =\n  original (while held)\nMiddle + Alt =\n  match other documents' windows\n  to this view (same position and zoom;\n  always available, even before Start)\nMiddle + Ctrl =\n  refresh spread compare\nMiddle + Shift+Alt =\n  original 50% (while held)\nMiddle + Shift+Ctrl+Alt =\n  color info (while held)\nMiddle + Shift+Ctrl =\n  show / hide this panel\n  (pops at the cursor when floating;\n  always available, even before Start)\n\nShift/Ctrl/Alt can be released\n\n[Handling added / removed pages (Add / Remove)]\nWhen pages are added or removed, the following page numbers shift, so pages that should match are no longer compared and everything can be falsely flagged as changed even when the design is identical. To avoid this, you can register added or removed pages to exclude them from comparison.\n- How to: in the Pages panel, select pages, right-click, and choose \"KESCM: Register as Added/Removed Pages\"\n- Register in Target (the newer document) = added page / register in Source (the older document) = removed page\n- Repeat the same action to unregister\n- Registered pages show a green diagonal line; pages with no counterpart due to the page-count difference show a red diagonal line\n- If you register or unregister while Start is active, the comparison is redone automatically\n\nEven with comparison-mark printing ON, File > Export to PDF won't include them. To make a PDF, use Print and choose a PDF printer.\n\nDISCLAIMER: Provided as-is. We cannot take responsibility for any problems that may arise. Use at your own risk.",

		// ----- Misc strings
                kKESCMAboutBoxStringKey,			kKESCMPluginName ", version " kKESCMVersion "\n\n"
                	"Adobe InDesign C++ SDK Plug-In.\n"
                	"Renders two documents page by page off-screen, compares them pixel by pixel, and overlays red frames on screen where changes are found. The overlay is non-persistent and is never saved into the document.\n\n"
                	"Designed and implemented by KohakuNekotarou in collaboration with Anthropic's AI Claude (Claude Code).\n\n"
                	"Source: " kKESCMRepoURL,

                kKESCMScriptHelpStringKey,			"No scripts are currently available.",

                // Confirmation shown before "Hide Unchanged Spreads" hides spreads (it modifies the document).
                kKESCMHideConfirmKey,				"This feature modifies the document file. Continue?",


        }

};

#endif // __ODFRC__
